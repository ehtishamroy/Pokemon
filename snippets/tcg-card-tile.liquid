{% comment %}
  TCG Hitz — card tile snippet
  Shopify: snippets/tcg-card-tile.liquid
  Usage: {% render 'tcg-card-tile', product: product %}

  Reads card.* metafields for set + number + rarity display.
  Falls back to card-back.svg when no product image exists.
{% endcomment %}

{% liquid
  assign card_set    = product.metafields.card.set.value | default: product.metafields.custom.set.value | default: product.metafields.card.set | default: product.metafields.custom.set
  assign card_number = product.metafields.card.number.value | default: product.metafields.custom.number.value | default: product.metafields.card.number | default: product.metafields.custom.number
  assign card_rarity = product.metafields.card.rarity.value | default: product.metafields.custom.rarity.value | default: product.metafields.card.rarity | default: product.metafields.custom.rarity
  assign card_condition = product.metafields.card.condition.value | default: product.metafields.custom.condition.value | default: product.metafields.card.condition | default: product.metafields.custom.condition

  assign rarity_class = 'rar-common'
  assign rarity_lower = card_rarity | downcase
  if rarity_lower contains 'secret' or rarity_lower contains 'illustration'
    assign rarity_class = 'rar-secret'
  elsif rarity_lower contains 'ultra' or rarity_lower contains 'double' or rarity_lower contains 'special'
    assign rarity_class = 'rar-ultra'
  elsif rarity_lower contains 'rare' or rarity_lower contains 'holo'
    assign rarity_class = 'rar-rare'
  endif

  assign tile_img = product.featured_image
%}

<article class="tcg-scope tile rounded-card p-3" style="background:#141C3A;">
  <a href="{{ product.url }}" class="block tile__img rounded-lg overflow-hidden relative">
    {% if tile_img %}
      <img src="{{ tile_img | image_url: width: 600 }}"
           alt="{{ product.title | escape }}"
           width="600"
           loading="lazy">
    {% else %}
      <img src="{{ 'card-back.svg' | asset_url }}"
           alt="{{ product.title | escape }}"
           width="600"
           loading="lazy">
    {% endif %}
    {% unless product.available %}
      <span class="absolute top-2 left-2 rounded-full px-2 py-0.5 text-[11px] font-semibold"
            style="background:rgba(14,21,48,.85);color:#E8402C;">Sold out</span>
    {% endunless %}
    {% if product.available and product.inventory_quantity == 1 %}
      <span class="absolute top-2 left-2 rounded-full px-2 py-0.5 text-[11px] font-semibold"
            style="background:rgba(14,21,48,.85);color:#3DD68C;">Only 1 left</span>
    {% endif %}
  </a>
  <div class="mt-3">
    {% if card_set != blank or card_number != blank %}
      <p class="text-xs" style="color:#8A96B8;">
        {{ card_set }}{% if card_set != blank and card_number != blank %} · {% endif %}{{ card_number }}
      </p>
    {% endif %}
    <h3 class="font-semibold leading-tight mt-0.5">
      <a href="{{ product.url }}" style="color:#F3F5FA;">{{ product.title }}</a>
    </h3>
    {% if card_rarity != blank or card_condition != blank %}
      <p class="mt-1 text-xs font-semibold {{ rarity_class }}">
        {%- if card_rarity != blank -%}{{ card_rarity }}{%- endif -%}
        {%- if card_rarity != blank and card_condition != blank -%} · {%- endif -%}
        {%- if card_condition != blank -%}{{ card_condition }}{%- endif -%}
      </p>
    {% endif %}
    <div class="mt-3 flex items-center justify-between">
      <p class="font-bold text-lg" style="color:#FFC72C;">
        {{ product.price | money }}
      </p>
      <a href="{{ product.url }}"
         class="rounded-full border px-3 py-1.5 text-sm font-semibold"
         style="border-color:rgba(255,255,255,.15);color:#F3F5FA;"
         onmouseover="this.style.borderColor='#FFC72C';this.style.color='#FFC72C';"
         onmouseout="this.style.borderColor='rgba(255,255,255,.15)';this.style.color='#F3F5FA';">
        View
      </a>
    </div>
  </div>
</article>
