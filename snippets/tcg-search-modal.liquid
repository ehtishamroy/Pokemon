{% comment %}
  TCG Hitz — Animated Predictive Search Dialog
  Matches reference design 1:1:
  - Blurred ambient dark backdrop
  - Luxury rounded dialog card with gold border and pop-in animation
  - Pill-shaped search bar with gold border and clear button
  - Popular search tags (New Arrivals, Booster Boxes, Slabs, Pokemon, One Piece)
  - Recently viewed cards (with PSA Jolteon, 151 Booster Pack, and live store history)
  - Live predictive search via Shopify /search/suggest.json API
{% endcomment %}

{%- liquid
  # Dynamically gather popular search keywords strictly from the store's real data
  assign popular_terms_str = ''

  # 1. Product Vendors (e.g. 'Pokemon')
  for v in shop.vendors
    if v != blank
      assign v_title = v | capitalize | strip
      assign popular_terms_str = popular_terms_str | append: v_title | append: '||'
    endif
  endfor

  # 2. Real Collections
  for col in collections
    unless col.handle == 'all'
      assign col_title = col.title | strip
      assign popular_terms_str = popular_terms_str | append: col_title | append: '||'
    endunless
  endfor

  # 3. Product Types
  for t in shop.types
    if t != blank
      assign t_title = t | capitalize | strip
      assign popular_terms_str = popular_terms_str | append: t_title | append: '||'
    endif
  endfor

  # 4. Products in store (clean titles, key terms, tags)
  for prod in collections.all.products limit: 4
    assign p_title = prod.title | strip
    assign p_clean = p_title | replace: "’s", "" | replace: "'s", ""
    assign words = p_clean | split: ' '
    if words.size > 2
      assign short_term = words[0] | append: ' ' | append: words[1]
      assign popular_terms_str = popular_terms_str | append: short_term | append: '||'
    else
      assign popular_terms_str = popular_terms_str | append: p_clean | append: '||'
    endif
    for tag in prod.tags
      if tag != blank
        assign tag_clean = tag | strip
        assign popular_terms_str = popular_terms_str | append: tag_clean | append: '||'
      endif
    endfor
  endfor

  assign all_keywords = popular_terms_str | split: '||' | uniq
  assign store_products = collections.all.products
-%}

<div id="tcg-search-modal" class="tcg-search-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="tcg-search-modal__backdrop" data-search-close></div>

  <div class="tcg-search-modal__container">
    <div class="tcg-search-dialog">
      <!-- Search Input Header -->
      <form action="{{ routes.search_url }}" method="get" class="tcg-search-form" id="tcg-search-form" role="search">
        <input type="hidden" name="type" value="product">
        <div class="tcg-search-pill-wrap">
          <input
            type="search"
            id="tcg-modal-search-input"
            name="q"
            class="tcg-search-pill-input"
            placeholder="Search cards, sets, products…"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <button type="button" id="tcg-search-clear-btn" class="tcg-search-pill-clear" aria-label="Clear search">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
          <div class="tcg-search-pill-spinner" id="tcg-search-spinner" style="display: none;">
            <div class="tcg-spinner-glow"></div>
          </div>
        </div>
      </form>

      <!-- Modal Body Content -->
      <div class="tcg-search-modal-body">
        <!-- DEFAULT VIEW: POPULAR SEARCHES + RECENTLY VIEWED -->
        <div id="tcg-search-default-view" class="tcg-search-fade-view">
          <!-- Popular Searches Section (Strictly from real store data) -->
          {%- if all_keywords.size > 0 -%}
            <div class="tcg-search-section">
              <h3 class="tcg-search-section-title">POPULAR SEARCHES</h3>
              <div class="tcg-popular-chips">
                {%- assign chip_count = 0 -%}
                {%- for kw in all_keywords -%}
                  {%- assign kw_trimmed = kw | strip -%}
                  {%- if kw_trimmed != blank and chip_count < 6 -%}
                    <button type="button" class="tcg-search-chip" data-search-query="{{ kw_trimmed | escape }}">{{ kw_trimmed }}</button>
                    {%- assign chip_count = chip_count | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <!-- Recently Viewed Section (Strictly real store products, zero duplicates, zero fake items) -->
          <div class="tcg-search-section mt-8" id="tcg-recent-section" {% if store_products.size == 0 %}style="display: none;"{% endif %}>
            <h3 class="tcg-search-section-title" id="tcg-recent-title">RECENTLY VIEWED</h3>
            <div class="tcg-recent-cards-row" id="tcg-recent-cards-container">
              {%- for prod in store_products limit: 4 -%}
                <a href="{{ prod.url }}" class="tcg-search-card" data-product-url="{{ prod.url | split: '?' | first }}">
                  <div class="tcg-search-card__img-box">
                    {%- if prod.featured_image -%}
                      <img src="{{ prod.featured_image | image_url: width: 300 }}" alt="{{ prod.title | escape }}" loading="lazy">
                    {%- else -%}
                      <img src="{{ 'card-back.svg' | asset_url }}" alt="{{ prod.title | escape }}" loading="lazy">
                    {%- endif -%}
                  </div>
                  <div class="tcg-search-card__title">{{ prod.title }}</div>
                  <div class="tcg-search-card__price">{{ prod.price | money }}</div>
                </a>
              {%- endfor -%}
            </div>
          </div>
        </div>

        <!-- DYNAMIC PREDICTIVE SEARCH RESULTS VIEW -->
        <div id="tcg-search-results-view" class="tcg-search-fade-view" style="display: none;">
          <div class="tcg-search-section">
            <div class="flex items-center justify-center gap-2">
              <h3 class="tcg-search-section-title" id="tcg-results-heading">SEARCH RESULTS</h3>
              <span id="tcg-results-count" class="tcg-search-count-pill" style="display: none;">0</span>
            </div>

            <!-- Dynamic Cards Grid -->
            <div class="tcg-search-results-grid" id="tcg-results-grid"></div>

            <!-- Empty State -->
            <div class="tcg-search-empty" id="tcg-results-empty" style="display: none;">
              <div class="tcg-search-empty__icon">🔍</div>
              <p class="tcg-search-empty__title">No cards found</p>
              <p class="tcg-search-empty__sub">
                Try searching for
                {%- if shop.vendors.first != blank -%}
                  <span class="text-gold cursor-pointer underline" data-search-quick="{{ shop.vendors.first | capitalize | escape }}">{{ shop.vendors.first | capitalize }}</span>,
                {%- endif -%}
                {%- if collections.first != blank -%}
                  <span class="text-gold cursor-pointer underline" data-search-quick="{{ collections.first.title | escape }}">{{ collections.first.title }}</span>,
                {%- endif -%}
                {%- if store_products.first != blank -%}
                  <span class="text-gold cursor-pointer underline" data-search-quick="{{ store_products.first.title | split: ' ' | first | escape }}">{{ store_products.first.title | split: ' ' | first }}</span>
                {%- else -%}
                  <span class="text-gold cursor-pointer underline" data-search-quick="Pokemon">Pokemon</span>
                {%- endif -%}
              </p>
            </div>

            <!-- View All Results Button -->
            <div class="tcg-search-view-all" id="tcg-results-view-all" style="display: none;">
              <a href="{{ routes.search_url }}" id="tcg-view-all-link" class="tcg-search-view-all-btn">
                <span>View all matching items</span>
                <svg class="w-4 h-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================
     TCG HITZ — PREDICTIVE SEARCH MODAL STYLES
     ========================================================== */
  .tcg-search-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tcg-search-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Blurred dark backdrop */
  .tcg-search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* Centered Dialog Container */
  .tcg-search-modal__container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 720px;
    margin: 0 16px;
    perspective: 1000px;
  }

  /* Modal Dialog Card */
  .tcg-search-dialog {
    background: #0d0d10;
    border: 1.5px solid rgba(255, 199, 44, 0.45);
    border-radius: 28px;
    padding: 36px 36px 40px;
    box-shadow:
      0 24px 70px -10px rgba(0, 0, 0, 0.9),
      0 0 45px rgba(255, 199, 44, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transform: scale(0.92) translateY(14px);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.32s ease;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .tcg-search-modal.is-open .tcg-search-dialog {
    transform: scale(1) translateY(0);
  }

  @media (max-width: 640px) {
    .tcg-search-dialog {
      padding: 24px 20px 28px;
      border-radius: 22px;
      margin: 0 8px;
    }
  }

  /* Search Pill Input */
  .tcg-search-pill-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .tcg-search-pill-input {
    width: 100%;
    height: 60px;
    border-radius: 9999px;
    background: #131318;
    border: 1.5px solid #FFC72C;
    color: #FFFFFF;
    font-family: 'Manrope', system-ui, -apple-system, sans-serif;
    font-size: 22px;
    font-weight: 700;
    padding: 0 54px 0 28px;
    outline: none;
    box-shadow: 0 0 18px rgba(255, 199, 44, 0.18);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    -webkit-appearance: none;
  }

  .tcg-search-pill-input:focus {
    border-color: #FFC72C;
    background: #17171d;
    box-shadow:
      0 0 28px rgba(255, 199, 44, 0.32),
      0 0 0 2px rgba(255, 199, 44, 0.25);
  }

  .tcg-search-pill-input::placeholder {
    color: rgba(255, 255, 255, 0.32);
    font-weight: 600;
    font-size: 20px;
  }

  @media (max-width: 640px) {
    .tcg-search-pill-input {
      height: 52px;
      font-size: 18px;
      padding: 0 46px 0 20px;
    }
    .tcg-search-pill-input::placeholder {
      font-size: 16px;
    }
  }

  /* Clear Button inside Input */
  .tcg-search-pill-clear {
    position: absolute;
    right: 18px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .tcg-search-pill-clear:hover {
    color: #FFC72C;
    background: rgba(255, 199, 44, 0.15);
    transform: scale(1.1);
  }

  /* Spinner while searching */
  .tcg-search-pill-spinner {
    position: absolute;
    right: 20px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tcg-spinner-glow {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 199, 44, 0.2);
    border-top-color: #FFC72C;
    border-radius: 50%;
    animation: tcgSpin 0.6s linear infinite;
  }

  @keyframes tcgSpin {
    to { transform: rotate(360deg); }
  }

  /* Section Titles */
  .tcg-search-modal-body {
    overflow-y: auto;
    max-height: calc(85vh - 110px);
    margin-top: 24px;
    padding: 4px 4px 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 199, 44, 0.3) transparent;
  }

  .tcg-search-modal-body::-webkit-scrollbar {
    width: 5px;
  }
  .tcg-search-modal-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .tcg-search-modal-body::-webkit-scrollbar-thumb {
    background: rgba(255, 199, 44, 0.3);
    border-radius: 10px;
  }

  .tcg-search-section-title {
    color: #FFC72C;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 16px 0;
    text-shadow: 0 0 10px rgba(255, 199, 44, 0.3);
  }

  /* Popular search chips */
  .tcg-popular-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .tcg-search-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    border-radius: 9999px;
    padding: 8px 18px;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    user-select: none;
  }

  .tcg-search-chip:hover {
    border-color: #FFC72C;
    color: #FFC72C;
    background: rgba(255, 199, 44, 0.08);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(255, 199, 44, 0.2);
  }

  .tcg-search-chip:active {
    transform: scale(0.96);
  }

  /* Recently Viewed Cards Row */
  .tcg-recent-cards-row,
  .tcg-search-results-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
  }

  .tcg-search-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 154px;
    text-decoration: none;
    color: #FFFFFF;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .tcg-search-card:hover {
    transform: translateY(-4px);
  }

  /* Image Box with thin border and subtle rounded styling */
  .tcg-search-card__img-box {
    width: 144px;
    height: 144px;
    border-radius: 16px;
    background: #141419;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .tcg-search-card:hover .tcg-search-card__img-box {
    border-color: #FFC72C;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7), 0 0 16px rgba(255, 199, 44, 0.25);
  }

  .tcg-search-card__img-box img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 10px;
    transition: transform 0.3s ease;
  }

  .tcg-search-card:hover .tcg-search-card__img-box img {
    transform: scale(1.06);
  }

  .tcg-search-card__title {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.28;
    text-align: center;
    margin-top: 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
    transition: color 0.2s ease;
  }

  .tcg-search-card:hover .tcg-search-card__title {
    color: #FFC72C;
  }

  .tcg-search-card__price {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 800;
    color: #FFC72C;
    text-align: center;
    margin-top: 4px;
    letter-spacing: -0.01em;
  }

  /* Search results animated entrance */
  .tcg-search-card.animate-result {
    animation: tcgCardReveal 0.3s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes tcgCardReveal {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Result Count Pill */
  .tcg-search-count-pill {
    background: rgba(255, 199, 44, 0.15);
    border: 1px solid rgba(255, 199, 44, 0.4);
    color: #FFC72C;
    font-size: 11px;
    font-weight: 800;
    border-radius: 9999px;
    padding: 2px 8px;
  }

  /* Empty State */
  .tcg-search-empty {
    text-align: center;
    padding: 32px 16px;
  }

  .tcg-search-empty__icon {
    font-size: 36px;
    margin-bottom: 10px;
  }

  .tcg-search-empty__title {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 6px;
  }

  .tcg-search-empty__sub {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
  }

  /* View All Button */
  .tcg-search-view-all {
    margin-top: 28px;
    text-align: center;
  }

  .tcg-search-view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 26px;
    border-radius: 9999px;
    background: rgba(255, 199, 44, 0.12);
    border: 1.5px solid #FFC72C;
    color: #FFC72C;
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.22s ease;
  }

  .tcg-search-view-all-btn:hover {
    background: #FFC72C;
    color: #000000;
    transform: translateY(-2px);
    box-shadow: 0 4px 18px rgba(255, 199, 44, 0.35);
  }
</style>

<script>
  (function initTcgSearchModal() {
    const modal = document.getElementById('tcg-search-modal');
    const input = document.getElementById('tcg-modal-search-input');
    const clearBtn = document.getElementById('tcg-search-clear-btn');
    const spinner = document.getElementById('tcg-search-spinner');
    const defaultView = document.getElementById('tcg-search-default-view');
    const resultsView = document.getElementById('tcg-search-results-view');
    const resultsGrid = document.getElementById('tcg-results-grid');
    const resultsEmpty = document.getElementById('tcg-results-empty');
    const resultsCount = document.getElementById('tcg-results-count');
    const resultsViewAll = document.getElementById('tcg-results-view-all');
    const viewAllLink = document.getElementById('tcg-view-all-link');
    const form = document.getElementById('tcg-search-form');
    const recentCardsContainer = document.getElementById('tcg-recent-cards-container');

    if (!modal || !input) return;

    let debounceTimer = null;
    let currentQuery = '';

    /* --- Open / Close Handlers --- */
    function openModal(initialValue) {
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      if (typeof initialValue === 'string' && initialValue.trim().length > 0) {
        input.value = initialValue;
        fetchPredictions(initialValue.trim());
      } else {
        if (!input.value.trim()) {
          showDefaultView();
        }
      }

      setTimeout(() => {
        input.focus();
        if (input.value) {
          input.setSelectionRange(input.value.length, input.value.length);
        }
      }, 50);
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Expose globally so hero search bar and header can call it
    window.openTcgSearchModal = openModal;
    window.closeTcgSearchModal = closeModal;

    // Close on backdrop click
    modal.querySelectorAll('[data-search-close]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
      // Quick search shortcut: press '/' or 'Ctrl+K' / 'Cmd+K' to open
      if ((e.key === '/' || (e.key === 'k' && (e.ctrlKey || e.metaKey))) && !['INPUT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
        e.preventDefault();
        openModal();
      }
    });

    /* --- View Switchers --- */
    function showDefaultView() {
      defaultView.style.display = 'block';
      resultsView.style.display = 'none';
      clearBtn.style.opacity = input.value.trim() ? '1' : '0.45';
      if (spinner) spinner.style.display = 'none';
    }

    function showResultsView() {
      defaultView.style.display = 'none';
      resultsView.style.display = 'block';
      clearBtn.style.opacity = '1';
    }

    /* --- Clear button --- */
    clearBtn.addEventListener('click', () => {
      input.value = '';
      currentQuery = '';
      showDefaultView();
      input.focus();
    });

    /* --- Popular Chip Clicks --- */
    document.querySelectorAll('[data-search-query]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.dataset.searchQuery;
        input.value = q;
        input.focus();
        fetchPredictions(q);
      });
    });

    // Quick links in empty state
    document.addEventListener('click', (e) => {
      const quick = e.target.closest('[data-search-quick]');
      if (quick) {
        const q = quick.dataset.searchQuick;
        input.value = q;
        input.focus();
        fetchPredictions(q);
      }
    });

    /* --- Form submission --- */
    form.addEventListener('submit', (e) => {
      const q = input.value.trim();
      if (!q) {
        e.preventDefault();
      }
    });

    /* --- Live Predictive Search Query --- */
    input.addEventListener('input', (e) => {
      const val = e.target.value.trim();
      if (!val) {
        currentQuery = '';
        showDefaultView();
        return;
      }
      clearBtn.style.display = 'flex';
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        fetchPredictions(val);
      }, 160);
    });

    async function fetchPredictions(query) {
      currentQuery = query;
      showResultsView();
      if (spinner) spinner.style.display = 'flex';
      if (clearBtn) clearBtn.style.display = 'none';

      // Update View All link URL
      const searchUrl = new URL('{{ routes.search_url }}', window.location.origin);
      searchUrl.searchParams.set('q', query);
      searchUrl.searchParams.set('type', 'product');
      if (viewAllLink) viewAllLink.href = searchUrl.toString();

      try {
        const apiUrl = `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=8&resources[options][fields]=title,product_type,variants.title,vendor`;
        const res = await fetch(apiUrl);
        if (!res.ok) throw new Error('Search request failed');
        const data = await res.json();
        
        // Ensure this response matches the latest typed query
        if (query !== currentQuery) return;

        const products = (data.resources && data.resources.results && data.resources.results.products) || [];
        renderResults(products, query);
      } catch (err) {
        console.error('TCG Predictive search error:', err);
        renderResults([], query);
      } finally {
        if (spinner) spinner.style.display = 'none';
        if (clearBtn && input.value) clearBtn.style.display = 'flex';
      }
    }

    /* --- Render Search Results --- */
    function renderResults(products, query) {
      resultsGrid.innerHTML = '';

      if (!products || products.length === 0) {
        resultsEmpty.style.display = 'block';
        resultsViewAll.style.display = 'none';
        resultsCount.style.display = 'none';
        return;
      }

      resultsEmpty.style.display = 'none';
      resultsViewAll.style.display = 'block';
      resultsCount.style.display = 'inline-block';
      resultsCount.textContent = products.length;

      products.forEach((prod, index) => {
        const card = document.createElement('a');
        card.href = prod.url;
        card.className = 'tcg-search-card animate-result';
        card.style.animationDelay = (index * 40) + 'ms';

        // Image
        const imgBox = document.createElement('div');
        imgBox.className = 'tcg-search-card__img-box';
        const img = document.createElement('img');
        img.src = prod.featured_image?.url || prod.image || '{{ "card-back.svg" | asset_url }}';
        img.alt = prod.title || 'Pokemon card';
        img.loading = 'lazy';
        imgBox.appendChild(img);

        // Title
        const title = document.createElement('div');
        title.className = 'tcg-search-card__title';
        title.textContent = prod.title;

        // Price
        const price = document.createElement('div');
        price.className = 'tcg-search-card__price';
        if (prod.price) {
          const numPrice = parseFloat(prod.price);
          price.textContent = isNaN(numPrice) ? prod.price : '$' + numPrice.toFixed(2);
        } else {
          price.textContent = '$10.00';
        }

        card.appendChild(imgBox);
        card.appendChild(title);
        card.appendChild(price);

        // Record real view on click
        card.addEventListener('click', () => {
          recordProductView({
            title: prod.title,
            url: prod.url,
            image: prod.featured_image?.url || prod.image || '',
            price: price.textContent
          });
        });

        resultsGrid.appendChild(card);
      });
    }

    /* --- Strict Recently Viewed Tracking & Deduplication --- */
    function cleanProductUrl(rawUrl) {
      if (!rawUrl) return '';
      try {
        const u = new URL(rawUrl, window.location.origin);
        return u.pathname;
      } catch (e) {
        return rawUrl.split('?')[0].split('#')[0];
      }
    }

    function getCleanRecentItems() {
      try {
        const raw = JSON.parse(localStorage.getItem('tcg_search_recent') || '[]');
        const seen = new Set();
        const clean = [];
        for (const item of raw) {
          if (!item || !item.url) continue;
          const url = cleanProductUrl(item.url);
          if (!url.startsWith('/products/')) continue;
          // Purge any fake seed items from earlier test runs
          const t = (item.title || '').toLowerCase();
          if (t.includes('jolteon') || t.includes('151 booster')) continue;
          if (seen.has(url)) continue;
          seen.add(url);
          clean.push({
            title: item.title,
            url: url,
            image: item.image || '',
            price: item.price || ''
          });
        }
        localStorage.setItem('tcg_search_recent', JSON.stringify(clean));
        return clean;
      } catch (e) {
        return [];
      }
    }

    function recordProductView(item) {
      if (!item || !item.url) return;
      const url = cleanProductUrl(item.url);
      if (!url.startsWith('/products/')) return;

      let list = getCleanRecentItems();
      // Remove any existing duplicate of this product URL
      list = list.filter(x => x.url !== url);
      list.unshift({
        title: item.title,
        url: url,
        image: item.image || '',
        price: item.price || ''
      });
      if (list.length > 6) list = list.slice(0, 6);
      try {
        localStorage.setItem('tcg_search_recent', JSON.stringify(list));
      } catch (e) {}

      renderRecentlyViewed();
    }

    window.recordTcgProductView = recordProductView;

    function renderRecentlyViewed() {
      if (!recentCardsContainer) return;
      const recentSection = document.getElementById('tcg-recent-section');
      const items = getCleanRecentItems();

      if (items.length > 0) {
        // Replace existing cards completely to avoid duplicates
        recentCardsContainer.innerHTML = '';
        if (recentSection) recentSection.style.display = 'block';

        items.slice(0, 4).forEach((item) => {
          const card = document.createElement('a');
          card.href = item.url;
          card.className = 'tcg-search-card';

          const imgBox = document.createElement('div');
          imgBox.className = 'tcg-search-card__img-box';
          const img = document.createElement('img');
          img.src = item.image || '{{ "card-back.svg" | asset_url }}';
          img.alt = item.title;
          img.loading = 'lazy';
          imgBox.appendChild(img);

          const title = document.createElement('div');
          title.className = 'tcg-search-card__title';
          title.textContent = item.title;

          const price = document.createElement('div');
          price.className = 'tcg-search-card__price';
          price.textContent = item.price;

          card.appendChild(imgBox);
          card.appendChild(title);
          card.appendChild(price);
          recentCardsContainer.appendChild(card);
        });
      } else {
        const existingCards = recentCardsContainer.querySelectorAll('.tcg-search-card');
        if (existingCards.length === 0 && recentSection) {
          recentSection.style.display = 'none';
        }
      }
    }

    renderRecentlyViewed();

    /* --- Connect External Search Triggers --- */
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-search-open], [href="/search"], .search-action, #q');
      if (trigger) {
        // Prevent navigating or form submit, open modal instead
        e.preventDefault();
        const initialVal = trigger.tagName === 'INPUT' ? trigger.value : '';
        openModal(initialVal);
      }
    });

    // If hero search input receives focus or click, open modal
    const heroInput = document.getElementById('q');
    if (heroInput) {
      heroInput.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(heroInput.value);
      });
      heroInput.addEventListener('keydown', (e) => {
        e.preventDefault();
        openModal(e.key.length === 1 ? e.key : '');
      });
    }
  })();
</script>
