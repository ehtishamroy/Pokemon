{% comment %}
  TCG Hitz — Condition guide snippet
  Shopify: snippets/tcg-condition-guide.liquid
  Static; rendered inside main-product as a <details> accordion.
{% endcomment %}

<details class="rounded-card p-5 group" style="background:#141C3A;">
  <summary class="cursor-pointer font-semibold flex items-center justify-between" style="color:#F3F5FA;">
    What do the conditions mean?
    <svg class="h-5 w-5 transition group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" d="m6 9 6 6 6-6"/>
    </svg>
  </summary>
  <dl class="mt-4 space-y-3 text-[15px]">
    <div>
      <dt class="font-semibold" style="color:#F3F5FA;">Near Mint (NM)</dt>
      <dd style="color:#C5CCE0;">Looks unplayed. Crisp corners and edges, clean surface, little to no wear.</dd>
    </div>
    <div>
      <dt class="font-semibold" style="color:#F3F5FA;">Lightly Played (LP)</dt>
      <dd style="color:#C5CCE0;">Minor wear: light scratches or small edge and corner wear. Sleeve-and-play ready.</dd>
    </div>
    <div>
      <dt class="font-semibold" style="color:#F3F5FA;">Moderately Played (MP)</dt>
      <dd style="color:#C5CCE0;">Noticeable wear: moderate scratches, border or corner wear, light whitening.</dd>
    </div>
    <div>
      <dt class="font-semibold" style="color:#F3F5FA;">Heavily Played (HP)</dt>
      <dd style="color:#C5CCE0;">Significant wear: heavy scratches, creasing or whitening, but intact.</dd>
    </div>
    <div>
      <dt class="font-semibold" style="color:#F3F5FA;">Damaged (DMG)</dt>
      <dd style="color:#C5CCE0;">Major flaws: bends, tears, water damage or writing. Sold as-is.</dd>
    </div>
  </dl>
</details>
