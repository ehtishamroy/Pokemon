{% comment %}
  TCG Hitz — "JOIN THE TCG HITZ COMMUNITY." signup (client-approved design).
  Artwork on the left, heading + email form on the right. The form is Shopify's customer
  newsletter form (subscribers appear under Customers with the "newsletter" tag).
{% endcomment %}

{%- liquid
  assign form_id = 'tcg-home-newsletter-' | append: section.id
-%}

<section class="tcg-scope hz relative" id="community">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="relative mx-auto flex w-full max-w-[1440px] flex-col items-center gap-[42px] pt-[20px] xl:flex-row xl:pr-[80px]">
    <div class="relative h-[300px] w-full shrink-0 overflow-hidden sm:h-[472px] xl:w-[651px]">
      {% render 'tcg-home-img', image: section.settings.image, mobile: section.settings.image_mobile, fallback: 'home-community.webp', w: 1300, h: 1105, width: 1400, sizes: '(min-width: 1280px) 651px, 100vw', alt: section.settings.image_alt, class: 'absolute inset-0 h-full w-full max-w-none object-cover object-left' %}
    </div>
    <div class="flex w-full flex-col items-start gap-[32px] px-5 pb-[32px] md:px-10 xl:w-auto xl:px-0">
      <div class="flex flex-col items-start gap-[16px]">
        {%- if section.settings.eyebrow != blank -%}<div class="hz-eyebrow"><span>{{ section.settings.eyebrow }}</span></div>{%- endif -%}
        <h2 class="w-full max-w-[454px] font-display text-[36px] uppercase leading-[1.15] text-white md:text-[48px] md:leading-[55px]">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="text-[16px] leading-[1.5] text-white xl:whitespace-nowrap">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', id: form_id, class: 'w-full' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="inline-flex rounded-full border border-solid border-hz-success/50 bg-hz-success/10 px-6 py-4 font-bold text-white" role="status">{{ section.settings.success_text }}</p>
        {%- else -%}
          {%- if form.errors -%}<p class="mb-3 text-sm text-hz-crimson" role="alert">{{ form.errors.messages['email'] }}</p>{%- endif -%}
          <div class="flex w-full flex-col items-stretch gap-[16px] sm:flex-row sm:items-center">
            <label class="relative flex h-[56px] w-full items-center rounded-full tcg-gb tcg-gb--red [--bw:1.5px] bg-white/[0.08] px-[22.5px] sm:w-[480px]">
              <span class="sr-only">{{ section.settings.placeholder }}</span>
              <input type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.placeholder | escape }}" class="w-full min-w-0 border-0 bg-transparent text-[16px] leading-[1.3] text-white outline-none placeholder:text-white">
            </label>
            <button type="submit" class="hz-btn-red h-[56px] w-full text-[16px] sm:w-[171px]">{{ section.settings.button_label }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Home — Community",
  "class": "tcg-home-section",
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "none" },
    { "type": "image_picker", "id": "image", "label": "Artwork", "info": "Defaults to the design's Pikachu artwork." },
    { "type": "image_picker", "id": "image_mobile", "label": "Artwork — mobile (optional)" },
    { "type": "text", "id": "image_alt", "label": "Artwork description (alt text)", "default": "TCG HITZ community" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GET STARTED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "JOIN THE TCG HITZ COMMUNITY." },
    { "type": "text", "id": "text", "label": "Text", "default": "Get updates on new arrivals, collectible drops, and store news." },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Type your email address ..." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in! Welcome to the TCG HITZ community." }
  ],
  "presets": [{ "name": "TCG Home — Community" }]
}
{% endschema %}
