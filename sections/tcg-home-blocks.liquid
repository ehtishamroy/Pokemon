{% comment %}
  TCG Hitz — Trust + Sell & Shows + Newsletter
  Shopify: sections/tcg-home-blocks.liquid
  All three supporting home sections in one file, shown via blocks.
{% endcomment %}

{% for block in section.blocks %}

  {% if block.type == 'trust' %}
    <section class="tcg-section" style="border-top:1px solid rgba(255,255,255,.05);" {{ block.shopify_attributes }}>
      <div class="mx-auto max-w-site px-4 sm:px-6 py-14 lg:py-20 tcg-grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5">
          <h2 class="font-display text-3xl sm:text-4xl" style="color:#F3F5FA;">
            {{ block.settings.heading }}
          </h2>
          <p class="mt-4 leading-relaxed max-w-[52ch]" style="color:#C5CCE0;">
            {{ block.settings.body }}
          </p>
        </div>
        <div class="lg:col-span-7 tcg-grid sm:grid-cols-3 gap-5">
          <div class="rounded-card p-5" style="background:#141C3A;">
            <svg class="h-7 w-7" style="color:#3EC1FF;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/><path d="M8 6l1.2-2h5.6L16 6"/>
            </svg>
            <h3 class="mt-4 font-bold" style="color:#F3F5FA;">Two real photos</h3>
            <p class="mt-1 text-sm" style="color:#C5CCE0;">Front and back of the exact card, added when we list it.</p>
          </div>
          <div class="rounded-card p-5" style="background:#141C3A;">
            <svg class="h-7 w-7" style="color:#3EC1FF;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path stroke-linecap="round" d="m9 12 2 2 4-4"/>
            </svg>
            <h3 class="mt-4 font-bold" style="color:#F3F5FA;">Honest conditions</h3>
            <p class="mt-1 text-sm" style="color:#C5CCE0;">NM, LP, MP, HP — graded the same way every time, explained on every page.</p>
          </div>
          <div class="rounded-card p-5" style="background:#141C3A;">
            <svg class="h-7 w-7" style="color:#3EC1FF;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/>
            </svg>
            <h3 class="mt-4 font-bold" style="color:#F3F5FA;">Rigid sleeve, next day</h3>
            <p class="mt-1 text-sm" style="color:#C5CCE0;">Penny sleeve, top loader, team bag, bubble mailer. Out within one business day.</p>
          </div>
        </div>
      </div>
    </section>

  {% elsif block.type == 'sell_and_shows' %}
    <section id="sell" class="tcg-section" style="border-top:1px solid rgba(255,255,255,.05);" {{ block.shopify_attributes }}>
      <div class="mx-auto max-w-site px-4 sm:px-6 py-14 lg:py-20 tcg-grid md:grid-cols-2 gap-5">
        <div class="rounded-card p-8" style="background:#141C3A;">
          <h2 class="font-display text-3xl" style="color:#F3F5FA;">Selling a collection?</h2>
          <p class="mt-3 leading-relaxed" style="color:#C5CCE0;">
            {{ block.settings.sell_body }}
          </p>
          <a href="{{ block.settings.sell_link }}"
             class="mt-6 inline-flex rounded-full border px-5 py-3 font-semibold"
             style="border-color:rgba(255,255,255,.15);color:#F3F5FA;"
             onmouseover="this.style.borderColor='#3EC1FF';this.style.color='#3EC1FF';"
             onmouseout="this.style.borderColor='rgba(255,255,255,.15)';this.style.color='#F3F5FA';">
            {{ block.settings.sell_cta }}
          </a>
        </div>
        <div id="visit" class="rounded-card p-8" style="background:#141C3A;">
          <h2 class="font-display text-3xl" style="color:#F3F5FA;">Find us at the next show</h2>
          <ul class="mt-4" style="border-top:1px solid rgba(255,255,255,.05);">
            {% assign shows = block.settings.shows_text | newline_to_br | split: '<br />' %}
            {% for show in shows %}
              {% unless show == blank %}
                <li class="py-3 flex justify-between gap-4" style="border-bottom:1px solid rgba(255,255,255,.05);">
                  <span class="font-semibold" style="color:#F3F5FA;">{{ show }}</span>
                </li>
              {% endunless %}
            {% endfor %}
          </ul>
        </div>
      </div>
    </section>

  {% elsif block.type == 'newsletter' %}
    <section class="tcg-section" style="border-top:1px solid rgba(255,255,255,.05);" {{ block.shopify_attributes }}>
      <div class="mx-auto max-w-site px-4 sm:px-6 py-14 lg:py-20">
        <div class="rounded-card p-8 lg:p-12 tcg-grid lg:grid-cols-2 gap-8 items-center" style="background:#141C3A;">
          <div>
            <h2 class="font-display text-3xl sm:text-4xl" style="color:#F3F5FA;">
              {{ block.settings.heading }}
            </h2>
            <p class="mt-3" style="color:#C5CCE0;">{{ block.settings.body }}</p>
          </div>
          {% form 'customer', id: 'tcg-newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="flex flex-col sm:flex-row gap-3">
              <label class="sr-only" for="tcg-newsletter-email">Email address</label>
              <input id="tcg-newsletter-email"
                     type="email"
                     name="contact[email]"
                     required
                     placeholder="you@email.com"
                     class="flex-1 rounded-full border px-5 py-3.5"
                     style="background:#0E1530;border-color:rgba(255,255,255,.10);color:#F3F5FA;">
              <button type="submit"
                      class="rounded-full px-6 py-3.5 font-bold"
                      style="background:#FFC72C;color:#0E1530;">
                Subscribe
              </button>
            </div>
          {% endform %}
        </div>
      </div>
    </section>
  {% endif %}

{% endfor %}

{% schema %}
{
  "name": "TCG – Home Blocks",
  "blocks": [
    {
      "type": "trust",
      "name": "Trust strip",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Buy the card you see, not a stock photo."
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Big marketplaces show a catalogue picture. We photograph the actual card — front and back — so the corners, centering and surface you're paying for are the ones that arrive."
        }
      ]
    },
    {
      "type": "sell_and_shows",
      "name": "Sell & Card shows",
      "settings": [
        {
          "type": "textarea",
          "id": "sell_body",
          "label": "Sell to us — body",
          "default": "Bring it to a show or send photos. We buy raw singles, slabs and sealed — fair market offers, paid the same day."
        },
        {
          "type": "text",
          "id": "sell_cta",
          "label": "Sell to us — button label",
          "default": "Get an offer"
        },
        {
          "type": "url",
          "id": "sell_link",
          "label": "Sell to us — button link"
        },
        {
          "type": "textarea",
          "id": "shows_text",
          "label": "Card show dates (one per line)",
          "default": "Sat, Sep 13 — Collect-A-Con · Table 42\nSun, Sep 21 — Regional TCG Expo · Booth B7\nSat, Oct 4 — Fall Card Show · Main hall"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New pulls in your inbox"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body",
          "default": "One email after each card show with what we brought home. No spam, unsubscribe anytime."
        }
      ]
    }
  ],
  "settings": [],
  "presets": [
    {
      "name": "TCG – Home Blocks",
      "blocks": [
        { "type": "trust" },
        { "type": "sell_and_shows" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
