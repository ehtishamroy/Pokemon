{% comment %}
  TCG Hitz — Cart drawer (1:1 with the <aside data-drawer> in tcg-hitz-store/*.html)
  Rendered once from layout/theme.liquid via {% section 'tcg-cart-drawer' %} and
  re-fetched by assets/tcg.js (?section_id=tcg-cart-drawer) after every cart change.
{% endcomment %}

<div data-scrim data-cart-close class="scrim fixed inset-0 z-40 bg-black/60"></div>
<aside data-drawer data-cart-count-src="{{ cart.item_count }}" class="tcg-scope drawer fixed top-0 right-0 z-50 h-full w-full max-w-md bg-ink border-l border-gold/15 shadow-card flex flex-col font-sans antialiased text-paper" aria-label="Cart">
  <div class="flex items-center justify-between p-5 border-b border-gold/15"><h2 class="font-display text-2xl">Your cart</h2><button data-cart-close class="p-2 rounded-full hover:bg-felt-3" aria-label="Close cart"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg></button></div>
  <div data-cart-items class="flex-1 overflow-y-auto px-5">
    {%- if cart.item_count == 0 -%}
      <div class="py-16 text-center">
        <p class="font-display text-2xl">Your cart is empty</p>
        <p class="mt-2 text-slate">Find a pull worth chasing.</p>
        <a href="{{ routes.all_products_collection_url }}" class="mt-6 inline-flex rounded-full bg-gold px-5 py-2.5 font-bold text-ink hover:bg-gold-deep">Shop singles</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        {%- assign dec = item.quantity | minus: 1 | at_least: 1 -%}
        {%- assign inc = item.quantity | plus: 1 -%}
        <div class="flex gap-4 py-4 border-b border-white/5">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 160 }}" alt="" width="64" height="90" class="w-16 h-[90px] object-contain rounded-md bg-felt-3 p-1">
          {%- else -%}
            <img src="{{ 'card-back.svg' | asset_url }}" alt="" width="64" height="90" class="w-16 h-[90px] object-contain rounded-md bg-felt-3 p-1">
          {%- endif -%}
          <div class="flex-1 min-w-0">
            <p class="font-semibold truncate"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
            <p class="text-sm text-slate">{% unless item.variant.title == 'Default Title' %}{{ item.variant.title }}{% endunless %}</p>
            <div class="mt-2 flex items-center gap-3">
              <div class="qty inline-flex items-center rounded-full bg-felt-3 text-sm">
                <button type="button" aria-label="Decrease" data-line-qty data-line="{{ forloop.index }}" data-qty="{{ dec }}" class="rounded-full">−</button>
                <span class="w-6 text-center">{{ item.quantity }}</span>
                <button type="button" aria-label="Increase" data-line-qty data-line="{{ forloop.index }}" data-qty="{{ inc }}" class="rounded-full">+</button>
              </div>
              <button type="button" data-line-qty data-line="{{ forloop.index }}" data-qty="0" class="text-sm text-slate hover:text-chase">Remove</button>
            </div>
          </div>
          <p class="font-semibold text-gold">{{ item.final_line_price | money }}</p>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div data-cart-foot class="{% if cart.item_count == 0 %}hidden {% endif %}p-5 border-t border-gold/15">
    <div class="flex justify-between text-lg"><span class="text-paper-dim">Subtotal</span><span data-cart-total class="font-bold text-gold">{{ cart.total_price | money }}</span></div>
    <p class="mt-1 text-sm text-slate">Shipping calculated at checkout.</p>
    <a href="{{ routes.cart_url }}" class="mt-4 block text-center rounded-full border border-gold/45 px-6 py-3 font-bold text-gold hover:bg-gold/10">View cart</a>
    <a href="{{ routes.cart_url }}/checkout" class="mt-2 block text-center rounded-full bg-gold px-6 py-3.5 font-bold text-ink hover:bg-gold-deep">Checkout</a>
  </div>
</aside>

{% schema %}
{
  "name": "TCG Cart Drawer",
  "settings": []
}
{% endschema %}
