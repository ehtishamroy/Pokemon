{% comment %}
  TCG Hitz — Header (1:1 with <header> in tcg-hitz-store/index.html)
  Nav links + the "Cards" mega-menu tiles are section blocks so they are editable
  in the theme editor; the defaults in header-group.json mirror the reference.
  The cart button opens sections/tcg-cart-drawer.liquid (assets/tcg.js).
{% endcomment %}

{%- liquid
  assign logo_url = 'logo.png' | asset_url
  if section.settings.logo != blank
    assign logo_url = section.settings.logo | image_url: width: 400
  endif
  assign mega_blocks = section.blocks | where: 'type', 'mega_item'
  assign nav_blocks = section.blocks | where: 'type', 'nav_link'
-%}

<header class="tcg-scope sticky top-0 z-40 bg-ink/90 backdrop-blur border-b border-gold/15 font-sans antialiased text-paper">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="flex h-[72px] items-center gap-6">
      <a href="{{ routes.root_url }}" class="shrink-0" aria-label="{{ shop.name | escape }} home"><img src="{{ logo_url }}" alt="{{ shop.name | escape }} — Chase the Rare" class="h-12 w-auto"></a>
      <nav data-nav class="hidden flex lg:!flex items-stretch lg:items-center gap-0.5 text-[14px] font-semibold absolute lg:static left-0 right-0 top-[72px] bg-ink lg:bg-transparent p-4 lg:p-0 flex-col lg:flex-row border-b border-gold/15 lg:border-0 z-40">
        {%- if section.settings.mega_label != blank -%}
          <div class="has-mega relative">
            <a href="{{ section.settings.mega_link | default: routes.all_products_collection_url }}" class="px-3 py-2 rounded-md hover:bg-felt-3 {% if template.name == 'collection' %} bg-felt-3 text-gold{% endif %} inline-flex items-center gap-1">{{ section.settings.mega_label }}
              <svg class="h-3.5 w-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m6 9 6 6 6-6"/></svg></a>
            {%- if mega_blocks.size > 0 -%}
              <div class="mega absolute left-0 top-full pt-3 w-[520px] max-w-[92vw]">
                <div class="cabinet p-4 grid grid-cols-2 gap-2.5 bg-ink">
                  {%- for block in mega_blocks -%}
                    <a href="{{ block.settings.link }}" class="cat rounded-lg p-3 bg-felt-2" {{ block.shopify_attributes }}><span class="block font-bold text-sm">{{ block.settings.title }}</span><span class="text-xs text-slate">{{ block.settings.subtitle }}</span></a>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- for block in nav_blocks -%}
          <a href="{{ block.settings.link }}" class="px-3 py-2 rounded-md hover:bg-felt-3{% if block.settings.gold %} text-gold{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endfor -%}
      </nav>
      <div class="flex items-center gap-1.5 ml-auto">
        <button type="button" data-search-open class="p-2 rounded-full hover:bg-felt-3 text-paper hover:text-gold transition-colors" aria-label="Search" title="Search (Press /)">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"/>
            <path stroke-linecap="round" d="m20 20-3.5-3.5"/>
          </svg>
        </button>

        <!-- Animated Pikachu Cart Button with Famous Pokemon Thunderbolt -->
        <button type="button" data-cart-open class="tcg-pikachu-cart-btn relative p-1.5 rounded-full hover:bg-felt-3 transition-colors flex items-center justify-center group" aria-label="Open cart" title="Pikachu Cart">
          <!-- Pikachu Electric Thunderbolt Sparks -->
          <div class="tcg-pika-thunder-wrap" aria-hidden="true">
            <svg class="tcg-pika-bolt tcg-pika-bolt-1" viewBox="0 0 24 24"><path d="M13 2L3 14h7v8l11-14h-8l3-6z"/></svg>
            <svg class="tcg-pika-bolt tcg-pika-bolt-2" viewBox="0 0 24 24"><path d="M11 2L5 13h5v7l9-12h-6l3-6z"/></svg>
            <svg class="tcg-pika-bolt tcg-pika-bolt-3" viewBox="0 0 24 24"><path d="M13 3L4 14h6v7l10-13h-7l3-5z"/></svg>
            <div class="tcg-pika-electric-aura"></div>
          </div>

          <img
            src="{{ 'pikachu.png' | asset_url }}"
            alt="Pikachu Cart"
            class="tcg-pikachu-cart-img select-none pointer-events-none"
            width="34"
            height="34"
            loading="eager"
          >
          <span data-cart-count class="{% if cart.item_count == 0 %}hidden {% endif %}absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-gold text-ink text-[11px] font-extrabold grid place-items-center shadow-md ring-2 ring-ink">
            {{ cart.item_count }}
          </span>
        </button>

        <button type="button" data-nav-toggle aria-expanded="false" aria-label="Menu" class="lg:hidden p-2.5 rounded-full hover:bg-felt-3"><svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      </div>
    </div>
  </div>

  <style>
    /* ==========================================================
       PIKACHU CART & FAMOUS POKEMON THUNDER EFFECT
       ========================================================== */
    @keyframes pikachu-idle-bob {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
      }
      25% {
        transform: translateY(-2px) rotate(-3deg);
      }
      75% {
        transform: translateY(1px) rotate(2deg);
      }
    }

    @keyframes pikachu-wiggle-joy {
      0%, 100% {
        transform: scale(1.15) rotate(0deg);
      }
      20% {
        transform: scale(1.2) rotate(-10deg);
      }
      40% {
        transform: scale(1.22) rotate(10deg);
      }
      60% {
        transform: scale(1.18) rotate(-6deg);
      }
      80% {
        transform: scale(1.16) rotate(6deg);
      }
    }

    @keyframes pikachu-bounce-bump {
      0% {
        transform: scale(1) translateY(0);
      }
      35% {
        transform: scale(1.35) translateY(-8px) rotate(-8deg);
      }
      70% {
        transform: scale(1.18) translateY(2px) rotate(6deg);
      }
      100% {
        transform: scale(1) translateY(0);
      }
    }

    .tcg-pikachu-cart-btn {
      cursor: pointer;
      line-height: 1;
      width: 44px;
      height: 44px;
    }

    .tcg-pikachu-cart-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
      transform-origin: bottom center;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
      animation: pikachu-idle-bob 4.5s ease-in-out infinite;
      filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
      position: relative;
      z-index: 2;
    }

    /* Pikachu Thunderbolt Lightning Sparks */
    .tcg-pika-thunder-wrap {
      position: absolute;
      inset: -6px;
      pointer-events: none;
      z-index: 3;
    }

    .tcg-pika-bolt {
      position: absolute;
      width: 16px;
      height: 16px;
      fill: #FFF500;
      filter:
        drop-shadow(0 0 4px #FFFFFF)
        drop-shadow(0 0 8px #FFC72C)
        drop-shadow(0 0 14px #FFA800);
      opacity: 0;
      transform: scale(0);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .tcg-pika-bolt-1 {
      top: -4px;
      left: -2px;
      transform: rotate(-22deg) scale(0);
    }
    .tcg-pika-bolt-2 {
      top: -6px;
      right: -2px;
      transform: rotate(32deg) scale(0);
    }
    .tcg-pika-bolt-3 {
      bottom: -2px;
      right: 4px;
      transform: rotate(85deg) scale(0);
    }

    /* Electric Aura Pulse */
    .tcg-pika-electric-aura {
      position: absolute;
      inset: 4px;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(255, 245, 0, 0.25) 0%, rgba(255, 200, 44, 0.15) 50%, transparent 75%);
      opacity: 0;
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
    }

    /* Active Thunderbolt discharge on Hover & Bump */
    .tcg-pikachu-cart-btn:hover .tcg-pikachu-cart-img {
      animation: pikachu-wiggle-joy 0.55s ease-in-out infinite;
      filter:
        drop-shadow(0 0 12px rgba(255, 245, 0, 0.95))
        drop-shadow(0 0 20px rgba(255, 168, 0, 0.6))
        drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
    }

    .tcg-pikachu-cart-btn:hover .tcg-pika-electric-aura {
      opacity: 1;
      animation: pika-aura-surge 0.45s ease-in-out infinite alternate;
    }

    .tcg-pikachu-cart-btn:hover .tcg-pika-bolt-1 {
      opacity: 1;
      animation: pika-bolt-strike-1 0.35s steps(2, start) infinite;
    }
    .tcg-pikachu-cart-btn:hover .tcg-pika-bolt-2 {
      opacity: 1;
      animation: pika-bolt-strike-2 0.4s steps(2, start) infinite 0.1s;
    }
    .tcg-pikachu-cart-btn:hover .tcg-pika-bolt-3 {
      opacity: 1;
      animation: pika-bolt-strike-3 0.38s steps(2, start) infinite 0.05s;
    }

    @keyframes pika-aura-surge {
      0% { transform: scale(0.9); opacity: 0.4; }
      100% { transform: scale(1.35); opacity: 0.85; }
    }

    @keyframes pika-bolt-strike-1 {
      0% { opacity: 0; transform: rotate(-22deg) scale(0.6) translate(-2px, -2px); }
      50% { opacity: 1; transform: rotate(-15deg) scale(1.3) translate(0, 0); }
      100% { opacity: 0.3; transform: rotate(-28deg) scale(0.9) translate(-1px, -1px); }
    }
    @keyframes pika-bolt-strike-2 {
      0% { opacity: 0.2; transform: rotate(32deg) scale(0.8); }
      50% { opacity: 1; transform: rotate(40deg) scale(1.25); }
      100% { opacity: 0; transform: rotate(26deg) scale(0.5); }
    }
    @keyframes pika-bolt-strike-3 {
      0% { opacity: 1; transform: rotate(85deg) scale(1.2); }
      50% { opacity: 0.2; transform: rotate(75deg) scale(0.7); }
      100% { opacity: 0.9; transform: rotate(92deg) scale(1.15); }
    }

    /* Ambient Periodic Lightning Zap (Every 5s Pikachu zaps a spark!) */
    @keyframes pika-ambient-zap {
      0%, 88%, 100% {
        opacity: 0;
        transform: rotate(32deg) scale(0);
      }
      90% {
        opacity: 1;
        transform: rotate(35deg) scale(1.2);
      }
      92% {
        opacity: 0.3;
        transform: rotate(28deg) scale(0.7);
      }
      94% {
        opacity: 1;
        transform: rotate(38deg) scale(1.3);
      }
      96% {
        opacity: 0;
        transform: rotate(32deg) scale(0);
      }
    }
    .tcg-pika-bolt-2 {
      animation: pika-ambient-zap 5s ease-in-out infinite;
    }

    .tcg-pikachu-cart-btn:active .tcg-pikachu-cart-img {
      transform: scale(0.9);
      transition: transform 0.1s ease;
    }

    .tcg-pikachu-cart-btn:has([data-cart-count].is-bumping) .tcg-pikachu-cart-img {
      animation: pikachu-bounce-bump 0.55s cubic-bezier(0.16, 1, 0.3, 1);
      filter:
        drop-shadow(0 0 16px rgba(255, 245, 0, 1))
        drop-shadow(0 0 25px rgba(255, 168, 0, 0.8));
    }
  </style>
</header>

{% schema %}
{
  "name": "TCG Header",
  "tag": "div",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (defaults to assets/logo.png)" },
    { "type": "text", "id": "mega_label", "label": "Mega-menu label", "default": "Cards" },
    { "type": "url", "id": "mega_link", "label": "Mega-menu link" },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true }
  ],
  "blocks": [
    {
      "type": "mega_item",
      "name": "Mega-menu tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Singles" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Raw cards, real photos" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "nav_link",
      "name": "Nav link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Mystery" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "gold", "label": "Highlight in gold", "default": false }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
