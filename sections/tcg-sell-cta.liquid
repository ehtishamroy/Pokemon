{% comment %}
  TCG Hitz — Sell to us CTA (Interactive Animated Experience)
  High-energy collector banner with glowing ambient mesh, holographic accents,
  corner brackets, and responsive hover/touch feedback.
{% endcomment %}

<section id="sell" class="tcg-scope py-12 lg:py-18">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="tcg-sell-card" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
      <!-- Ambient Glow & Cyber Grid -->
      <div class="tcg-sell-bg-glow" aria-hidden="true"></div>
      <div class="tcg-sell-grid-lines" aria-hidden="true"></div>
      <span class="tcg-sell-shine" aria-hidden="true"></span>

      <!-- Floating Holographic Mini Cards (Hidden on mobile, visible on md+) -->
      <div class="tcg-sell-foil-badge tcg-sell-foil-left hidden md:flex" aria-hidden="true">
        <div class="tcg-foil-inner">
          <span class="tcg-foil-icon">⚡</span>
          <div class="tcg-foil-meta">
            <span class="tcg-foil-top">RAW & SLABS</span>
            <span class="tcg-foil-sub">PSA · CGC · BGS</span>
          </div>
        </div>
      </div>

      <div class="tcg-sell-foil-badge tcg-sell-foil-right hidden md:flex" aria-hidden="true">
        <div class="tcg-foil-inner">
          <span class="tcg-foil-icon">💰</span>
          <div class="tcg-foil-meta">
            <span class="tcg-foil-top">INSTANT PAYOUT</span>
            <span class="tcg-foil-sub">Cash or Trade</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="tcg-sell-content relative z-10 text-center max-w-2xl mx-auto">
        <!-- Eyebrow Badge -->
        <div class="tcg-sell-badge inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-5">
          <span class="tcg-sell-dot"></span>
          <span class="tcg-sell-badge-text">{{ section.settings.badge | default: 'FAST OFFERS · WE BUY DAILY' }}</span>
        </div>

        <h2 class="tcg-sell-title font-display text-3xl sm:text-4xl lg:text-5xl leading-[1.1] text-white">
          {{ section.settings.heading }}
        </h2>

        <p class="tcg-sell-desc mt-4 text-paper-dim text-sm sm:text-base leading-relaxed max-w-[52ch] mx-auto">
          {{ section.settings.body }}
        </p>

        <!-- 3 Feature Chips -->
        <div class="tcg-sell-chips mt-6 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3 text-xs font-semibold">
          <span class="tcg-sell-chip">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            Singles, Slabs & Sealed
          </span>
          <span class="tcg-sell-chip">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            Fair Market Valuation
          </span>
          <span class="tcg-sell-chip">
            <svg class="w-3.5 h-3.5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            At Shows or Online
          </span>
        </div>

        <!-- Action Button -->
        <div class="mt-8 flex justify-center">
          <a href="{{ section.settings.cta_link | default: '/pages/sell' }}" class="tcg-sell-btn group" aria-label="{{ section.settings.cta_label }}">
            <span class="tcg-sell-btn__shine" aria-hidden="true"></span>
            <span class="tcg-sell-btn__text">{{ section.settings.cta_label }}</span>
            <span class="tcg-sell-btn__arrow" aria-hidden="true">
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* ==========================================================
       TCG SELL CTA — PREMIUM ANIMATED CARD & HOVER/TOUCH
       ========================================================== */
    .tcg-sell-card {
      position: relative;
      border-radius: 26px;
      background: linear-gradient(155deg, rgba(20, 20, 26, 0.98) 0%, rgba(10, 10, 14, 0.99) 60%, rgba(22, 19, 12, 0.98) 100%);
      border: 1.5px solid rgba(255, 199, 44, 0.32);
      padding: 3rem 1.5rem;
      overflow: hidden;
      box-shadow:
        0 18px 48px -12px rgba(0, 0, 0, 0.92),
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        0 0 45px rgba(255, 199, 44, 0.08);
      transition:
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
        border-color 0.35s ease,
        box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      outline: none;
      cursor: default;
      -webkit-tap-highlight-color: transparent;
    }

    @media (min-width: 640px) {
      .tcg-sell-card {
        padding: 3.75rem 2.5rem;
      }
    }
    @media (min-width: 1024px) {
      .tcg-sell-card {
        padding: 4.5rem 3.5rem;
      }
    }

    /* Ambient Pulsing Glow */
    .tcg-sell-bg-glow {
      position: absolute;
      inset: -20%;
      background: radial-gradient(circle at 50% 45%, rgba(255, 199, 44, 0.16) 0%, rgba(255, 150, 0, 0.05) 42%, transparent 70%);
      pointer-events: none;
      animation: tcg-sell-glow-pulse 6s ease-in-out infinite alternate;
      z-index: 1;
    }
    @keyframes tcg-sell-glow-pulse {
      0% {
        opacity: 0.55;
        transform: scale(0.96);
      }
      100% {
        opacity: 0.95;
        transform: scale(1.08);
      }
    }

    /* Holographic Grid Pattern */
    .tcg-sell-grid-lines {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(to right, rgba(255, 199, 44, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 199, 44, 0.035) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
      z-index: 2;
      animation: tcg-sell-grid-drift 30s linear infinite;
    }
    @keyframes tcg-sell-grid-drift {
      0% { background-position: 0 0; }
      100% { background-position: 0 64px; }
    }

    /* Decorative Gold Corner Brackets */
    .tcg-sell-card::before,
    .tcg-sell-card::after {
      content: "";
      position: absolute;
      width: 28px;
      height: 28px;
      pointer-events: none;
      border: 2px solid #FFC72C;
      opacity: 0.5;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 4;
    }
    .tcg-sell-card::before {
      top: 14px;
      left: 14px;
      border-right: none;
      border-bottom: none;
      border-radius: 9px 0 0 0;
    }
    .tcg-sell-card::after {
      bottom: 14px;
      right: 14px;
      border-left: none;
      border-top: none;
      border-radius: 0 0 9px 0;
    }

    /* Sweep Shine Beam */
    .tcg-sell-shine {
      position: absolute;
      top: 0;
      left: -130%;
      width: 65%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.03) 30%,
        rgba(255, 199, 44, 0.15) 50%,
        rgba(255, 255, 255, 0.03) 70%,
        transparent 100%
      );
      transform: skewX(-25deg);
      pointer-events: none;
      z-index: 3;
      transition: none;
    }

    /* Hover & Touch States */
    .tcg-sell-card:hover,
    .tcg-sell-card:focus-visible,
    .tcg-sell-card.is-active {
      transform: translateY(-5px);
      border-color: rgba(255, 199, 44, 0.75);
      box-shadow:
        0 26px 56px -12px rgba(0, 0, 0, 0.96),
        0 0 45px rgba(255, 199, 44, 0.28),
        inset 0 0 25px rgba(255, 199, 44, 0.08);
    }
    .tcg-sell-card:hover::before,
    .tcg-sell-card:hover::after,
    .tcg-sell-card:focus-visible::before,
    .tcg-sell-card:focus-visible::after,
    .tcg-sell-card.is-active::before,
    .tcg-sell-card.is-active::after {
      opacity: 1;
      width: 38px;
      height: 38px;
      filter: drop-shadow(0 0 8px rgba(255, 199, 44, 0.9));
    }
    .tcg-sell-card:hover .tcg-sell-shine,
    .tcg-sell-card.is-active .tcg-sell-shine {
      left: 200%;
      transition: left 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Floating Foil Badges (Desktop) */
    .tcg-sell-foil-badge {
      position: absolute;
      top: 50%;
      z-index: 5;
      pointer-events: none;
    }
    .tcg-sell-foil-left {
      left: 3rem;
      animation: tcg-float-left 5.5s ease-in-out infinite;
    }
    .tcg-sell-foil-right {
      right: 3rem;
      animation: tcg-float-right 6s ease-in-out infinite;
    }
    @keyframes tcg-float-left {
      0%, 100% {
        transform: translateY(-50%) rotate(-6deg);
      }
      50% {
        transform: translateY(calc(-50% - 14px)) rotate(-2deg);
      }
    }
    @keyframes tcg-float-right {
      0%, 100% {
        transform: translateY(-50%) rotate(6deg);
      }
      50% {
        transform: translateY(calc(-50% - 16px)) rotate(9deg);
      }
    }

    .tcg-foil-inner {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1.1rem;
      border-radius: 14px;
      background: rgba(18, 18, 24, 0.88);
      border: 1.5px solid rgba(255, 199, 44, 0.45);
      backdrop-filter: blur(12px);
      box-shadow:
        0 10px 25px -5px rgba(0, 0, 0, 0.7),
        0 0 20px rgba(255, 199, 44, 0.18);
      transition: all 0.35s ease;
    }
    .tcg-sell-card:hover .tcg-foil-inner,
    .tcg-sell-card.is-active .tcg-foil-inner {
      border-color: #FFC72C;
      box-shadow:
        0 14px 30px -5px rgba(0, 0, 0, 0.85),
        0 0 28px rgba(255, 199, 44, 0.45);
    }
    .tcg-foil-icon {
      font-size: 1.25rem;
      line-height: 1;
    }
    .tcg-foil-meta {
      display: flex;
      flex-direction: column;
      text-align: left;
    }
    .tcg-foil-top {
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #FFC72C;
    }
    .tcg-foil-sub {
      font-size: 0.65rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
    }

    /* Eyebrow Pill Badge */
    .tcg-sell-badge {
      background: rgba(255, 199, 44, 0.1);
      border: 1px solid rgba(255, 199, 44, 0.38);
      color: #FFC72C;
      letter-spacing: 0.09em;
      box-shadow: 0 0 16px rgba(255, 199, 44, 0.12);
      transition: all 0.3s ease;
    }
    .tcg-sell-dot {
      width: 7px;
      height: 7px;
      border-radius: 9999px;
      background: #FFC72C;
      box-shadow: 0 0 8px #FFC72C;
      animation: tcg-dot-pulse 2s ease-in-out infinite;
    }
    @keyframes tcg-dot-pulse {
      0%, 100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.4);
        opacity: 0.55;
      }
    }
    .tcg-sell-badge-text {
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 0.73rem;
      font-weight: 800;
      text-transform: uppercase;
    }

    /* Title & Description */
    .tcg-sell-title {
      font-family: 'Titan One', cursive, system-ui;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
      transition: color 0.3s ease;
    }
    .tcg-sell-desc {
      font-family: 'Manrope', system-ui, sans-serif;
      color: #d3d8e6;
    }

    /* Feature Chips */
    .tcg-sell-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.85rem;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #e4e7ef;
      font-family: 'Manrope', system-ui, sans-serif;
      transition: all 0.25s ease;
    }
    .tcg-sell-card:hover .tcg-sell-chip,
    .tcg-sell-card.is-active .tcg-sell-chip {
      background: rgba(255, 199, 44, 0.08);
      border-color: rgba(255, 199, 44, 0.35);
      color: #FFFFFF;
    }

    /* High Energy CTA Button */
    .tcg-sell-btn {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      border-radius: 9999px;
      background: linear-gradient(135deg, #FFC72C 0%, #FFA800 100%);
      padding: 0.95rem 2.2rem;
      font-family: 'Manrope', system-ui, sans-serif;
      font-weight: 800;
      font-size: 1.02rem;
      color: #0B0B0E;
      text-decoration: none;
      overflow: hidden;
      box-shadow:
        0 10px 24px -4px rgba(0, 0, 0, 0.65),
        0 0 24px rgba(255, 199, 44, 0.5);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }

    .tcg-sell-btn:hover,
    .tcg-sell-btn:focus-visible {
      transform: translateY(-3px) scale(1.04);
      background: linear-gradient(135deg, #FFD54F 0%, #FFB300 100%);
      box-shadow:
        0 14px 32px -4px rgba(0, 0, 0, 0.75),
        0 0 38px rgba(255, 199, 44, 0.85);
      color: #000000;
    }

    .tcg-sell-btn:active {
      transform: translateY(0) scale(0.98);
      transition-duration: 0.1s;
    }

    .tcg-sell-btn__shine {
      position: absolute;
      top: 0;
      left: -100%;
      width: 50%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      transform: skewX(-20deg);
      animation: tcg-btn-shine-sweep 4s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes tcg-btn-shine-sweep {
      0%, 60% { left: -100%; }
      100% { left: 200%; }
    }

    .tcg-sell-btn__arrow {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>

  <script>
    (function initSellCardTouch() {
      const card = document.querySelector('.tcg-sell-card');
      if (!card) return;
      let timer = null;

      card.addEventListener('touchstart', () => {
        card.classList.add('is-active');
      }, { passive: true });

      card.addEventListener('touchend', () => {
        clearTimeout(timer);
        timer = setTimeout(() => {
          card.classList.remove('is-active');
        }, 500);
      }, { passive: true });

      card.addEventListener('touchcancel', () => {
        card.classList.remove('is-active');
      }, { passive: true });
    })();
  </script>
</section>

{% schema %}
{
  "name": "TCG Sell CTA",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge text", "default": "FAST OFFERS · WE BUY DAILY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sell or trade your cards" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Bring it to a show or send photos. We buy singles, slabs and sealed — fair offers, paid fast." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get an offer" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "TCG Sell CTA" }]
}
{% endschema %}
