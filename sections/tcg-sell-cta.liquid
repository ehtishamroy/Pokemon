{% comment %}
  TCG Hitz — Sell to us CTA
  Matches index.html lines 250-259
{% endcomment %}

<section id="sell" class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="cabinet bg-ink p-8 lg:p-12 text-center">
      <h2 class="font-display text-3xl sm:text-4xl">{{ section.settings.heading }}</h2>
      <p class="mt-3 text-paper-dim max-w-[52ch] mx-auto">{{ section.settings.text }}</p>
      <a href="{{ section.settings.button_link | default: '/pages/sell' }}" class="mt-7 inline-flex rounded-full bg-gold px-7 py-3.5 font-bold text-ink hover:bg-gold-deep">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Sell CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sell or trade your cards"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bring it to a show or send photos. We buy singles, slabs and sealed — fair offers, paid fast."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Get an offer"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "TCG Sell CTA"
    }
  ]
}
{% endschema %}
