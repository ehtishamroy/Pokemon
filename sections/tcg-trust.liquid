{% comment %}
  TCG Hitz — Trust Section
  Matches index.html lines 189-200
{% endcomment %}

<section class="py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid md:grid-cols-3 gap-4">
      <div class="cabinet bg-ink p-6">
        <div class="h-10 w-10 rounded-lg border border-gold/40 grid place-items-center text-gold">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/></svg>
        </div>
        <h3 class="mt-4 font-bold">Two real photos</h3>
        <p class="mt-1 text-sm text-paper-dim">Front and back of the exact card you'll receive — never a stock image.</p>
      </div>
      <div class="cabinet bg-ink p-6">
        <div class="h-10 w-10 rounded-lg border border-gold/40 grid place-items-center text-gold">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>
        </div>
        <h3 class="mt-4 font-bold">Ships in 1 business day</h3>
        <p class="mt-1 text-sm text-paper-dim">Penny sleeve, top loader, team bag, bubble mailer. Protected end to end.</p>
      </div>
      <div class="cabinet bg-ink p-6">
        <div class="h-10 w-10 rounded-lg border border-gold/40 grid place-items-center text-gold">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path stroke-linecap="round" d="m9 12 2 2 4-4"/></svg>
        </div>
        <h3 class="mt-4 font-bold">Honest conditions</h3>
        <p class="mt-1 text-sm text-paper-dim">NM, LP, MP, HP — graded the same way every time, explained on every page.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why collectors trust TCG Hitz"
    }
  ],
  "presets": [
    {
      "name": "TCG Trust"
    }
  ]
}
{% endschema %}
