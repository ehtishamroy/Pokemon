{% comment %}
  TCG Hitz — Why collectors trust us (1:1 with index.html "WHY COLLECTORS TRUST US")
  Renders the three reference features by default; add `feature` blocks to customise.
{% endcomment %}

{%- capture icon_camera -%}<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="13" rx="2"/><circle cx="12" cy="12.5" r="3.2"/></svg>{%- endcapture -%}
{%- capture icon_truck -%}<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg>{%- endcapture -%}
{%- capture icon_shield -%}<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6z"/><path stroke-linecap="round" d="m9 12 2 2 4-4"/></svg>{%- endcapture -%}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
    <div class="tcg-trust-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="tcg-trust-card" tabindex="0" role="region" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <span class="tcg-trust-card__shine" aria-hidden="true"></span>
            <div class="tcg-trust-icon-box">
              {% case block.settings.icon %}{% when 'truck' %}{{ icon_truck }}{% when 'shield' %}{{ icon_shield }}{% else %}{{ icon_camera }}{% endcase %}
            </div>
            <h3 class="tcg-trust-heading">{{ block.settings.heading }}</h3>
            <p class="tcg-trust-body">{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="tcg-trust-card" tabindex="0" role="region" aria-label="Two real photos">
          <span class="tcg-trust-card__shine" aria-hidden="true"></span>
          <div class="tcg-trust-icon-box">{{ icon_camera }}</div>
          <h3 class="tcg-trust-heading">Two real photos</h3>
          <p class="tcg-trust-body">Front and back of the exact card you'll receive — never a stock image.</p>
        </div>
        <div class="tcg-trust-card" tabindex="0" role="region" aria-label="Ships in 1 business day">
          <span class="tcg-trust-card__shine" aria-hidden="true"></span>
          <div class="tcg-trust-icon-box">{{ icon_truck }}</div>
          <h3 class="tcg-trust-heading">Ships in 1 business day</h3>
          <p class="tcg-trust-body">Penny sleeve, top loader, team bag, bubble mailer. Protected end to end.</p>
        </div>
        <div class="tcg-trust-card" tabindex="0" role="region" aria-label="Honest conditions">
          <span class="tcg-trust-card__shine" aria-hidden="true"></span>
          <div class="tcg-trust-icon-box">{{ icon_shield }}</div>
          <h3 class="tcg-trust-heading">Honest conditions</h3>
          <p class="tcg-trust-body">NM, LP, MP, HP — graded the same way every time, explained on every page.</p>
        </div>
      {%- endif -%}
    </div>
  </div>

  <style>
    /* ==========================================================
       TCG TRUST — ANIMATED CARDS & TOUCH/HOVER INTERACTION
       ========================================================== */
    .tcg-trust-grid {
      display: grid;
      grid-template-columns: repeat(1, minmax(0, 1fr));
      gap: 1.25rem;
    }
    @media (min-width: 768px) {
      .tcg-trust-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
      }
    }

    .tcg-trust-card {
      position: relative;
      border-radius: 20px;
      background: linear-gradient(165deg, rgba(22, 22, 28, 0.96) 0%, rgba(10, 10, 13, 0.98) 100%);
      border: 1.5px solid rgba(77, 168, 255, 0.28);
      padding: 1.85rem 1.65rem;
      overflow: hidden;
      box-shadow:
        0 12px 32px -8px rgba(0, 0, 0, 0.85),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
      transition:
        transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
        border-color 0.3s ease,
        box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      outline: none;
    }

    /* Entrance Animation with Stagger */
    @keyframes tcg-card-enter {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .tcg-trust-card {
      animation: tcg-card-enter 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .tcg-trust-card:nth-child(1) { animation-delay: 0.08s; }
    .tcg-trust-card:nth-child(2) { animation-delay: 0.18s; }
    .tcg-trust-card:nth-child(3) { animation-delay: 0.28s; }

    /* Hover & Active / Touch States */
    .tcg-trust-card:hover,
    .tcg-trust-card:focus-visible,
    .tcg-trust-card.is-active {
      transform: translateY(-8px) scale(1.018);
      border-color: rgba(77, 168, 255, 0.85);
      box-shadow:
        0 22px 48px -12px rgba(0, 0, 0, 0.95),
        0 0 32px rgba(77, 168, 255, 0.28),
        inset 0 0 18px rgba(77, 168, 255, 0.09);
    }

    .tcg-trust-card:active {
      transform: translateY(-3px) scale(0.99);
      transition-duration: 0.12s;
    }

    /* Corner brackets: blue (top-left) / fire (bottom-right) */
    .tcg-trust-card::before,
    .tcg-trust-card::after {
      content: "";
      position: absolute;
      width: 24px;
      height: 24px;
      pointer-events: none;
      border: 2px solid #4DA8FF;
      opacity: 0.55;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tcg-trust-card::before {
      top: 10px;
      left: 10px;
      border-right: none;
      border-bottom: none;
      border-radius: 7px 0 0 0;
    }
    .tcg-trust-card::after {
      bottom: 10px;
      right: 10px;
      border-left: none;
      border-top: none;
      border-color: #FF6A1A;
      border-radius: 0 0 7px 0;
    }
    .tcg-trust-card:hover::before,
    .tcg-trust-card:hover::after,
    .tcg-trust-card:focus-visible::before,
    .tcg-trust-card:focus-visible::after,
    .tcg-trust-card.is-active::before,
    .tcg-trust-card.is-active::after {
      opacity: 1;
      width: 32px;
      height: 32px;
      filter: drop-shadow(0 0 7px rgba(77, 168, 255, 0.9));
    }

    /* Diagonal Shine Sweep */
    .tcg-trust-card__shine {
      position: absolute;
      top: 0;
      left: -130%;
      width: 75%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(255, 255, 255, 0.04) 30%,
        rgba(77, 168, 255, 0.14) 50%,
        rgba(255, 255, 255, 0.04) 70%,
        transparent 100%
      );
      transform: skewX(-25deg);
      pointer-events: none;
      transition: none;
    }
    .tcg-trust-card:hover .tcg-trust-card__shine,
    .tcg-trust-card.is-active .tcg-trust-card__shine {
      left: 200%;
      transition: left 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Icon Box */
    .tcg-trust-icon-box {
      width: 50px;
      height: 50px;
      border-radius: 14px;
      background: rgba(77, 168, 255, 0.08);
      border: 1.5px solid rgba(77, 168, 255, 0.42);
      color: #4DA8FF;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 0 16px rgba(77, 168, 255, 0.12);
    }
    .tcg-trust-card:hover .tcg-trust-icon-box,
    .tcg-trust-card:focus-visible .tcg-trust-icon-box,
    .tcg-trust-card.is-active .tcg-trust-icon-box {
      background: rgba(77, 168, 255, 0.22);
      border-color: #4DA8FF;
      transform: scale(1.12) translateY(-2px);
      box-shadow: 0 0 24px rgba(77, 168, 255, 0.45);
    }

    /* Icon Pop Animation */
    .tcg-trust-card:hover svg,
    .tcg-trust-card:focus-visible svg,
    .tcg-trust-card.is-active svg {
      animation: tcg-icon-pop 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes tcg-icon-pop {
      0% { transform: scale(1); }
      35% { transform: scale(1.28) rotate(-7deg); }
      70% { transform: scale(1.15) rotate(5deg); }
      100% { transform: scale(1.1) rotate(0deg); }
    }

    /* Typography & Enhanced Readability */
    .tcg-trust-heading {
      margin-top: 1.25rem;
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 1.18rem;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: -0.01em;
      transition: color 0.25s ease, transform 0.25s ease;
    }
    .tcg-trust-card:hover .tcg-trust-heading,
    .tcg-trust-card:focus-visible .tcg-trust-heading,
    .tcg-trust-card.is-active .tcg-trust-heading {
      color: #4DA8FF;
      transform: translateX(3px);
    }

    .tcg-trust-body {
      margin-top: 0.55rem;
      font-family: 'Manrope', system-ui, sans-serif;
      font-size: 0.94rem;
      line-height: 1.62;
      color: #d3d8e6;
      letter-spacing: 0.01em;
      transition: color 0.25s ease;
    }
    .tcg-trust-card:hover .tcg-trust-body,
    .tcg-trust-card:focus-visible .tcg-trust-body,
    .tcg-trust-card.is-active .tcg-trust-body {
      color: #FFFFFF;
    }
  </style>

  <script>
    (function initTrustCardTouch() {
      const cards = document.querySelectorAll('.tcg-trust-card');
      cards.forEach((card) => {
        let touchTimer = null;
        card.addEventListener('touchstart', () => {
          card.classList.add('is-active');
        }, { passive: true });

        card.addEventListener('touchend', () => {
          clearTimeout(touchTimer);
          touchTimer = setTimeout(() => {
            card.classList.remove('is-active');
          }, 450);
        }, { passive: true });

        card.addEventListener('touchcancel', () => {
          card.classList.remove('is-active');
        }, { passive: true });
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "TCG Trust",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why collectors trust TCG Hitz" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "camera", "label": "Camera" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" }
        ], "default": "camera" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Two real photos" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Front and back of the exact card you'll receive — never a stock image." }
      ]
    }
  ],
  "presets": [{ "name": "TCG Trust" }]
}
{% endschema %}
