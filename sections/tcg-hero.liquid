{% comment %}
  TCG Hitz — Cinematic hero (1:1 with the hero <section> in tcg-hitz-store/index.html)
{% endcomment %}

{%- liquid
  assign featured = section.settings.featured_product
  assign card_img = 'charizard-stand.jpg' | asset_url
  assign card_link = section.settings.caption_link
  if section.settings.featured_image != blank
    assign card_img = section.settings.featured_image | image_url: width: 800
  elsif featured != blank and featured.featured_image
    assign card_img = featured.featured_image | image_url: width: 800
  endif
  if card_link == blank and featured != blank
    assign card_link = featured.url
  endif
  if card_link == blank
    assign card_link = routes.all_products_collection_url
  endif

  assign has_bg_media = false
  if section.settings.bg_video != blank or section.settings.bg_video_mp4 != blank or section.settings.bg_video_url != blank or section.settings.bg_image != blank
    assign has_bg_media = true
  endif
-%}

<section class="tcg-scope relative {% unless has_bg_media and section.settings.disable_smoke %}smoke{% endunless %} pt-12 pb-10 lg:pt-16 lg:pb-14" style="position: relative; isolation: isolate; overflow: hidden;">
  {%- if has_bg_media -%}
    <!-- Background Media (Image or Video) -->
    <div class="tcg-hero-bg-media" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: -3; overflow: hidden; pointer-events: none;">
      {%- if section.settings.bg_video != blank -%}
        {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'w-full h-full object-cover', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;' }}
      {%- elsif section.settings.bg_video_mp4 != blank -%}
        <video autoplay loop muted playsinline class="w-full h-full object-cover" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
          <source src="{{ section.settings.bg_video_mp4 }}" type="video/mp4">
        </video>
      {%- elsif section.settings.bg_video_url != blank -%}
        {%- if section.settings.bg_video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube.com/embed/{{ section.settings.bg_video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.bg_video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1" style="position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.77vh; transform: translate(-50%, -50%); pointer-events: none; border: 0;" allow="autoplay" frameborder="0"></iframe>
        {%- elsif section.settings.bg_video_url.type == 'vimeo' -%}
          <iframe src="https://player.vimeo.com/video/{{ section.settings.bg_video_url.id }}?autoplay=1&loop=1&muted=1&background=1" style="position: absolute; top: 50%; left: 50%; width: 100vw; height: 56.25vw; min-height: 100%; min-width: 177.77vh; transform: translate(-50%, -50%); pointer-events: none; border: 0;" allow="autoplay" frameborder="0"></iframe>
        {%- endif -%}
      {%- elsif section.settings.bg_image != blank -%}
        <img src="{{ section.settings.bg_image | image_url: width: 2400 }}" alt="{{ section.settings.bg_image.alt | default: section.settings.heading_line1 | escape }}" loading="eager" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;">
      {%- endif -%}
    </div>

    <!-- Solid / Tint Overlay -->
    {%- assign overlay_op = section.settings.overlay_opacity | divided_by: 100.0 -%}
    <div class="tcg-hero-overlay" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; pointer-events: none; background-color: {{ section.settings.overlay_color | default: '#000000' }}; opacity: {{ overlay_op }};"></div>

    <!-- Gradient Overlay -->
    {%- if section.settings.enable_gradient_overlay -%}
      {%- assign grad_op = section.settings.gradient_opacity | divided_by: 100.0 -%}
      {%- assign grad_color = section.settings.gradient_color | default: '#000000' -%}
      <div class="tcg-hero-gradient-overlay" style="
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        pointer-events: none;
        {% if section.settings.gradient_direction == 'radial' %}
          background: radial-gradient(circle at center, transparent 15%, {{ grad_color }} 85%);
        {% else %}
          background: linear-gradient({{ section.settings.gradient_direction | default: 'to bottom' }}, transparent 0%, {{ grad_color }} 100%);
        {% endif %}
        opacity: {{ grad_op }};
      "></div>
    {%- endif -%}
  {%- endif -%}

  <div class="mx-auto max-w-site px-4 sm:px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="stars text-sm">★★★★★ <span class="text-paper-dim font-semibold ml-1">{{ section.settings.stars_text }}</span></p>
        <style>
          @keyframes word-reveal {
            0% { opacity: 0; transform: translateY(20px); filter: blur(4px); }
            100% { opacity: 1; transform: translateY(0); filter: blur(0); }
          }
          .animate-word {
            display: inline-block;
            opacity: 0;
            animation: word-reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
          }
        </style>
        <h1 class="font-display text-[42px] sm:text-6xl lg:text-[68px] leading-[.98] mt-4">
          {%- assign word_idx = 0 -%}
          {%- assign words1 = section.settings.heading_line1 | split: ' ' -%}
          {%- for w in words1 -%}
            <span class="animate-word" style="animation-delay: {{ word_idx | times: 100 }}ms">{{ w }}</span>{% unless forloop.last %} {% endunless %}
            {%- assign word_idx = word_idx | plus: 1 -%}
          {%- endfor -%}
          {%- if section.settings.heading_line2 != blank -%}
          <br>
          {%- assign words2 = section.settings.heading_line2 | split: ' ' -%}
          {%- for w in words2 -%}
            <span class="animate-word" style="animation-delay: {{ word_idx | times: 100 }}ms">{{ w }}</span>{% unless forloop.last %} {% endunless %}
            {%- assign word_idx = word_idx | plus: 1 -%}
          {%- endfor -%}
          {%- endif -%}
        </h1>
        <p class="mt-5 max-w-[46ch] text-paper-dim leading-relaxed">
          {{ section.settings.subheading }}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="{{ section.settings.cta_primary_link | default: routes.all_products_collection_url }}" class="rounded-full bg-gold px-7 py-3.5 font-bold text-ink hover:bg-gold-deep">{{ section.settings.cta_primary_label }}</a>
          <a href="{{ section.settings.cta_secondary_link | default: '#mystery' }}" class="rounded-full border border-gold/45 px-7 py-3.5 font-bold text-gold hover:bg-gold/10">{{ section.settings.cta_secondary_label }}</a>
        </div>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm text-paper-dim">
          <span class="flex items-center gap-2"><span class="text-gold">✦</span> {{ section.settings.perk_1 }}</span>
          <span class="flex items-center gap-2"><span class="text-gold">✦</span> {{ section.settings.perk_2 }}</span>
        </div>
      </div>
      <div class="flex justify-center">
        <figure class="w-[min(78vw,340px)]">
          <div class="holo" data-tilt="14" aria-label="Featured card, move to tilt">
            <div class="holo__card"><img src="{{ card_img }}" alt="{{ section.settings.caption_label | escape }}"><span class="holo__glare"></span><span class="holo__rainbow"></span></div>
          </div>
          <figcaption class="mt-4 text-center text-sm"><a href="{{ card_link }}" class="font-semibold text-gold hover:underline">{{ section.settings.caption_label }}</a></figcaption>
        </figure>
      </div>
    </div>

    <form class="mt-12 max-w-xl mx-auto" role="search" action="{{ routes.search_url }}" method="get">
      <input type="hidden" name="type" value="product">
      <label class="sr-only" for="q">Search</label>
      <div class="relative">
        <input id="q" name="q" type="search" placeholder="{{ section.settings.search_placeholder | escape }}" class="w-full rounded-full bg-felt-2/80 border border-gold/25 pl-12 pr-4 py-3.5 placeholder:text-slate focus:border-gold">
        <svg class="absolute left-4 top-4 h-5 w-5 text-gold/70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
      </div>
    </form>

    {%- if section.blocks.size > 0 -%}
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="brand text-center min-w-[150px]" {{ block.shopify_attributes }}><span class="block font-display text-xl text-gold">{{ block.settings.name }}</span><span class="text-xs text-slate">{{ block.settings.sub }}</span></a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TCG Hero",
  "settings": [
    { "type": "header", "content": "Background Media (Image or Video)" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    { "type": "video", "id": "bg_video", "label": "Shopify-hosted video" },
    { "type": "video_url", "id": "bg_video_url", "label": "Or YouTube / Vimeo URL", "accept": ["youtube", "vimeo"] },
    { "type": "url", "id": "bg_video_mp4", "label": "Or direct MP4 link (from Shopify Files)" },
    { "type": "checkbox", "id": "disable_smoke", "label": "Hide default gold smoke when media is set", "default": true },
    { "type": "header", "content": "Background Overlay" },
    { "type": "color", "id": "overlay_color", "label": "Overlay tint color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay tint opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "header", "content": "Gradient Overlay" },
    { "type": "checkbox", "id": "enable_gradient_overlay", "label": "Enable gradient overlay", "default": true },
    { "type": "select", "id": "gradient_direction", "label": "Gradient direction", "options": [
      { "value": "to bottom", "label": "Top to bottom" },
      { "value": "to top", "label": "Bottom to top" },
      { "value": "to right", "label": "Left to right" },
      { "value": "radial", "label": "Radial vignette" }
    ], "default": "to bottom" },
    { "type": "color", "id": "gradient_color", "label": "Gradient color", "default": "#000000" },
    { "type": "range", "id": "gradient_opacity", "label": "Gradient opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 85 },
    { "type": "header", "content": "Content Settings" },
    { "type": "text", "id": "stars_text", "label": "Stars line", "default": "Trusted at card shows every weekend" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "CHASE" },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "THE RARE" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pokémon singles with real photos of the actual card, sealed boxes, mystery packs, graded slabs — plus our own TCG Hitz vending machines." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button", "default": "SHOP NOW" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button", "default": "MYSTERY PACKS" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Real photos, every single" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Ships in 1 business day" },
    { "type": "header", "content": "Featured card" },
    { "type": "product", "id": "featured_product", "label": "Featured product (uses its image + link)" },
    { "type": "image_picker", "id": "featured_image", "label": "Or a custom image (overrides)" },
    { "type": "text", "id": "caption_label", "label": "Caption", "default": "See this week's chase →" },
    { "type": "url", "id": "caption_link", "label": "Caption link" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search a card, set or number…" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand tile",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Pokémon" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Singles · Sealed · Slabs" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "TCG Hero", "blocks": [
    { "type": "brand", "settings": { "name": "Pokémon", "sub": "Singles · Sealed · Slabs" } },
    { "type": "brand", "settings": { "name": "Magic", "sub": "Coming soon" } },
    { "type": "brand", "settings": { "name": "One Piece", "sub": "Coming soon" } }
  ] }]
}
{% endschema %}
