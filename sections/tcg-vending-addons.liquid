{% comment %}
  TCG Hitz — Vending add-ons showcase (custom wrap, bill acceptor, card reader…).
  Pick the add-on products; price and image come from each product.
{% endcomment %}

{%- assign items = section.settings.addons -%}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
    {%- if section.settings.text != blank -%}<p class="-mt-2 mb-8 text-center text-paper-dim max-w-2xl mx-auto">{{ section.settings.text }}</p>{%- endif -%}
    <div class="grid sm:grid-cols-3 gap-5">
      {%- if items != blank and items.size > 0 -%}
        {%- for a in items -%}
          {%- assign av = a.selected_or_first_available_variant -%}
          <div class="brand flex flex-col">
            {%- if a.featured_image -%}<img src="{{ a.featured_image | image_url: width: 600 }}" alt="{{ a.title | escape }}" width="600" height="400" loading="lazy" class="w-full aspect-[3/2] object-cover rounded-xl">{%- endif -%}
            <h3 class="mt-4 font-display text-xl">{{ a.title }}</h3>
            {%- assign blurb = a.description | strip_html | truncatewords: 22 -%}
            {%- if blurb != blank -%}<p class="mt-1.5 text-sm text-paper-dim leading-relaxed">{{ blurb }}</p>{%- endif -%}
            <p class="mt-auto pt-4 font-bold text-volt">+{{ av.price | money }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign names = 'Custom wrap,Cash bill acceptor,Nayax card reader' | split: ',' -%}
        {%- for n in names -%}
          <div class="brand"><h3 class="font-display text-xl">{{ n }}</h3><p class="mt-1.5 text-sm text-slate">Select your add-on products in this section's settings to show their price and photo.</p></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="mt-6 text-center text-sm text-slate">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TCG Vending Add-ons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make it yours" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Add these when you order your machine." },
    { "type": "product_list", "id": "addons", "label": "Add-on products", "limit": 6 },
    { "type": "text", "id": "note", "label": "Note", "default": "Tick add-ons on any machine's page — they're added to the same order." }
  ],
  "presets": [{ "name": "TCG Vending Add-ons" }]
}
{% endschema %}
