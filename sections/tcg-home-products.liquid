{% comment %}
  TCG Hitz — Homepage product grid (client-approved design).
  Used twice on the homepage: "Featured products / COLLECTOR'S PICKS." and
  "Merch & collectibles / MORE THAN JUST CARDS". Shows a collection, or "Product card" blocks:
  each block can pick a product and/or set its own image, badge, title, text, price and link.
  "Collection" mode shows the collection and falls back to the card blocks while it is empty;
  "Cards only" mode shows just the card blocks.
{% endcomment %}

{%- liquid
  assign coll = section.settings.collection
  assign has_products = false
  if coll != blank and coll.products_count > 0
    assign has_products = true
  endif
  assign glows = 'pink,blue,purple,gold' | split: ','
  if section.settings.padding == 'tight'
    assign pad_class = 'pb-[100px] pt-[20px]'
  else
    assign pad_class = 'py-[100px]'
  endif
  assign view_all = section.settings.btn_link | default: coll.url
  assign card_blocks = section.blocks | where: 'type', 'card'

  assign show_collection = false
  assign show_cards = false
  if section.settings.source == 'cards'
    assign show_cards = true
  elsif has_products
    assign show_collection = true
  elsif section.settings.show_samples
    assign show_cards = true
  endif
-%}

<section class="tcg-scope hz relative">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap flex flex-col items-stretch gap-[56px] {{ pad_class }}">
    <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, heading_class: 'uppercase xl:whitespace-nowrap', text_class: 'xl:whitespace-nowrap' %}
      {% render 'tcg-home-button', label: section.settings.btn_label, link: view_all, kind: 'outline' %}
    </div>

    <div class="grid w-full grid-cols-1 gap-x-[24px] gap-y-[30px] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {%- if show_collection -%}
        {%- for product in coll.products limit: section.settings.limit -%}
          {%- liquid
            assign glow = ''
            if section.settings.show_glow
              assign glow_index = forloop.index0 | modulo: 4
              assign glow = glows[glow_index]
            endif
          -%}
          {% render 'tcg-home-card', product: product, show_desc: section.settings.show_desc, glow: glow %}
        {%- endfor -%}
      {%- endif -%}
      {%- if show_cards -%}
        {%- for block in card_blocks limit: section.settings.limit -%}
          {%- liquid
            assign opts = block.settings
            assign card_fallback = ''
            if opts.fallback != blank and opts.fallback != 'none'
              assign card_fallback = 'home-' | append: opts.fallback | append: '.webp' | asset_url
            endif
            assign glow = opts.glow
            if glow == 'auto' or glow == blank
              assign glow = ''
              if section.settings.show_glow
                assign glow_index = forloop.index0 | modulo: 4
                assign glow = glows[glow_index]
              endif
            elsif glow == 'none'
              assign glow = ''
            endif
            assign card_link = opts.link
            if card_link == blank and opts.product == blank
              assign card_link = view_all
            endif
          -%}
          {% render 'tcg-home-card', product: opts.product, image_override: opts.image, img: card_fallback, title: opts.title, meta: opts.meta, price: opts.price, badge: opts.badge, tone: opts.tone, desc: opts.desc, show_desc: section.settings.show_desc, link: card_link, glow: glow, attrs: block.shopify_attributes %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

