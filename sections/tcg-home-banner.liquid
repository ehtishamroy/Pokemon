{% comment %}
  TCG Hitz — Homepage image banner (client-approved design).
  Used twice: "THE THRILL OF THE UNKNOWN" mystery-packs banner (left, red buttons) and
  "READY TO EXPLORE?" call-to-action banner (centered, blue buttons). Gradient-border frame.
{% endcomment %}

{%- liquid
  assign banner_fallback = 'home-banner-' | append: section.settings.fallback | append: '.webp'
  assign centered = false
  if section.settings.align == 'center'
    assign centered = true
  endif
  if section.settings.buttons == 'red'
    assign kind1 = 'red'
    assign kind2 = 'red-outline'
  else
    assign kind1 = 'solid'
    assign kind2 = 'outline'
  endif
-%}

<section class="tcg-scope hz relative">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap py-[20px]">
    <div class="relative flex w-full flex-col justify-center rounded-[24px] tcg-gb [--bw:2px] px-6 py-16 {% if centered %}items-center md:px-[48px] md:py-[80px]{% else %}items-start md:px-[48px] md:py-[96px] xl:min-h-[506px]{% endif %}">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden rounded-[24px]">
        {% render 'tcg-home-img', image: section.settings.image, mobile: section.settings.image_mobile, fallback: banner_fallback, w: 1600, h: 610, width: 2000, sizes: '(min-width: 1440px) 1280px, 100vw', class: 'absolute inset-0 h-full w-full max-w-none object-cover' %}
        {%- if section.settings.overlay > 0 -%}
          <div class="absolute inset-0" style="background: rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }});"></div>
        {%- endif -%}
      </div>
      <div class="relative flex w-full flex-col gap-[40px] {% if centered %}max-w-[694px] items-center{% else %}max-w-[543px] items-start{% endif %}">
        {%- if centered -%}
          {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, align: 'center', text_class: 'max-w-[428px]' %}
        {%- else -%}
          {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, heading_class: 'max-w-[498px]' %}
        {%- endif -%}
        <div class="flex flex-wrap items-center gap-[18px]{% if centered %} justify-center{% endif %}">
          {% render 'tcg-home-button', label: section.settings.btn1_label, link: section.settings.btn1_link, kind: kind1 %}
          {% render 'tcg-home-button', label: section.settings.btn2_label, link: section.settings.btn2_link, kind: kind2 %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Home — Banner",
  "class": "tcg-home-section",
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "none" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Background image — mobile (optional)", "info": "Shown on phones. Uses the image above when empty." },
    { "type": "select", "id": "fallback", "label": "Design image (used when no image is chosen)", "options": [
      { "value": "mystery", "label": "Mystery packs banner" },
      { "value": "cta", "label": "Call-to-action banner" }
    ], "default": "mystery" },
    { "type": "range", "id": "overlay", "label": "Extra dark overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 0 },
    { "type": "select", "id": "align", "label": "Content alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "select", "id": "buttons", "label": "Button style", "options": [
      { "value": "red", "label": "Red / orange" }, { "value": "blue", "label": "Electric blue" }
    ], "default": "red" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE THRILL OF THE UNKNOWN" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "CHASE YOUR NEXT RARE FIND." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every collection has room for another surprise. Explore TCG HITZ mystery packs and discover your next collectible addition." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "SHOP MYSTERY PACKS" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "EXPLORE ALL COLLECTIBLES" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "TCG Home — Banner" }]
}
{% endschema %}
