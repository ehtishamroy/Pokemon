{% comment %}
  TCG Hitz — Shop All catalog (Figma "Shop All Collection" design).
  Heading → category tabs (blocks; the tab whose link is this collection is highlighted) →
  FILTERS button + SORT BY → product grid (tcg-home-card) → numbered pagination.
  Filters come from Shopify Search & Discovery (collection.filters); sorting uses ?sort_by.
  assets/tcg.js handles: [data-hz-filters-open/-close] (panel on desktop, bottom sheet on mobile),
  [data-hz-fgroup] (accordion groups on mobile) and [data-sort] (reload with sort). Apply button submits.
{% endcomment %}

{%- liquid
  assign per_page = section.settings.products_per_page | default: 12
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign glows = 'pink,blue,purple,gold' | split: ','
  assign active_found = false
-%}

<section class="tcg-scope hz relative" id="products">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap flex flex-col items-stretch pb-[28px] pt-[36px] md:pb-[40px] md:pt-[64px] xl:pt-[90px]">

    {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, heading_class: 'uppercase' %}

    {%- if section.settings.show_tabs and tab_blocks.size > 0 -%}
      <div class="hz-rail mt-[28px] flex gap-[16px] pb-[6px] md:mt-[50px] md:grid md:grid-cols-3 md:pb-0 xl:grid-cols-5" role="navigation" aria-label="Product categories">
        {%- for block in tab_blocks -%}
          {%- liquid
            assign tab_link = block.settings.link | default: routes.all_products_collection_url
            assign tab_active = false
            if tab_link == collection.url and active_found == false
              assign tab_active = true
              assign active_found = true
            endif
            if block.settings.icon_image != blank
              assign tab_icon = block.settings.icon_image | image_url: width: 80
            else
              assign tab_icon = 'home-shop-tab-' | append: block.settings.icon | append: '.svg' | asset_url
            endif
          -%}
          <a href="{{ tab_link }}" data-hz-reveal class="hz-tab tcg-gb [--bw:1px]{% if tab_active %} hz-tab--active{% endif %} flex min-h-[56px] min-w-[190px] shrink-0 items-center justify-center gap-[12px] rounded-[12px] px-[18px] py-[8px] text-[15px] font-semibold uppercase leading-[1.3] text-white md:min-w-0" {% if tab_active %}aria-current="page"{% endif %} {{ block.shopify_attributes }}>
            <img src="{{ tab_icon }}" alt="" width="24" height="24" loading="lazy" class="hz-tab__icon size-[24px] shrink-0 object-contain">
            <span>{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="mb-[16px] mt-[28px] flex items-center justify-between gap-[12px] md:mb-[20px] md:mt-[58px]">
      <button type="button" data-hz-filters-open class="hz-filter-btn flex items-center gap-[10px] text-[17px] font-medium uppercase text-white md:text-[18px]" aria-controls="hz-filters" aria-expanded="false">
        <img src="{{ 'home-icon-filter.svg' | asset_url }}" alt="" width="24" height="24" class="size-[24px]">
        <span>{{ section.settings.filters_label }}</span>
        {%- if active_count > 0 -%}<span class="hz-count">{{ active_count }}</span>{%- endif -%}
      </button>
      {%- if collection.sort_options.size > 0 -%}
        <label class="flex min-w-0 items-center gap-[8px] text-[13px] uppercase text-hz-cool md:gap-[12px]">
          <span>{{ section.settings.sort_label }}</span>
          <select data-sort aria-label="{{ section.settings.sort_label | escape }}" class="hz-select min-w-0 max-w-[170px] cursor-pointer rounded-[8px] bg-hz-card py-[10px] pl-[12px] pr-[32px] text-[14px] normal-case text-white md:max-w-none md:pl-[15px] md:pr-[36px]">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
    </div>

    {%- comment -%} Active filters as removable chips {%- endcomment -%}
    {%- if active_count > 0 -%}
      <div class="mb-[20px] flex flex-wrap items-center gap-[8px] md:mb-[24px]">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="hz-chip" aria-label="Remove filter {{ value.label | escape }}"><span>{{ value.label }}</span><svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></a>
          {%- endfor -%}
        {%- endfor -%}
        <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}" class="hz-ulink ml-[4px] text-[13px] text-hz-cool hover:text-white">{{ section.settings.clear_all_label }}</a>
      </div>
    {%- endif -%}

    {%- comment -%}
      Filter panel. Desktop: an inline panel with one card per filter. Mobile/tablet: a bottom sheet
      (backdrop, sticky Apply bar) with collapsible groups. Opened/closed by assets/tcg.js (data-hz-filters-*).
    {%- endcomment -%}
    <div id="hz-filters" data-hz-filters class="hidden max-lg:fixed max-lg:inset-0 max-lg:z-[70]" role="dialog" aria-label="{{ section.settings.filter_panel_title | escape }}">
      <div data-hz-filters-close class="hz-backdrop absolute inset-0 bg-black/70 backdrop-blur-sm lg:hidden"></div>
      <div class="hz-panel tcg-gb bg-hz-card max-lg:absolute max-lg:inset-x-0 max-lg:bottom-0 max-lg:top-[7vh] max-lg:flex max-lg:flex-col max-lg:rounded-b-none max-lg:rounded-t-[24px] lg:mb-[28px] lg:rounded-[20px]">
        <div class="flex shrink-0 items-center justify-between gap-[12px] border-b border-solid border-white/10 px-[20px] py-[16px] lg:px-[28px] lg:py-[20px]">
          <div class="flex items-center gap-[10px]">
            <strong class="font-display text-[22px] uppercase leading-none text-white">{{ section.settings.filter_panel_title }}</strong>
            {%- if active_count > 0 -%}<span class="hz-count">{{ active_count }}</span>{%- endif -%}
          </div>
          <div class="flex items-center gap-[14px]">
            {%- if active_count > 0 -%}
              <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}" class="hz-ulink text-[14px] text-hz-cool hover:text-white">{{ section.settings.clear_all_label }}</a>
            {%- endif -%}
            <button type="button" data-hz-filters-close class="hz-icon-btn" aria-label="Close filters"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
          </div>
        </div>

        {%- if collection.filters.size > 0 -%}
          <form data-hz-filter-form method="get" action="{{ collection.url }}" class="flex min-h-0 flex-1 flex-col">
            <input type="hidden" name="sort_by" value="{{ sort_by }}">
            <div class="hz-scroll min-h-0 flex-1 overflow-y-auto px-[20px] py-[18px] lg:overflow-visible lg:px-[28px] lg:py-[24px]">
              <div class="grid grid-cols-1 items-start gap-[12px] sm:grid-cols-2 lg:grid-cols-3 lg:gap-[18px] xl:grid-cols-4">
                {%- for filter in collection.filters -%}
                  <details class="hz-fgroup" open data-hz-fgroup{% if filter.active_values.size > 0 %} data-active{% endif %}>
                    <summary class="hz-fgroup__sum">
                      <span class="hz-fgroup__title">{{ filter.label }}</span>
                      {%- if filter.active_values.size > 0 -%}<span class="hz-count">{{ filter.active_values.size }}</span>{%- endif -%}
                      <svg class="hz-fgroup__chev" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </summary>
                    <div class="hz-fgroup__body">
                      {%- if filter.type == 'price_range' -%}
                        {%- assign max_val = filter.range_max | money_without_currency | replace: ',', '' -%}
                        <div class="grid grid-cols-2 gap-[10px]">
                          <label class="hz-money">
                            <span aria-hidden="true">$</span>
                            <span class="sr-only">Minimum price</span>
                            <input name="{{ filter.min_value.param_name }}" type="number" inputmode="decimal" min="0" max="{{ max_val }}" placeholder="Min"{% if filter.min_value.value %} value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                          </label>
                          <label class="hz-money">
                            <span aria-hidden="true">$</span>
                            <span class="sr-only">Maximum price</span>
                            <input name="{{ filter.max_value.param_name }}" type="number" inputmode="decimal" min="0" max="{{ max_val }}" placeholder="Max"{% if filter.max_value.value %} value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                          </label>
                        </div>
                        <p class="mt-[10px] text-[13px] text-hz-cool">Highest price: {{ filter.range_max | money }}</p>
                      {%- else -%}
                        <div class="hz-flist{% if filter.values.size > 7 %} hz-flist--scroll{% endif %}">
                          {%- for value in filter.values -%}
                            <label class="hz-frow{% if value.count == 0 and value.active == false %} hz-frow--off{% endif %}">
                              <input type="checkbox" class="hz-check" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                              <span class="hz-frow__label">{{ value.label }}</span>
                              <span class="hz-frow__count">{{ value.count }}</span>
                            </label>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </details>
                {%- endfor -%}
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-[14px] border-t border-solid border-white/10 bg-hz-card px-[20px] py-[14px] max-lg:pb-[calc(14px+env(safe-area-inset-bottom))] lg:px-[28px] lg:py-[18px]">
              <button type="submit" class="hz-btn h-[44px] max-lg:flex-1 px-[22px] text-[13px]"><span>{{ section.settings.apply_label }}</span></button>
              <a href="{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}" class="hz-ulink text-[14px] text-hz-cool hover:text-white">{{ section.settings.clear_label }}</a>
            </div>
          </form>
        {%- else -%}
          <div class="px-[20px] py-[28px] lg:px-[28px]">
            <p class="text-[14px] text-hz-cool">Add filters in Shopify's <strong class="text-white">Search &amp; Discovery</strong> app and they will show up here.</p>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- paginate collection.products by per_page -%}
      <div class="grid w-full grid-cols-1 gap-x-[24px] gap-y-[24px] sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {%- for product in collection.products -%}
          {%- liquid
            assign glow = ''
            if section.settings.show_glow
              assign glow_index = forloop.index0 | modulo: 4
              assign glow = glows[glow_index]
            endif
          -%}
          {% render 'tcg-home-card', product: product, glow: glow %}
        {%- else -%}
          <div class="relative col-span-full rounded-[20px] tcg-gb bg-hz-card p-[48px] text-center">
            <p class="font-display text-[24px] text-white">{{ section.settings.empty_title }}</p>
            <p class="mt-[8px] text-[15px] text-hz-cool">{{ section.settings.empty_text }}</p>
            <div class="mt-[24px] flex justify-center">
              <a href="{{ collection.url }}" class="hz-btn"><span>{{ section.settings.clear_label }}</span></a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="flex flex-wrap items-center justify-center gap-[8px] pb-[8px] pt-[36px] md:pt-[42px]" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="hz-page" aria-label="Previous page"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="hz-page" aria-label="Page {{ part.title }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="hz-page hz-page--active" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="px-[4px] text-hz-cool">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="hz-page" aria-label="Next page"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "TCG Shop — Catalog",
  "class": "tcg-home-section",
  "enabled_on": { "templates": ["collection"] },
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "left-purple" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXPLORE THE COLLECTION" },
    { "type": "text", "id": "text", "label": "Text", "default": "Find the cards and collectibles you're looking for." },
    { "type": "checkbox", "id": "show_tabs", "label": "Show category tabs", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "checkbox", "id": "show_glow", "label": "Colour glow behind product images", "default": false },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "filters_label", "label": "Filters button", "default": "FILTERS" },
    { "type": "text", "id": "sort_label", "label": "Sort label", "default": "SORT BY" },
    { "type": "text", "id": "filter_panel_title", "label": "Filter panel title", "default": "FILTER" },
    { "type": "text", "id": "apply_label", "label": "Apply button", "default": "APPLY FILTERS" },
    { "type": "text", "id": "clear_label", "label": "Clear filters link / button", "default": "Clear filters" },
    { "type": "text", "id": "clear_all_label", "label": "Clear all link", "default": "Clear all" },
    { "type": "text", "id": "empty_title", "label": "No-results title", "default": "No products found" },
    { "type": "text", "id": "empty_text", "label": "No-results text", "default": "Try adjusting your filters or search." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "ALL PRODUCTS" },
        { "type": "url", "id": "link", "label": "Link", "info": "The tab that links to the collection being viewed is highlighted." },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "all", "label": "All products" },
          { "value": "pokemon", "label": "Pokémon cards" },
          { "value": "mystery", "label": "Mystery packs" },
          { "value": "graded", "label": "Graded cards" },
          { "value": "merch", "label": "Merchandise" }
        ], "default": "all" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "TCG Shop — Catalog",
    "blocks": [
      { "type": "tab", "settings": { "label": "ALL PRODUCTS", "icon": "all" } },
      { "type": "tab", "settings": { "label": "POKÉMON CARDS", "icon": "pokemon" } },
      { "type": "tab", "settings": { "label": "MYSTERY PACKS", "icon": "mystery" } },
      { "type": "tab", "settings": { "label": "GRADED CARDS", "icon": "graded" } },
      { "type": "tab", "settings": { "label": "MERCHANDISE", "icon": "merch" } }
    ]
  }]
}
{% endschema %}
