{% comment %}
  TCG Hitz — Merchandise grid (1:1 with index.html "MERCHANDISE")
{% endcomment %}

{%- assign col = section.settings.collection -%}

<section id="merch" class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <p class="text-center text-paper-dim mt-3">{{ section.settings.subheading }}</p>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.products_to_show -%}
          {% render 'tcg-cell', product: product, style: 'link' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Merchandise",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Merchandise" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our own 3D prints, plus plushies, figures and collectibles." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "TCG Merchandise" }]
}
{% endschema %}
