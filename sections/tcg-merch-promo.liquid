{% comment %}
  TCG Hitz — Merchandise Section
  Matches index.html lines 219-232
{% endcomment %}

{% liquid
  assign col = collections[section.settings.collection]
%}

<section id="merch" class="py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <p class="text-center text-paper-dim mt-3">{{ section.settings.subheading }}</p>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
      {% if col != blank %}
        {% for product in col.products limit: 4 %}
          <a href="{{ product.url }}" class="cell w-full">
            <span class="block cell__img">
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}">
            </span>
            <h3 class="mt-3 font-bold text-sm">{{ product.title }}</h3>
            {% if product.metafields.custom.card_set != blank %}
              <p class="text-xs text-slate">{{ product.metafields.custom.card_set }}</p>
            {% endif %}
            <p class="mt-1 font-bold text-gold">{{ product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <a href="#" class="cell w-full">
            <span class="block cell__img">
              <img src="{{ 'card-back.svg' | asset_url }}" alt="Placeholder">
            </span>
            <h3 class="mt-3 font-bold text-sm">Example Merch</h3>
            <p class="text-xs text-slate">Brand · Type</p>
            <p class="mt-1 font-bold text-gold">$0.00</p>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Merchandise",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Merchandise"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our own 3D prints, plus plushies, figures and collectibles."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    }
  ],
  "presets": [
    {
      "name": "TCG Merchandise"
    }
  ]
}
{% endschema %}
