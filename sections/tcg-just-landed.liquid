{% comment %}
  TCG Hitz — Just Landed grid (1:1 with index.html "JUST LANDED")
{% endcomment %}

{%- assign col = section.settings.collection -%}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-5">
      {%- if col != blank -%}
        {%- for product in col.products limit: section.settings.products_to_show -%}
          {% render 'tcg-cell', product: product, style: 'compact' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    <div class="text-center mt-8"><a href="{{ section.settings.view_all_link | default: col.url | default: routes.all_products_collection_url }}" class="inline-flex rounded-full border border-gold/45 px-7 py-3 font-bold text-gold hover:bg-gold hover:text-ink">{{ section.settings.view_all_label }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Just Landed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just Landed ✈" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 18, "step": 1, "default": 6 },
    { "type": "text", "id": "view_all_label", "label": "Button", "default": "LOAD MORE ARRIVALS" },
    { "type": "url", "id": "view_all_link", "label": "Button link" }
  ],
  "presets": [{ "name": "TCG Just Landed" }]
}
{% endschema %}
