{% comment %}
  TCG Hitz — Just Landed (New Arrivals)
  Matches index.html lines 202-217
{% endcomment %}

{% liquid
  assign col = collections[section.settings.collection]
%}

<section class="py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-5">
      {% if col != blank %}
        {% for product in col.products limit: section.settings.products_to_show %}
          <a href="{{ product.url }}" class="cell w-full">
            <span class="block cell__img">
              <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}">
            </span>
            <h3 class="mt-2 text-xs font-bold leading-tight">{{ product.title }}</h3>
            <p class="text-xs text-gold font-bold">{{ product.price | money }}</p>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <a href="#" class="cell w-full">
            <span class="block cell__img">
              <img src="{{ 'card-back.svg' | asset_url }}" alt="Placeholder">
            </span>
            <h3 class="mt-2 text-xs font-bold leading-tight">Example Card</h3>
            <p class="text-xs text-gold font-bold">$0.00</p>
          </a>
        {% endfor %}
      {% endif %}
    </div>
    <div class="text-center mt-8">
      <a href="{{ col.url | default: '/collections/all' }}" class="inline-flex rounded-full border border-gold/45 px-7 py-3 font-bold text-gold hover:bg-gold hover:text-ink">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Just Landed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Just Landed ✈"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 6,
      "max": 18,
      "step": 6,
      "default": 12
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "LOAD MORE ARRIVALS"
    }
  ],
  "presets": [
    {
      "name": "TCG Just Landed"
    }
  ]
}
{% endschema %}
