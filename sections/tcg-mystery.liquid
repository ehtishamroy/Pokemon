    { "type": "textarea", "id": "body", "label": "Body", "default": "Hand-built packs with a real shot at a hit — every one guarantees value, and the top tiers drop graded slabs and alt arts. The same thrill as our machines, shipped to your door." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop mystery" },
