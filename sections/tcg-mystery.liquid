{% comment %}
  TCG Hitz — Mystery Feature Section
  Matches index.html lines 152–169
{% endcomment %}

<section id="mystery" class="py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="cabinet bg-ink p-7 sm:p-10 grid lg:grid-cols-2 gap-8 items-center">
      <div>
        <p class="text-gold font-bold text-sm tracking-widest">TCG HITZ EXCLUSIVE</p>
        <h2 class="font-display text-3xl sm:text-4xl mt-2 leading-tight">{{ section.settings.heading }}</h2>
        <p class="mt-4 text-paper-dim leading-relaxed max-w-[48ch]">{{ section.settings.body }}</p>
        <a href="{{ section.settings.cta_link }}" class="mt-6 inline-flex rounded-full bg-gold px-6 py-3 font-bold text-ink hover:bg-gold-deep">{{ section.settings.cta_label }}</a>
      </div>
      <div class="grid grid-cols-3 gap-3">
        {%- for block in section.blocks -%}
          <div class="cat rounded-card bg-felt-2 p-5 text-center" {{ block.shopify_attributes }}>
            <p class="font-bold text-sm">{{ block.settings.name }}</p>
            <p class="text-gold font-bold mt-1">{{ block.settings.price }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Mystery Feature",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mystery packs & boxes" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Hand-built packs with a real shot at a hit — every one guarantees value, and the top tiers drop graded slabs and alt arts. The same thrill as our machines, shipped to your door." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop mystery" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Mystery Pack" },
        { "type": "text", "id": "price", "label": "Price", "default": "$19.99" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{
    "name": "TCG Mystery Feature",
    "blocks": [
      { "type": "tier", "settings": { "name": "Mystery Pack", "price": "$19.99" } },
      { "type": "tier", "settings": { "name": "Mystery Box", "price": "$74.99" } },
      { "type": "tier", "settings": { "name": "Mystery Slab", "price": "$49.99" } }
    ]
  }]
}
{% endschema %}
