{% comment %}
  TCG Hitz — Vending machines for sale: grid of machines from a collection.
  Each card links to the machine's own page (product template "vending").
{% endcomment %}

{%- assign coll = section.settings.collection -%}

<section class="tcg-scope py-12 lg:py-16" id="{{ section.settings.anchor | default: 'machines' }}">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
    {%- if section.settings.text != blank -%}<p class="-mt-2 mb-8 text-center text-paper-dim max-w-2xl mx-auto">{{ section.settings.text }}</p>{%- endif -%}

    {%- if coll != blank and coll.products_count > 0 -%}
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {%- for p in coll.products limit: section.settings.limit -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- assign key_spec = p.metafields.custom.capacity.value | default: p.metafields.custom.capacity | default: p.metafields.custom.display_size.value | default: p.metafields.custom.display_size -%}
          <a href="{{ p.url }}" class="cat cabinet bg-ink overflow-hidden flex flex-col group">
            <div class="relative aspect-[4/5] bg-felt-2/50 overflow-hidden">
              {%- if p.featured_image -%}
                <img src="{{ p.featured_image | image_url: width: 800 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="800" height="1000" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition duration-300 group-hover:scale-[1.04]">
              {%- else -%}
                <div class="absolute inset-0 grid place-items-center text-slate">{{ 'product-1' | placeholder_svg_tag: 'w-2/3 h-2/3 opacity-30' }}</div>
              {%- endif -%}
              {%- if v.compare_at_price > v.price -%}<span class="absolute top-3 left-3 rounded-full bg-fire px-3 py-1 text-xs font-bold text-white">SALE</span>{%- endif -%}
            </div>
            <div class="p-5 flex flex-col flex-1">
              <h3 class="font-display text-xl leading-tight">{{ p.title }}</h3>
              {%- if key_spec != blank -%}<p class="mt-1 text-sm text-slate">{{ key_spec }}</p>{%- endif -%}
              <div class="mt-auto pt-4 flex items-end justify-between gap-3">
                <span>
                  <span class="block font-display text-2xl text-volt leading-none">{{ v.price | money }}</span>
                  {%- if v.compare_at_price > v.price -%}<span class="text-sm text-slate line-through">{{ v.compare_at_price | money }}</span>{%- endif -%}
                </span>
                <span class="rounded-full bg-fire px-4 py-2.5 text-sm font-bold text-white">View machine</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {%- for i in (1..3) -%}
          <div class="cabinet bg-ink overflow-hidden">
            <div class="aspect-[4/5] grid place-items-center bg-felt-2/50 text-slate">{{ 'product-1' | placeholder_svg_tag: 'w-2/3 h-2/3 opacity-30' }}</div>
            <div class="p-5"><p class="font-display text-xl">Machine name</p><p class="mt-1 text-sm text-slate">Choose the vending machines collection in this section's settings.</p></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "TCG Vending Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your machine" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every machine is built to order and ships free. Open a machine to see its specs, add-ons and profit estimate." },
    { "type": "collection", "id": "collection", "label": "Machines collection" },
    { "type": "range", "id": "limit", "label": "Machines to show", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "anchor", "label": "Anchor id (for 'Shop machines' button)", "default": "machines" }
  ],
  "presets": [{ "name": "TCG Vending Grid" }]
}
{% endschema %}
