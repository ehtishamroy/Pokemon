{% comment %}
  TCG Hitz — Vending Machine Feature
  Matches index.html lines 171-187
{% endcomment %}

<section class="py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="cabinet bg-ink overflow-hidden grid lg:grid-cols-2">
      <div class="relative min-h-[300px] lg:min-h-[440px]">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="Vending Machine" class="absolute inset-0 w-full h-full object-cover">
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover' }}
        {% endif %}
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-ink/85 lg:to-ink"></div>
      </div>
      <div class="p-8 lg:p-12 flex flex-col justify-center">
        <p class="text-gold font-bold text-sm tracking-widest">OUR OWN MACHINES</p>
        <h2 class="font-display text-3xl sm:text-4xl mt-2 leading-tight">{{ section.settings.heading }}</h2>
        <p class="mt-4 text-paper-dim leading-relaxed max-w-[46ch]">{{ section.settings.text }}</p>
        <a href="{{ section.settings.button_link | default: '/pages/vending-machines' }}" class="mt-7 inline-flex w-fit rounded-full bg-gold px-6 py-3.5 font-bold text-ink hover:bg-gold-deep">
          {{ section.settings.button_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Vending Feature",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pokémon card vending machines"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "The machines you've seen at the shows — now available for your shop, event or arcade. Custom TCG Hitz wrap, Pokémon · Magic · One Piece, built to draw a crowd."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore the machines"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "TCG Vending Feature"
    }
  ]
}
{% endschema %}
