{% comment %}
  TCG Hitz — Vending machines feature (1:1 with index.html "VENDING MACHINES FEATURE")
{% endcomment %}

{%- liquid
  if section.settings.image != blank
    assign img = section.settings.image | image_url: width: 1400
  else
    assign img = 'machine-graffiti.jpg' | asset_url
  endif
-%}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="cabinet bg-ink overflow-hidden grid lg:grid-cols-2">
      <div class="relative min-h-[300px] lg:min-h-[440px]">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'absolute inset-0 w-full h-full object-cover' }}
        {%- else -%}
          <img src="{{ img }}" alt="{{ section.settings.heading | escape }}" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
        {%- endif -%}
        <div class="absolute inset-0 bg-gradient-to-r from-transparent to-ink/85 lg:to-ink pointer-events-none"></div>
      </div>
      <div class="p-8 lg:p-12 flex flex-col justify-center">
        <p class="text-gold font-bold text-sm tracking-widest">{{ section.settings.eyebrow }}</p>
        <h2 class="font-display text-3xl sm:text-4xl mt-2 leading-tight">{{ section.settings.heading }}</h2>
        <p class="mt-4 text-paper-dim leading-relaxed max-w-[46ch]">{{ section.settings.body }}</p>
        <a href="{{ section.settings.cta_link | default: '/pages/vending-machines' }}" class="mt-7 inline-flex w-fit rounded-full bg-gold px-6 py-3.5 font-bold text-ink hover:bg-gold-deep">{{ section.settings.cta_label }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Vending Feature",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to machine-graffiti.jpg)" },
    { "type": "video", "id": "video", "label": "Or Video (overrides image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR OWN MACHINES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pokémon card vending machines" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "The machines you've seen at the shows — now available for your shop, event or arcade. Custom TCG Hitz wrap, Pokémon · Magic · One Piece, built to draw a crowd." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Explore the machines" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "TCG Vending Feature" }]
}
{% endschema %}
