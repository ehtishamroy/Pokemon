{% comment %}
  TCG Hitz — Contact page "HOW CAN WE HELP?" + message form (Figma "Contact Us" design).
  Left: heading, text, contact info (phone, email, address) and social buttons.
  Right: "SEND US A MESSAGE." form — Shopify's contact form, so messages arrive by email and under
  Customers → Contact. The "What can we help you with?" choices are an editable list (one per line).
  Social buttons only show for the links you fill in.
{% endcomment %}

{%- liquid
  assign topics = section.settings.topics | strip | newline_to_br | split: '<br />'
  assign phone_href = section.settings.phone | replace: ' ', '' | replace: '-', ''
  assign privacy_url = section.settings.privacy_link | default: '/policies/privacy-policy'
-%}

<section class="tcg-scope hz relative" id="{{ section.settings.anchor | default: 'contact-form' }}">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap grid items-start gap-[32px] pb-[36px] pt-[36px] md:gap-[44px] md:pb-[72px] md:pt-[56px] xl:grid-cols-2 xl:gap-[64px] xl:pb-[100px] xl:pt-[72px]">

    <div class="flex flex-col gap-[32px] md:gap-[40px]">
      <div data-hz-reveal>
        {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, heading_class: 'max-w-[460px]', text_class: 'max-w-[520px]' %}
      </div>

      <div data-hz-reveal class="flex flex-col gap-[20px]">
        <h3 class="font-display text-[19px] uppercase leading-[1.2] text-white">{{ section.settings.info_title }}</h3>
        <ul class="flex flex-col gap-[16px]">
          {%- if section.settings.phone != blank -%}
            <li><a href="tel:{{ phone_href }}" class="hz-contact-row"><span class="hz-contact-ic">{% render 'tcg-sell-icon', name: 'phone', size: 20 %}</span><span class="flex flex-col gap-[2px]"><span class="hz-contact-lbl">{{ section.settings.phone_label }}</span><span class="text-[16px] leading-[1.4] text-white">{{ section.settings.phone }}</span></span></a></li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li><a href="mailto:{{ section.settings.email }}" class="hz-contact-row"><span class="hz-contact-ic">{% render 'tcg-sell-icon', name: 'mail', size: 20 %}</span><span class="flex flex-col gap-[2px]"><span class="hz-contact-lbl">{{ section.settings.email_label }}</span><span class="text-[16px] leading-[1.4] text-white">{{ section.settings.email }}</span></span></a></li>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <li><div class="hz-contact-row"><span class="hz-contact-ic">{% render 'tcg-sell-icon', name: 'pin', size: 20 %}</span><span class="flex flex-col gap-[2px]"><span class="hz-contact-lbl">{{ section.settings.address_label }}</span><span class="text-[16px] leading-[1.4] text-white">{{ section.settings.address }}</span></span></div></li>
          {%- endif -%}
        </ul>
      </div>

      {%- if section.settings.facebook != blank or section.settings.x != blank or section.settings.instagram != blank or section.settings.linkedin != blank -%}
        <div data-hz-reveal class="flex flex-col gap-[16px]">
          <h3 class="font-display text-[19px] uppercase leading-[1.2] text-white">{{ section.settings.follow_title }}</h3>
          <div class="flex flex-wrap items-center gap-[10px]">
            {%- if section.settings.facebook != blank -%}
              <a href="{{ section.settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="hz-social relative flex size-[40px] items-center justify-center rounded-full tcg-gb [--bw:1.111px] bg-white/[0.12] transition hover:bg-hz-electric/40"><svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.33-.04-1.56-.14-2.86-.14C11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5z"/></svg></a>
            {%- endif -%}
            {%- if section.settings.x != blank -%}
              <a href="{{ section.settings.x }}" target="_blank" rel="noopener" aria-label="X (Twitter)" class="hz-social relative flex size-[40px] items-center justify-center rounded-full tcg-gb [--bw:1.111px] bg-white/[0.12] transition hover:bg-hz-electric/40"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z"/></svg></a>
            {%- endif -%}
            {%- if section.settings.instagram != blank -%}
              <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="hz-social relative flex size-[40px] items-center justify-center rounded-full tcg-gb [--bw:1.111px] bg-white/[0.12] transition hover:bg-hz-electric/40"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1" fill="#fff" stroke="none"/></svg></a>
            {%- endif -%}
            {%- if section.settings.linkedin != blank -%}
              <a href="{{ section.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="hz-social relative flex size-[40px] items-center justify-center rounded-full tcg-gb [--bw:1.111px] bg-white/[0.12] transition hover:bg-hz-electric/40"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div data-hz-reveal class="relative rounded-[20px] tcg-gb [--bw:1.5px] bg-hz-card/90 p-[22px] md:p-[36px]">
      {%- form 'contact', id: 'tcg-contact-form', class: 'flex flex-col gap-[20px]' -%}
        {%- if form.posted_successfully? -%}
          <div class="flex flex-col items-center gap-[14px] py-[48px] text-center" role="status">
            <span class="hz-bigicon hz-bigicon--blue">{% render 'tcg-sell-icon', name: 'check', size: 34 %}</span>
            <h3 class="font-display text-[26px] uppercase leading-[1.15] text-white">{{ section.settings.success_title }}</h3>
            <p class="max-w-[420px] text-[16px] leading-[1.5] text-white/90">{{ section.settings.success_text }}</p>
          </div>
        {%- else -%}
          <div class="flex flex-col gap-[8px]">
            <h2 class="font-display text-[26px] uppercase leading-[1.15] text-white md:text-[30px]">{{ section.settings.form_title }}</h2>
            {%- if section.settings.form_text != blank -%}<p class="text-[14px] leading-[1.5] text-white/90">{{ section.settings.form_text }}</p>{%- endif -%}
          </div>
          {%- if form.errors -%}<p class="rounded-[10px] border border-solid border-hz-crimson/60 bg-hz-crimson/10 px-[14px] py-[10px] text-[14px] text-white" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}

          <div class="grid gap-[20px] sm:grid-cols-2">
            <div class="hz-fld"><label for="ct-name">Full name <b>*</b></label><input class="hz-field" id="ct-name" name="contact[Name]" type="text" required autocomplete="name" placeholder="Enter your full name ..." value="{{ form.name }}"></div>
            <div class="hz-fld"><label for="ct-email">Email address <b>*</b></label><input class="hz-field" id="ct-email" name="contact[email]" type="email" required autocomplete="email" placeholder="Enter your email address ..." value="{{ form.email }}"></div>
          </div>
          <div class="grid gap-[20px] sm:grid-cols-2">
            <div class="hz-fld"><label for="ct-order">Order number <span class="normal-case tracking-normal text-hz-cool">(Optional)</span></label><input class="hz-field" id="ct-order" name="contact[Order number]" type="text" placeholder="If applicable ..."></div>
            <div class="hz-fld"><label for="ct-topic">What can we help you with? <b>*</b></label>
              <select class="hz-field hz-field--select" id="ct-topic" name="contact[Inquiry type]" required>
                <option value="" disabled selected>{{ section.settings.topic_placeholder }}</option>
                {%- for opt in topics -%}{%- assign o = opt | strip -%}{%- if o != blank -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endif -%}{%- endfor -%}
              </select></div>
          </div>
          <div class="hz-fld"><label for="ct-subject">Subject</label><input class="hz-field" id="ct-subject" name="contact[Subject]" type="text" placeholder="Briefly describe your question ..."></div>
          <div class="hz-fld"><label for="ct-body">Message <b>*</b></label><textarea class="hz-field" id="ct-body" name="contact[body]" rows="5" required placeholder="Tell us how we can help ...">{{ form.body }}</textarea></div>

          <div class="flex flex-col items-start gap-[16px] pt-[4px]">
            <button type="submit" class="hz-btn"><span>{{ section.settings.submit_label }}</span>{% render 'tcg-home-arrow' %}</button>
            <p class="text-[13px] leading-[1.5] text-hz-cool">{{ section.settings.disclaimer }} <a href="{{ privacy_url }}" class="text-hz-neon underline underline-offset-2 hover:text-hz-lightning">{{ section.settings.privacy_label }}</a>.</p>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Contact — Form",
  "class": "tcg-home-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "left-blue", "label": "Blue, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-pink", "label": "Pink, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "left-blue" },
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "contact-form" },
    { "type": "header", "content": "Left side" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "GET IN TOUCH" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HOW CAN WE HELP?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Whether you're exploring our latest collectibles or need assistance with an existing order, we're here to help you find the information you need." },
    { "type": "text", "id": "info_title", "label": "Contact info title", "default": "CONTACT INFO" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "PHONE NO." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 208-620-7749" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "EMAIL" },
    { "type": "text", "id": "email", "label": "Email", "default": "admin@tcghitz.com" },
    { "type": "text", "id": "address_label", "label": "Address label", "default": "ADDRESS" },
    { "type": "text", "id": "address", "label": "Address", "default": "Skate Plaza in Coeur d’Alene, Idaho" },
    { "type": "text", "id": "follow_title", "label": "Social title", "default": "FOLLOW US" },
    { "type": "url", "id": "facebook", "label": "Facebook link" },
    { "type": "url", "id": "x", "label": "X (Twitter) link" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    { "type": "url", "id": "linkedin", "label": "LinkedIn link" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_title", "label": "Form title", "default": "SEND US A MESSAGE." },
    { "type": "text", "id": "form_text", "label": "Form text", "default": "Fill out the form below, and we'll direct your inquiry to the appropriate team." },
    { "type": "text", "id": "topic_placeholder", "label": "Dropdown placeholder", "default": "Select an inquiry type" },
    { "type": "textarea", "id": "topics", "label": "Dropdown choices (one per line)", "default": "Product question\nOrder support\nShipping & delivery\nReturns & refunds\nVending machine inquiry\nSelling to us\nSomething else" },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "SEND MESSAGE" },
    { "type": "text", "id": "disclaimer", "label": "Note under the button", "default": "Please check your details before submitting your inquiry. Your information will be handled in accordance with our" },
    { "type": "text", "id": "privacy_label", "label": "Privacy link text", "default": "Privacy Policy" },
    { "type": "url", "id": "privacy_link", "label": "Privacy link", "info": "Empty = /policies/privacy-policy" },
    { "type": "text", "id": "success_title", "label": "Thank-you title", "default": "MESSAGE SENT!" },
    { "type": "textarea", "id": "success_text", "label": "Thank-you text", "default": "Thanks for reaching out. Our team will review your message and get back to you soon." }
  ],
  "presets": [{ "name": "TCG Contact — Form" }]
}
{% endschema %}
