{% comment %}
  TCG Hitz — Bestsellers Carousel
  Matches index.html lines 106–136
{% endcomment %}

{% liquid
  assign col = collections[section.settings.collection]
%}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="carousel">
      <button class="arrow prev" aria-label="Scroll left">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m15 6-6 6 6 6"/></svg>
      </button>
      <button class="arrow next" aria-label="Scroll right">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m9 6 6 6-6 6"/></svg>
      </button>
      <div class="rail flex gap-5 overflow-x-auto pb-4 px-1">
        {% if col != blank %}
          {% for product in col.products limit: section.settings.products_to_show %}
            <article class="cell">
              <a href="{{ product.url }}" class="block cell__img">
                {% if product.metafields.custom.badge != blank %}
                  <span class="cell__badge">{{ product.metafields.custom.badge }}</span>
                {% endif %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}">
              </a>
              <h3 class="mt-3 font-bold text-sm leading-tight">{{ product.title }}</h3>
              {% if product.metafields.custom.card_set != blank or product.metafields.custom.card_number != blank %}
                <p class="text-xs text-slate">{{ product.metafields.custom.card_set }} · {{ product.metafields.custom.card_number }}</p>
              {% endif %}
              <p class="mt-1 font-bold text-gold">{{ product.price | money }}</p>
              <form method="post" action="/cart/add" class="mt-2">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="w-full rounded-full border border-gold/35 py-1.5 text-xs font-bold text-gold hover:bg-gold hover:text-ink">ADD</button>
              </form>
            </article>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <article class="cell">
              <a href="#" class="block cell__img">
                <img src="{{ 'card-back.svg' | asset_url }}" alt="Placeholder">
              </a>
              <h3 class="mt-3 font-bold text-sm leading-tight">Example Card</h3>
              <p class="text-xs text-slate">Set Name · #123</p>
              <p class="mt-1 font-bold text-gold">$0.00</p>
              <button type="button" class="mt-2 w-full rounded-full border border-gold/35 py-1.5 text-xs font-bold text-gold hover:bg-gold hover:text-ink">ADD</button>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge Label (Optional fallback)",
      "default": "Only 1 left"
    }
  ],
  "presets": [
    {
      "name": "TCG Bestsellers"
    }
  ]
}
{% endschema %}
