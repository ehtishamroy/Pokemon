{% comment %}
  TCG Hitz — Bestsellers carousel (1:1 with index.html "BESTSELLERS CAROUSEL")
{% endcomment %}

{%- assign col = section.settings.collection -%}

<section class="tcg-scope py-12 lg:py-16 relative" style="position: relative; isolation: isolate; overflow: hidden;">
  <style>
    @keyframes shop-arrow-nudge {
      0%, 100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(5px);
      }
    }
    @keyframes shop-btn-glow {
      0%, 100% {
        filter: drop-shadow(0 0 0px rgba(255, 199, 44, 0));
      }
      50% {
        filter: drop-shadow(0 0 8px rgba(255, 199, 44, 0.5));
      }
    }
    .tcg-shop-all-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-family: 'Manrope', system-ui, sans-serif;
      font-weight: 800;
      font-size: clamp(15px, 1.8vw, 18px);
      color: var(--gold, #FFC72C);
      text-decoration: none;
      transition: color 0.25s ease, filter 0.25s ease, transform 0.25s ease;
      animation: shop-btn-glow 3s ease-in-out infinite;
      white-space: nowrap;
    }
    .tcg-shop-all-btn:hover {
      color: #FFFFFF;
      filter: drop-shadow(0 0 12px rgba(255, 199, 44, 0.85));
      transform: translateX(2px);
    }
    .tcg-shop-all-arrow {
      width: 1.25rem;
      height: 1.25rem;
      display: inline-block;
      animation: shop-arrow-nudge 1.6s ease-in-out infinite;
      transition: transform 0.2s ease;
    }
    .tcg-shop-all-btn:hover .tcg-shop-all-arrow {
      animation: none;
      transform: translateX(6px);
    }

    /* Live Animated Green Dot & Count Badge */
    @keyframes green-ping {
      0% {
        transform: scale(0.9);
        opacity: 0.9;
      }
      70%, 100% {
        transform: scale(2.4);
        opacity: 0;
      }
    }
    @keyframes green-glow {
      0%, 100% {
        box-shadow: 0 0 4px rgba(34, 197, 94, 0.7);
        opacity: 0.9;
      }
      50% {
        box-shadow: 0 0 10px rgba(34, 197, 94, 1);
        opacity: 1;
      }
    }
    .tcg-count-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      white-space: nowrap;
      user-select: none;
    }
    .tcg-pulse-dot-wrap {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 7px;
      height: 7px;
      margin-right: 2px;
    }
    .tcg-pulse-dot-ping {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 9999px;
      background-color: #22c55e;
      animation: green-ping 2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .tcg-pulse-dot {
      position: relative;
      width: 7px;
      height: 7px;
      border-radius: 9999px;
      background-color: #22c55e;
      animation: green-glow 2s ease-in-out infinite;
    }
    .tcg-count-text {
      font-family: 'Manrope', system-ui, sans-serif;
      font-weight: 800;
      font-size: clamp(12px, 1.4vw, 14px);
      color: #22c55e;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      line-height: 1;
    }

    /* Ambient Animated Golden Aura Backdrop */
    @keyframes ambient-gold-pulse {
      0%, 100% {
        transform: translate(-50%, -45%) scale(1);
        opacity: 0.72;
      }
      50% {
        transform: translate(-50%, -45%) scale(1.12);
        opacity: 1;
      }
    }
    .tcg-ambient-gold-glow {
      position: absolute;
      top: 55%;
      left: 50%;
      transform: translate(-50%, -45%);
      width: min(1050px, 96vw);
      height: 480px;
      background: radial-gradient(ellipse 65% 55% at 50% 50%, rgba(255, 199, 44, 0.28) 0%, rgba(212, 143, 10, 0.14) 42%, rgba(255, 199, 44, 0.03) 68%, transparent 80%);
      filter: blur(52px);
      pointer-events: none;
      z-index: 0;
      animation: ambient-gold-pulse 7s ease-in-out infinite;
      border-radius: 50%;
    }
  </style>

  {%- if section.settings.enable_ambient_glow -%}
    <div class="tcg-ambient-gold-glow" aria-hidden="true"></div>
  {%- endif -%}

  {%- assign total_products = col.all_products_count | default: col.products_count | default: col.products.size | default: 0 -%}

  <div class="mx-auto max-w-site px-4 sm:px-6 relative z-10">
    <div class="flex items-center justify-between pb-3 sm:pb-4 mb-6 sm:mb-8 flex-wrap gap-y-3">
      <h2 class="stitle stitle--left text-left !m-0 !p-0">{{ section.settings.heading }}</h2>
      <div class="flex items-center gap-4 sm:gap-6">
        {%- if section.settings.show_product_count -%}
          <div class="tcg-count-badge" aria-label="{{ total_products }} products available">
            <span class="tcg-pulse-dot-wrap" aria-hidden="true">
              <span class="tcg-pulse-dot-ping"></span>
              <span class="tcg-pulse-dot"></span>
            </span>
            <span class="tcg-count-text">{{ total_products }} {{ section.settings.product_count_label | default: 'PRODUCTS' }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.show_view_all -%}
          <a href="{{ section.settings.view_all_link | default: col.url | default: routes.all_products_collection_url }}" class="tcg-shop-all-btn" aria-label="{{ section.settings.view_all_label | default: 'Shop all' }} {{ section.settings.heading }}">
            <span>{{ section.settings.view_all_label | default: 'Shop all' }}</span>
            <svg class="tcg-shop-all-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_divider -%}
      <div class="rule-gold mb-8 max-w-[240px]"></div>
    {%- endif -%}
    <div class="carousel">
      {%- if col.products.size > 6 and section.settings.products_to_show > 6 -%}
        <button type="button" class="arrow prev" aria-label="Scroll left"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m15 6-6 6 6 6"/></svg></button>
        <button type="button" class="arrow next" aria-label="Scroll right"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="m9 6 6 6-6 6"/></svg></button>
      {%- endif -%}
      <div class="rail flex gap-5 overflow-x-auto pb-4 px-1">
        {%- if col != blank and col.products.size > 0 -%}
          {%- for product in col.products limit: section.settings.products_to_show -%}
            {% render 'tcg-cell', product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..6) -%}
            <article class="cell"><span class="block cell__img"><img src="{{ 'card-back.svg' | asset_url }}" alt=""></span><h3 class="mt-3 font-bold text-sm leading-tight">Add products</h3><p class="text-xs text-slate">Pick a collection in the editor</p><p class="mt-1 font-bold text-gold">$0.00</p></article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Bestsellers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "header", "content": "Ambient Glow Effect" },
    { "type": "checkbox", "id": "enable_ambient_glow", "label": "Enable ambient gold glow backdrop", "default": true },
    { "type": "header", "content": "Product Count Badge" },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count badge", "default": true },
    { "type": "text", "id": "product_count_label", "label": "Count suffix", "default": "PRODUCTS" },
    { "type": "header", "content": "Shop All Link" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'Shop all' link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "view_all_link", "label": "Custom link (optional)" },
    { "type": "checkbox", "id": "show_divider", "label": "Show gold divider", "default": false }
  ],
  "presets": [{ "name": "TCG Bestsellers" }]
}
{% endschema %}
