{% comment %}
  TCG Hitz — Vending machine product page (templates/product.vending.json).

  Built on the standard product page (same gallery / variant / qty / ADD-TO-CART markup
  and data-* hooks, so assets/tcg.js handles cart + drawer), plus:
    - delivery timeline strip (built to order → shipped → free shipping),
    - optional add-ons (custom wrap, bill acceptor, card reader…). Each add-on is its own
      product so its price is edited in Shopify admin; checked add-ons are added to the cart
      together with the machine in one request. List comes from the product's
      custom.addons metafield (list of products) or, if empty, the section's add-ons setting,
    - spec tabs from custom.* metafields — any empty field / tab is hidden, so specs can be
      filled in later without showing blanks,
    - profit calculator (snippets/tcg-profit-calculator.liquid), purchase → profit steps, FAQ.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  if current_variant.featured_image
    assign main_img = current_variant.featured_image | image_url: width: 1200
  elsif product.featured_image
    assign main_img = product.featured_image | image_url: width: 1200
  endif
  assign price_dollars = current_variant.price | divided_by: 100.0
  assign mf = product.metafields.custom

  assign addons = mf.addons.value
  if addons == blank or addons.size == 0
    assign addons = section.settings.addons
  endif
-%}

{%- capture stock_text -%}
  {%- if current_variant.available -%}
    {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity == 1 -%}Only 1 left{%- elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 -%}{{ current_variant.inventory_quantity }} available{%- else -%}Available to order{%- endif -%}
  {%- else -%}Sold out{%- endif -%}
{%- endcapture -%}

<section class="tcg-scope smoke pt-8 pb-10 lg:pt-10" style="overflow-x: clip;">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <nav class="text-sm text-slate" aria-label="Breadcrumb"><a href="{{ routes.root_url }}" class="hover:text-volt">{{ shop.name }}</a><span class="mx-2">/</span><a href="/pages/vending-machines" class="hover:text-volt">{{ section.settings.breadcrumb_label }}</a><span class="mx-2">/</span><span class="text-paper">{{ product.title }}</span></nav>

    <div class="mt-6 grid lg:grid-cols-12 gap-10 lg:gap-14">

      {%- comment -%} ---- Gallery ---------------------------------------------- {%- endcomment -%}
      <div class="lg:col-span-6">
        <div class="lg:sticky lg:top-24">
          <div class="cabinet bg-ink p-5 sm:p-7">
            <div class="rounded-card overflow-hidden bg-felt-2/40 grid place-items-center" style="min-height:360px;">
              {%- if main_img -%}
                <img data-main-img src="{{ main_img }}" alt="{{ product.title | escape }}" width="1200" height="1200" class="w-full h-auto max-h-[600px] object-contain">
              {%- else -%}
                <div class="w-full aspect-square grid place-items-center text-slate">{{ 'image' | placeholder_svg_tag: 'w-24 h-24 opacity-40' }}</div>
              {%- endif -%}
            </div>
            {%- if product.media.size > 1 -%}
              <div class="thumbs mt-5 flex gap-3 overflow-x-auto pb-1">
                {%- for media in product.media -%}
                  <button type="button" data-thumb="{{ media | image_url: width: 1200 }}" class="{% if forloop.first %}ring-2 ring-volt {% endif %}shrink-0 w-[72px] h-[72px] rounded-lg overflow-hidden bg-felt-2" aria-label="{{ media.alt | default: 'Photo' | escape }}"><img src="{{ media | image_url: width: 160 }}" alt="" class="w-full h-full object-cover" width="72" height="72" loading="lazy"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if section.settings.gallery_note != blank -%}<p class="mt-4 text-center text-sm text-slate">{{ section.settings.gallery_note }}</p>{%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} ---- Buy box ---------------------------------------------- {%- endcomment -%}
      <div class="lg:col-span-6">
        <p class="text-sm font-bold tracking-widest text-volt uppercase">{{ product.type | default: 'Card vending machine' }}</p>
        <h1 class="font-display text-4xl sm:text-5xl leading-[1.04] mt-2">{{ product.title }}</h1>

        <div class="mt-6 flex items-center gap-4 flex-wrap">
          <span data-price class="font-display text-[42px] leading-none text-volt">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="text-lg text-slate line-through">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span data-stock class="rounded-full {% if current_variant.available %}bg-mint/15 text-mint{% else %}bg-chase/15 text-chase{% endif %} px-3 py-1 text-sm font-bold">{{ stock_text | strip }}</span>
        </div>

        {%- comment -%} Delivery timeline {%- endcomment -%}
        <ul class="mt-6 grid sm:grid-cols-3 gap-2.5 text-sm">
          {%- if section.settings.lead_build != blank -%}<li class="rounded-xl border border-volt/25 bg-felt-2/60 px-3.5 py-2.5"><span class="block text-xs text-slate">Step 1</span><span class="font-bold">{{ section.settings.lead_build }}</span></li>{%- endif -%}
          {%- if section.settings.lead_ship != blank -%}<li class="rounded-xl border border-volt/25 bg-felt-2/60 px-3.5 py-2.5"><span class="block text-xs text-slate">Step 2</span><span class="font-bold">{{ section.settings.lead_ship }}</span></li>{%- endif -%}
          {%- if section.settings.lead_shipping != blank -%}<li class="rounded-xl border border-flare/45 bg-flare/10 px-3.5 py-2.5"><span class="block text-xs text-slate">Delivery</span><span class="font-bold text-paper">{{ section.settings.lead_shipping }}</span></li>{%- endif -%}
        </ul>

        {%- unless product.has_only_default_variant -%}
          <fieldset class="mt-7">
            <legend class="font-bold tracking-widest text-xs text-slate">{{ product.options | join: ' & ' | upcase }}</legend>
            <p class="text-sm text-slate mt-1.5">Selected: <span data-selected class="text-paper font-semibold">{{ current_variant.title }}</span></p>
            <div class="mt-3 space-y-2.5" role="radiogroup">
              {%- for variant in product.variants -%}
                {%- capture v_stock -%}{%- if variant.available -%}Available to order{%- else -%}Sold out{%- endif -%}{%- endcapture -%}
                {%- assign v_rest = '' -%}
                {%- if variant.option2 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option2 -%}{%- endif -%}
                {%- if variant.option3 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option3 -%}{%- endif -%}
                <button type="button" data-variant data-id="{{ variant.id }}" data-price="{{ variant.price | money }}" data-price-cents="{{ variant.price }}" data-stock="{{ v_stock | strip }}" data-available="{{ variant.available }}" data-label="{{ variant.title | escape }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1200 }}"{% endif %} role="radio" aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  class="w-full flex items-center justify-between rounded-lg border border-volt/20 bg-felt-2/60 px-4 py-3.5 text-left hover:border-volt transition">
                  <span><span class="font-bold">{{ variant.option1 }}</span> <span class="text-slate">{{ v_rest }}</span><span class="block text-xs text-slate mt-0.5">{{ v_stock | strip }}</span></span>
                  <span class="font-display text-lg text-volt">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endunless -%}

        {%- comment -%} Add-ons {%- endcomment -%}
        {%- if addons != blank and addons.size > 0 -%}
          <fieldset class="mt-8">
            <legend class="font-display text-xl">{{ section.settings.addons_heading }}</legend>
            {%- if section.settings.addons_text != blank -%}<p class="text-sm text-slate mt-1">{{ section.settings.addons_text }}</p>{%- endif -%}
            <div class="mt-4 space-y-2.5">
              {%- for addon in addons -%}
                {%- assign av = addon.selected_or_first_available_variant -%}
                <label class="tcg-addon{% unless av.available %} opacity-50 cursor-not-allowed{% endunless %}">
                  <input type="checkbox" class="sr-only" data-addon data-variant-id="{{ av.id }}" data-price-cents="{{ av.price }}"{% unless av.available %} disabled{% endunless %}>
                  <span class="tcg-addon__check" aria-hidden="true"><svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L19 7"/></svg></span>
                  {%- if addon.featured_image -%}
                    <img src="{{ addon.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy" class="h-12 w-12 shrink-0 rounded-lg object-cover bg-felt-2">
                  {%- endif -%}
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold leading-tight">{{ addon.title }}</span>
                    {%- assign addon_blurb = addon.description | strip_html | truncatewords: 14 -%}
                    {%- if addon_blurb != blank -%}<span class="block text-xs text-slate mt-0.5">{{ addon_blurb }}</span>{%- endif -%}
                  </span>
                  <span class="shrink-0 font-bold text-volt">{% if av.available %}+{{ av.price | money }}{% else %}Unavailable{% endif %}</span>
                </label>
              {%- endfor -%}
            </div>
            <div class="mt-4 flex items-center justify-between rounded-xl border border-volt/20 bg-ink/70 px-4 py-3">
              <span class="text-sm text-slate" data-addon-count>Machine only</span>
              <span class="font-display text-2xl text-paper" data-addon-total data-currency="{{ cart.currency.iso_code }}" data-base-cents="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
            </div>
          </fieldset>
        {%- endif -%}

        <input type="hidden" data-variant-input name="id" value="{{ current_variant.id }}">
        <div class="mt-7 flex items-center gap-4">
          <div class="qty inline-flex items-center rounded-full bg-felt-2 border border-volt/25">
            <button type="button" data-qty-dec class="rounded-full text-xl text-volt" aria-label="Decrease quantity">−</button>
            <span data-qty-value class="w-8 text-center font-bold" aria-live="polite">1</span>
            <button type="button" data-qty-inc class="rounded-full text-xl text-volt" aria-label="Increase quantity">+</button>
          </div>
          <button type="button" data-add data-add-main data-variant-id="{{ current_variant.id }}"{% unless current_variant.available %} disabled{% endunless %}
                  class="flex-1 rounded-full bg-fire px-6 py-4 font-bold text-white{% unless current_variant.available %} opacity-60{% endunless %}">{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button>
        </div>

        <ul class="mt-8 grid sm:grid-cols-3 gap-3">
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">{{ section.settings.badge_1_title }}</span><span class="text-xs text-slate">{{ section.settings.badge_1_text }}</span></li>
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">{{ section.settings.badge_2_title }}</span><span class="text-xs text-slate">{{ section.settings.badge_2_text }}</span></li>
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">{{ section.settings.badge_3_title }}</span><span class="text-xs text-slate">{{ section.settings.badge_3_text }}</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{%- comment -%} ---- About + spec tabs (every empty field/tab is hidden) ---------- {%- endcomment -%}
{%- capture panel_physical -%}
  {%- assign pairs = 'Dimensions::dimensions,Weight::weight,Cabinet::cabinet,Color / finish::finish' | split: ',' -%}
  {%- for pair in pairs -%}{%- assign p = pair | split: '::' -%}{%- assign val = mf[p[1]].value | default: mf[p[1]] -%}{%- if val != blank -%}{%- if val.size and val.first -%}{%- assign val = val | join: ', ' -%}{%- endif -%}<div class="border-b border-volt/10 pb-2"><dt class="text-slate text-sm">{{ p[0] }}</dt><dd class="font-semibold">{{ val }}</dd></div>{%- endif -%}{%- endfor -%}
{%- endcapture -%}
{%- capture panel_tech -%}
  {%- assign pairs = 'Screen::display_size,Number of slots::slots,Capacity::capacity,Payment options::payment,Connectivity::network,Software & app::software' | split: ',' -%}
  {%- for pair in pairs -%}{%- assign p = pair | split: '::' -%}{%- assign val = mf[p[1]].value | default: mf[p[1]] -%}{%- if val != blank -%}{%- if val.size and val.first -%}{%- assign val = val | join: ', ' -%}{%- endif -%}<div class="border-b border-volt/10 pb-2"><dt class="text-slate text-sm">{{ p[0] }}</dt><dd class="font-semibold">{{ val }}</dd></div>{%- endif -%}{%- endfor -%}
{%- endcapture -%}
{%- capture panel_power -%}
  {%- assign pairs = 'Power::power,Placement::environment,Warranty::warranty' | split: ',' -%}
  {%- for pair in pairs -%}{%- assign p = pair | split: '::' -%}{%- assign val = mf[p[1]].value | default: mf[p[1]] -%}{%- if val != blank -%}{%- if val.size and val.first -%}{%- assign val = val | join: ', ' -%}{%- endif -%}<div class="border-b border-volt/10 pb-2"><dt class="text-slate text-sm">{{ p[0] }}</dt><dd class="font-semibold">{{ val }}</dd></div>{%- endif -%}{%- endfor -%}
{%- endcapture -%}
{%- assign ph_s = panel_physical | strip -%}
{%- assign te_s = panel_tech | strip -%}
{%- assign pw_s = panel_power | strip -%}
{%- assign has_specs = false -%}
{%- if ph_s != blank or te_s != blank or pw_s != blank -%}{%- assign has_specs = true -%}{%- endif -%}

{%- if product.description != blank or has_specs -%}
  <section class="tcg-scope py-10 lg:py-14">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <h2 class="stitle">{{ section.settings.details_heading }}</h2>
      <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
      <div class="grid lg:grid-cols-12 gap-8">
        {%- if product.description != blank -%}
          <div class="{% if has_specs %}lg:col-span-7{% else %}lg:col-span-12{% endif %} cabinet bg-ink p-6 sm:p-8">
            <div class="tcg-prose">{{ product.description }}</div>
          </div>
        {%- endif -%}
        {%- if has_specs -%}
          <div class="{% if product.description != blank %}lg:col-span-5{% else %}lg:col-span-12{% endif %} cabinet bg-ink p-6 sm:p-8" data-tabs>
            <div class="flex flex-wrap gap-2" role="tablist">
              {%- if ph_s != blank -%}<button type="button" class="tcg-tabs__btn" role="tab" data-tab="physical" aria-selected="false">Physical</button>{%- endif -%}
              {%- if te_s != blank -%}<button type="button" class="tcg-tabs__btn" role="tab" data-tab="tech" aria-selected="false">Vending &amp; tech</button>{%- endif -%}
              {%- if pw_s != blank -%}<button type="button" class="tcg-tabs__btn" role="tab" data-tab="power" aria-selected="false">Power &amp; placement</button>{%- endif -%}
            </div>
            {%- if ph_s != blank -%}<div role="tabpanel" data-panel="physical"><dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3.5 text-[15px]">{{ panel_physical }}</dl></div>{%- endif -%}
            {%- if te_s != blank -%}<div role="tabpanel" data-panel="tech" hidden><dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3.5 text-[15px]">{{ panel_tech }}</dl></div>{%- endif -%}
            {%- if pw_s != blank -%}<div role="tabpanel" data-panel="power" hidden><dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3.5 text-[15px]">{{ panel_power }}</dl></div>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---- Profit calculator ------------------------------------------ {%- endcomment -%}
{%- if section.settings.show_calc -%}
  <section class="tcg-scope py-10 lg:py-14" id="profit-calculator">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      {% render 'tcg-profit-calculator',
        uid: section.id,
        heading: section.settings.calc_heading,
        subheading: section.settings.calc_text,
        machine_price: price_dollars,
        pack_cost: section.settings.calc_cost,
        vend_price: section.settings.calc_price,
        vends_per_day: section.settings.calc_vends
      %}
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---- Purchase → profit steps ------------------------------------ {%- endcomment -%}
{%- if section.settings.show_steps -%}
  <section class="tcg-scope py-10 lg:py-14">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <h2 class="stitle">{{ section.settings.steps_heading }}</h2>
      <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {%- for i in (1..4) -%}
          {%- assign st_key = 'step_' | append: i | append: '_title' -%}
          {%- assign sx_key = 'step_' | append: i | append: '_text' -%}
          {%- if section.settings[st_key] != blank -%}
            <li class="cabinet bg-ink p-6">
              <span class="tcg-step__num">{{ i }}</span>
              <h3 class="mt-4 font-bold text-lg">{{ section.settings[st_key] }}</h3>
              <p class="mt-1.5 text-sm text-paper-dim leading-relaxed">{{ section.settings[sx_key] }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---- FAQ (blocks) ----------------------------------------------- {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="tcg-scope py-10 lg:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="stitle">{{ section.settings.faq_heading }}</h2>
      <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
      <div class="space-y-3">
        {%- for block in section.blocks -%}
          <details class="faq cabinet bg-ink p-5 group" {{ block.shopify_attributes }}>
            <summary class="cursor-pointer font-bold flex items-center justify-between gap-4">{{ block.settings.question }}
              <svg class="chev h-5 w-5 shrink-0 text-volt transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="tcg-prose mt-3 text-[15px]">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} ---- More machines ---------------------------------------------- {%- endcomment -%}
{%- if section.settings.show_related -%}
  {%- liquid
    assign related_source = section.settings.related_collection
    if related_source == blank
      assign related_source = product.collections.first
    endif
  -%}
  {%- if related_source != blank and related_source.products_count > 1 -%}
    <section class="tcg-scope py-12 lg:py-16">
      <div class="mx-auto max-w-site px-4 sm:px-6">
        <h2 class="stitle">{{ section.settings.related_heading }}</h2>
        <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          {%- assign shown = 0 -%}
          {%- for related in related_source.products -%}
            {%- if related.id != product.id and shown < 4 -%}
              {% render 'tcg-cell', product: related, full: true %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%} ---- Still have questions ---------------------------------------- {%- endcomment -%}
{%- if section.settings.cta_heading != blank -%}
  <section class="tcg-scope py-10 lg:py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="cabinet bg-ink p-8 text-center">
        <h2 class="font-display text-2xl sm:text-3xl">{{ section.settings.cta_heading }}</h2>
        {%- if section.settings.cta_text != blank -%}<p class="mt-2 text-paper-dim">{{ section.settings.cta_text }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="mt-6 inline-flex rounded-full bg-fire px-7 py-3.5 font-bold text-white">{{ section.settings.cta_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "TCG – Vending Machine",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb label", "default": "Vending machines" },
    { "type": "text", "id": "gallery_note", "label": "Gallery note", "default": "Photos of the actual machine." },
    { "type": "header", "content": "Delivery timeline" },
    { "type": "text", "id": "lead_build", "label": "Build time", "default": "Built to order in 3–4 weeks" },
    { "type": "text", "id": "lead_ship", "label": "Shipping time", "default": "Ships in 3–4 weeks" },
    { "type": "text", "id": "lead_shipping", "label": "Shipping cost note", "default": "Free shipping included" },
    { "type": "header", "content": "Add-ons" },
    { "type": "product_list", "id": "addons", "label": "Default add-ons", "limit": 10, "info": "Optional extras customers can tick (e.g. custom wrap, cash bill acceptor, Nayax card reader). Create each as its own product so you can set the price. A machine's custom.addons metafield overrides this list." },
    { "type": "text", "id": "addons_heading", "label": "Heading", "default": "Customize your machine" },
    { "type": "text", "id": "addons_text", "label": "Text", "default": "Optional extras — tick any you want and they're added to your order." },
    { "type": "header", "content": "Trust badges" },
    { "type": "text", "id": "badge_1_title", "label": "Badge 1 title", "default": "Free shipping" },
    { "type": "text", "id": "badge_1_text", "label": "Badge 1 text", "default": "Delivered to your door" },
    { "type": "text", "id": "badge_2_title", "label": "Badge 2 title", "default": "Built to order" },
    { "type": "text", "id": "badge_2_text", "label": "Badge 2 text", "default": "Made for you in 3–4 weeks" },
    { "type": "text", "id": "badge_3_title", "label": "Badge 3 title", "default": "Secure checkout" },
    { "type": "text", "id": "badge_3_text", "label": "Badge 3 text", "default": "Pay in full online" },
    { "type": "header", "content": "Details & specs" },
    { "type": "text", "id": "details_heading", "label": "Heading", "default": "Machine details", "info": "Specs come from product metafields (custom namespace): dimensions, weight, cabinet, finish, display_size, slots, capacity, payment, network, software, power, environment, warranty. Empty fields are hidden." },
    { "type": "header", "content": "Profit calculator" },
    { "type": "checkbox", "id": "show_calc", "label": "Show profit calculator", "default": true },
    { "type": "text", "id": "calc_heading", "label": "Heading", "default": "Profit calculator" },
    { "type": "text", "id": "calc_text", "label": "Text", "default": "Adjust the numbers to estimate what this machine could earn." },
    { "type": "number", "id": "calc_cost", "label": "Default cost per pack", "default": 4 },
    { "type": "number", "id": "calc_price", "label": "Default selling price per pack", "default": 9 },
