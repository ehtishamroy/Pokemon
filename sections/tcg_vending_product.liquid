{% comment %}
  TCG Hitz — Vending machine page: gallery + buy box (templates/product.vending.json), TCG HITZ design.

  Same behaviour as before — assets/tcg.js handles variants, quantity, add-ons and ADD TO CART through the
  data-* hooks below, so nothing about the cart changed:
    data-main-img, data-thumb, data-gallery-nav, data-variant, data-price, data-stock, data-selected,
    data-variant-input, data-qty-dec / -value / -inc, data-add data-add-main, data-addon,
    data-addon-total / -count (data-base-cents).

  Add-ons (custom wrap, cash bill acceptor, Nayax card reader…) are their own products so each price is edited in
  Shopify admin. The list comes from the product's custom.addons metafield (list of products) or, if empty,
  from this section's "Default add-ons". Checked add-ons are added to the cart together with the machine.

  The delivery process, details/specs, profit calculator, FAQ and more-machines blocks are separate sections:
  tcg-vm-journey, tcg-vm-specs, tcg-vm-calculator, tcg-home-faq, tcg-product-related …
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  if current_variant.featured_image
    assign main_img = current_variant.featured_image | image_url: width: 1200
  elsif product.featured_image
    assign main_img = product.featured_image | image_url: width: 1200
  else
    assign main_img = 'home-cat-vending.webp' | asset_url
  endif

  assign addons = product.metafields.custom.addons.value
  if addons == blank or addons.size == 0
    assign addons = section.settings.addons
  endif
-%}

{%- capture stock_text -%}
  {%- if current_variant.available -%}
    {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity == 1 -%}Only 1 left{%- elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 -%}{{ current_variant.inventory_quantity }} available{%- else -%}Available to order{%- endif -%}
  {%- else -%}Sold out{%- endif -%}
{%- endcapture -%}

<section class="tcg-scope hz hz-pdp relative" style="overflow-x: clip;">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap pb-[48px] pt-[28px] md:pb-[72px] md:pt-[40px] xl:pb-[100px]">
    <nav class="text-[14px] leading-[1.5] text-white md:text-[16px]" aria-label="Breadcrumb" data-hz-reveal>
      <a href="{{ routes.root_url }}" class="hz-ulink hover:text-hz-lightning">{{ section.settings.home_label }}</a><span class="mx-[6px]" aria-hidden="true">/</span>
      <a href="{{ section.settings.breadcrumb_link | default: '/pages/vending-machines' }}" class="hz-ulink hover:text-hz-lightning">{{ section.settings.breadcrumb_label }}</a><span class="mx-[6px]" aria-hidden="true">/</span>
      <strong class="font-bold text-hz-gold">{{ product.title }}</strong>
    </nav>

    <div class="hz-pdp__grid mt-[28px] grid gap-10 md:mt-[36px] lg:grid-cols-12 lg:gap-14">

      {%- comment -%} ---- Gallery ---------------------------------------------- {%- endcomment -%}
      <div class="lg:col-span-6">
        <div class="hz-gallery lg:sticky lg:top-24" data-hz-reveal>
          <div class="hz-stage tcg-gb [--bw:1px]" data-hz-stage tabindex="0" aria-label="Product images">
            <span aria-hidden="true" class="hz-stage__glow"></span>
            <img data-main-img src="{{ main_img }}" alt="{{ product.title | escape }}" width="1000" height="1000" fetchpriority="high" class="hz-stage__img">
            {%- if product.media.size > 1 -%}
              <button type="button" class="hz-gallery-arrow hz-gallery-arrow--prev" data-gallery-nav="-1" aria-label="Previous image"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" class="hz-gallery-arrow hz-gallery-arrow--next" data-gallery-nav="1" aria-label="Next image"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="hz-thumbs{% if product.media.size > 5 %} hz-thumbs--scroll{% endif %}" role="list">
              {%- for media in product.media -%}
                <button type="button" role="listitem" data-thumb="{{ media.preview_image | image_url: width: 1000 }}" class="hz-thumb{% if forloop.first %} is-active{% endif %}" aria-label="{{ media.alt | default: 'Photo' | escape }}"><img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.gallery_note != blank -%}<p class="mt-[16px] text-center text-[14px] text-hz-cool">{{ section.settings.gallery_note }}</p>{%- endif -%}
        </div>
      </div>

      {%- comment -%} ---- Buy box ---------------------------------------------- {%- endcomment -%}
      <div class="lg:col-span-6" data-hz-reveal>
        <div class="hz-eyebrow"><span>{{ product.type | default: 'Card vending machine' }}</span></div>
        <h1 class="mt-[14px] font-display text-[34px] uppercase leading-[1.08] text-white sm:text-[42px] xl:text-[50px]">{{ product.title }}</h1>

        <div class="mt-[22px] flex flex-wrap items-center gap-[14px]">
          <span data-price class="font-display text-[38px] leading-none text-hz-pink md:text-[44px]">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="text-[18px] text-hz-cool line-through">{{ current_variant.compare_at_price | money }}</span>
          {%- endif -%}
          <span data-stock data-hz-stock class="hz-stock {% if current_variant.available %}hz-stock--ok{% else %}hz-stock--out{% endif %}">{{ stock_text | strip }}</span>
        </div>

        {%- comment -%} Delivery at a glance — the full process is the "Built to order" section below {%- endcomment -%}
        <ul class="mt-[22px] flex flex-wrap gap-[10px]">
          {%- if section.settings.lead_build != blank -%}<li class="hz-chip">{% render 'tcg-sell-icon', name: 'wrench', size: 16 %}<span>{{ section.settings.lead_build }}</span></li>{%- endif -%}
          {%- if section.settings.lead_ship != blank -%}<li class="hz-chip">{% render 'tcg-sell-icon', name: 'ship', size: 16 %}<span>{{ section.settings.lead_ship }}</span></li>{%- endif -%}
          {%- if section.settings.lead_shipping != blank -%}<li class="hz-chip hz-chip--ok">{% render 'tcg-sell-icon', name: 'truck', size: 16 %}<span>{{ section.settings.lead_shipping }}</span></li>{%- endif -%}
          {%- if section.settings.lead_total != blank -%}<li class="hz-chip hz-chip--hot">{% render 'tcg-sell-icon', name: 'clock', size: 16 %}<span>{{ section.settings.lead_total }}</span></li>{%- endif -%}
        </ul>

        {%- unless product.has_only_default_variant -%}
          <fieldset class="mt-[28px]">
            <legend class="text-[12px] font-bold uppercase tracking-[0.1em] text-white">{{ product.options | join: ' & ' }}</legend>
            <p class="mt-[6px] text-[14px] text-hz-cool">Selected: <span data-selected class="font-semibold text-white">{{ current_variant.title }}</span></p>
            <div class="mt-[12px] flex flex-col gap-[10px]" role="radiogroup">
              {%- for variant in product.variants -%}
                {%- capture v_stock -%}{%- if variant.available -%}Available to order{%- else -%}Sold out{%- endif -%}{%- endcapture -%}
                {%- assign v_rest = '' -%}
                {%- if variant.option2 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option2 -%}{%- endif -%}
                {%- if variant.option3 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option3 -%}{%- endif -%}
                <button type="button" data-variant data-hz-opt data-id="{{ variant.id }}" data-price="{{ variant.price | money }}" data-price-cents="{{ variant.price }}" data-stock="{{ v_stock | strip }}" data-available="{{ variant.available }}" data-label="{{ variant.title | escape }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1200 }}"{% endif %} role="radio" aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}" class="hz-opt{% if variant.id == current_variant.id %} is-selected{% endif %}">
                  <span class="flex min-w-0 flex-col gap-[2px] text-left"><span class="font-bold text-white">{{ variant.option1 }}<span class="font-normal text-hz-cool">{{ v_rest }}</span></span><span class="text-[12px] text-hz-cool">{{ v_stock | strip }}</span></span>
                  <span class="font-display text-[18px] text-hz-pink">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endunless -%}

        {%- comment -%} Add-ons {%- endcomment -%}
        {%- if addons != blank and addons.size > 0 -%}
          <fieldset class="mt-[30px]">
            <legend class="font-display text-[20px] uppercase leading-[1.2] text-white">{{ section.settings.addons_heading }}</legend>
            {%- if section.settings.addons_text != blank -%}<p class="mt-[6px] text-[14px] leading-[1.5] text-hz-cool">{{ section.settings.addons_text }}</p>{%- endif -%}
            <div class="mt-[14px] flex flex-col gap-[10px]">
              {%- for addon in addons -%}
                {%- assign av = addon.selected_or_first_available_variant -%}
                <label class="hz-addon{% unless av.available %} is-disabled{% endunless %}">
                  <input type="checkbox" class="sr-only" data-addon data-variant-id="{{ av.id }}" data-price-cents="{{ av.price }}"{% unless av.available %} disabled{% endunless %}>
                  <span class="hz-addon__check" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m5 12 5 5L20 7"/></svg></span>
                  {%- if addon.featured_image -%}
                    <img src="{{ addon.featured_image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy" class="size-[48px] shrink-0 rounded-[10px] bg-hz-elevated object-cover">
                  {%- endif -%}
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold leading-[1.25] text-white">{{ addon.title }}</span>
                    {%- assign addon_blurb = addon.description | strip_html | truncatewords: 14 -%}
                    {%- if addon_blurb != blank -%}<span class="mt-[2px] block text-[12px] leading-[1.4] text-hz-cool">{{ addon_blurb }}</span>{%- endif -%}
                  </span>
                  <span class="shrink-0 font-bold text-hz-pink">{% if av.available %}+{{ av.price | money }}{% else %}Unavailable{% endif %}</span>
                </label>
              {%- endfor -%}
            </div>
            <div class="hz-total mt-[14px]">
              <span class="text-[14px] text-hz-cool" data-addon-count>Machine only</span>
              <span class="font-display text-[26px] leading-none text-white" data-addon-total data-currency="{{ cart.currency.iso_code }}" data-base-cents="{{ current_variant.price }}">{{ current_variant.price | money }}</span>
            </div>
          </fieldset>
        {%- endif -%}

        <input type="hidden" data-variant-input name="id" value="{{ current_variant.id }}">
        <div class="mt-[28px] flex items-center gap-[14px]">
          <div class="hz-qty">
            <button type="button" data-qty-dec aria-label="Decrease quantity">−</button>
            <span data-qty-value aria-live="polite">1</span>
            <button type="button" data-qty-inc aria-label="Increase quantity">+</button>
          </div>
          <button type="button" data-add data-add-main data-variant-id="{{ current_variant.id }}"{% unless current_variant.available %} disabled{% endunless %}
                  class="hz-btn !h-[52px] flex-1 justify-center{% unless current_variant.available %} opacity-60{% endunless %}">{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button>
        </div>
        <div class="mt-[14px] flex flex-wrap gap-x-[22px] gap-y-[8px] text-[14px]">
          {%- if section.settings.journey_link_label != blank -%}<a href="#{{ section.settings.journey_anchor | default: 'build-journey' }}" class="hz-ulink text-white hover:text-hz-lightning">{{ section.settings.journey_link_label }} →</a>{%- endif -%}
          {%- if section.settings.calc_link_label != blank -%}<a href="#{{ section.settings.calc_anchor | default: 'profit-calculator' }}" class="hz-ulink text-white hover:text-hz-lightning">{{ section.settings.calc_link_label }} →</a>{%- endif -%}
        </div>

        <ul class="mt-[30px] grid gap-[12px] sm:grid-cols-3">
          <li class="hz-lift-card tcg-gb flex flex-col gap-[8px] rounded-[16px] bg-white/[0.03] p-[16px]"><span class="text-hz-lightning">{% render 'tcg-sell-icon', name: 'truck', size: 22 %}</span><span class="block text-[14px] font-bold text-white">{{ section.settings.badge_1_title }}</span><span class="text-[12px] leading-[1.4] text-hz-cool">{{ section.settings.badge_1_text }}</span></li>
          <li class="hz-lift-card tcg-gb flex flex-col gap-[8px] rounded-[16px] bg-white/[0.03] p-[16px]"><span class="text-hz-lightning">{% render 'tcg-sell-icon', name: 'machine', size: 22 %}</span><span class="block text-[14px] font-bold text-white">{{ section.settings.badge_2_title }}</span><span class="text-[12px] leading-[1.4] text-hz-cool">{{ section.settings.badge_2_text }}</span></li>
          <li class="hz-lift-card tcg-gb flex flex-col gap-[8px] rounded-[16px] bg-white/[0.03] p-[16px]"><span class="text-hz-lightning">{% render 'tcg-sell-icon', name: 'check', size: 22 %}</span><span class="block text-[14px] font-bold text-white">{{ section.settings.badge_3_title }}</span><span class="text-[12px] leading-[1.4] text-hz-cool">{{ section.settings.badge_3_text }}</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG – Vending Machine",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-blue", "label": "Blue, left" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-pink", "label": "Pink, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "left-blue" },
    { "type": "text", "id": "home_label", "label": "Breadcrumb: home label", "default": "Home" },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb: machines page", "default": "Vending Machines" },
    { "type": "url", "id": "breadcrumb_link", "label": "Breadcrumb link", "info": "Empty = /pages/vending-machines" },
    { "type": "text", "id": "gallery_note", "label": "Gallery note", "default": "Photos of the actual machine." },
    { "type": "header", "content": "Delivery at a glance" },
    { "type": "text", "id": "lead_build", "label": "Build time", "default": "Built to order in about 2 weeks" },
    { "type": "text", "id": "lead_ship", "label": "Shipping time", "default": "Ocean freight in 3–4 weeks" },
    { "type": "text", "id": "lead_shipping", "label": "Shipping cost note", "default": "Shipping included" },
    { "type": "text", "id": "lead_total", "label": "Total lead time", "default": "5–6 weeks in total" },
    { "type": "header", "content": "Add-ons" },
    { "type": "product_list", "id": "addons", "label": "Default add-ons", "limit": 10, "info": "Optional extras customers can tick (e.g. custom wrap, cash bill acceptor, Nayax card reader). Create each as its own product so you can set the price. A machine's custom.addons metafield overrides this list." },
    { "type": "text", "id": "addons_heading", "label": "Heading", "default": "Customize your machine" },
    { "type": "text", "id": "addons_text", "label": "Text", "default": "Optional extras. Tick any you want and they're added to the same order." },
    { "type": "header", "content": "Under the buy button" },
    { "type": "text", "id": "journey_link_label", "label": "Link to the build process", "default": "See the build and shipping process" },
    { "type": "text", "id": "journey_anchor", "label": "Build process anchor id", "default": "build-journey" },
    { "type": "text", "id": "calc_link_label", "label": "Link to the profit calculator", "default": "Estimate what it could earn" },
    { "type": "text", "id": "calc_anchor", "label": "Calculator anchor id", "default": "profit-calculator" },
    { "type": "header", "content": "Trust cards" },
    { "type": "text", "id": "badge_1_title", "label": "Card 1 title", "default": "Shipping included" },
    { "type": "text", "id": "badge_1_text", "label": "Card 1 text", "default": "Delivered to your door" },
    { "type": "text", "id": "badge_2_title", "label": "Card 2 title", "default": "Built to order" },
    { "type": "text", "id": "badge_2_text", "label": "Card 2 text", "default": "Ready in 5–6 weeks" },
    { "type": "text", "id": "badge_3_title", "label": "Card 3 title", "default": "Secure checkout" },
    { "type": "text", "id": "badge_3_text", "label": "Card 3 text", "default": "Pay in full online" }
  ],
  "presets": []
}
{% endschema %}
