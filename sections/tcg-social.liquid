{% comment %}
  TCG Hitz — Social / UGC
  Matches index.html lines 234-248
{% endcomment %}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <p class="text-center text-paper-dim mt-3">{{ section.settings.subheading }}</p>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="rail flex gap-4 overflow-x-auto pb-3">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 400 }}" alt="Social image" class="shrink-0 w-[190px] h-[250px] object-cover rounded-card border border-gold/15" {{ block.shopify_attributes }}>
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'shrink-0 w-[190px] h-[250px] object-cover rounded-card border border-gold/15' }}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Social",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the #HitzFamily"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pulls, restocks and show days — follow along."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TCG Social",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
