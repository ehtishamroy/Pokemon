{% comment %}
  TCG Hitz — Social / UGC rail (1:1 with index.html "SOCIAL / UGC")
{% endcomment %}

{%- assign fallbacks = 'machine-graffiti.jpg,store-display.jpg,gengar-print.jpg,charizard-stand.jpg,machine-booth.jpg' | split: ',' -%}

<section class="tcg-scope py-12 lg:py-16">
  <style>
    @keyframes marquee-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-100%); }
    }
    .tcg-marquee-track {
      display: flex;
      gap: 1rem;
      padding-right: 1rem;
      width: max-content;
      flex-shrink: 0;
      animation: marquee-scroll 20s linear infinite;
    }
    .tcg-marquee-container:hover .tcg-marquee-track {
      animation-play-state: paused;
    }
    .tcg-fade-mask-left,
    .tcg-fade-mask-right {
      position: absolute;
      top: 0;
      bottom: 0;
      height: 100%;
      width: 130px;
      z-index: 20;
      pointer-events: none;
    }
    .tcg-fade-mask-left {
      left: 0;
      background: linear-gradient(to right, #000000 0%, rgba(0, 0, 0, 0.95) 30%, rgba(0, 0, 0, 0.6) 65%, transparent 100%);
    }
    .tcg-fade-mask-right {
      right: 0;
      background: linear-gradient(to left, #000000 0%, rgba(0, 0, 0, 0.95) 30%, rgba(0, 0, 0, 0.6) 65%, transparent 100%);
    }
    @media (min-width: 768px) {
      .tcg-fade-mask-left,
      .tcg-fade-mask-right {
        width: 220px;
      }
    }
  </style>

  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <p class="text-center text-paper-dim mt-3">{{ section.settings.subheading }}</p>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>

    <div class="overflow-hidden flex w-full relative tcg-marquee-container mt-4 pb-3" style="-webkit-mask-image: linear-gradient(to right, transparent 0%, black 140px, black calc(100% - 140px), transparent 100%); mask-image: linear-gradient(to right, transparent 0%, black 140px, black calc(100% - 140px), transparent 100%);">
      <!-- Fade masks aligned to the container -->
      <div class="tcg-fade-mask-left"></div>
      <div class="tcg-fade-mask-right"></div>

      <!-- Loop 4 times to guarantee the track is wide enough even with very few images -->
      {%- for i in (1..4) -%}
        <div class="tcg-marquee-track" {% if i > 1 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign fb = fallbacks[forloop.index0] | default: 'card-back.svg'
              if block.settings.image != blank
                assign img = block.settings.image | image_url: width: 500
              else
                assign img = fb | asset_url
              endif
            -%}
            <img src="{{ img }}" alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy" class="shrink-0 w-[190px] h-[250px] object-cover rounded-card border border-gold/15 transition-transform duration-300 hover:scale-105" {% if i == 1 %}{{ block.shopify_attributes }}{% endif %}>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG Social",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the #HitzFamily" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pulls, restocks and show days — follow along." }
  ],
  "blocks": [
    { "type": "image", "name": "Photo", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" } ] }
  ],
  "presets": [{ "name": "TCG Social", "blocks": [ { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" } ] }]
}
{% endschema %}
