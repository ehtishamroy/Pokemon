{% comment %}
  TCG Hitz — "INSIDE THE TCG HITZ UNIVERSE" photo gallery (client-approved design).
  Two rows of wide/narrow photos, centered and cut off at the screen edges like the design.
  Photos are blocks (choose row 1 or 2, wide or narrow). Optional slow drifting motion.
{% endcomment %}

{%- liquid
  assign row1_count = 0
  assign row2_count = 0
  for block in section.blocks
    if block.settings.row == '2'
      assign row2_count = row2_count | plus: 1
    else
      assign row1_count = row1_count | plus: 1
    endif
  endfor
  assign drift = false
  if section.settings.motion == 'drift'
    assign drift = true
  endif
-%}

<section class="tcg-scope hz relative overflow-hidden">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap flex flex-col items-stretch gap-[64px] pb-[60px] pt-[100px]">
    <div class="flex w-full flex-col items-start justify-between gap-8 md:flex-row md:items-end">
      {% render 'tcg-home-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.text, heading_class: 'max-w-[847px] uppercase', text_class: 'xl:whitespace-nowrap' %}
      {% render 'tcg-home-button', label: section.settings.btn_label, link: section.settings.btn_link, kind: 'outline' %}
    </div>
  </div>

  <div class="flex w-full flex-col items-stretch gap-[28px] pb-[60px]">
    {%- for row_index in (1..2) -%}
      {%- liquid
        assign row_key = row_index | append: ''
        if row_index == 1
          assign row_size = row1_count
        else
          assign row_size = row2_count
        endif
        if drift
          assign passes = 2
        else
          assign passes = 1
        endif
      -%}
      {%- if row_size > 0 -%}
        <div class="{% if drift %}hz-marquee{% else %}flex justify-center{% endif %} w-full">
          <div class="{% if drift %}hz-marquee__track pr-[24px]{% else %}flex shrink-0 justify-center{% endif %} gap-[24px]"{% if drift %} style="--hz-speed: 70s;{% if row_index == 2 %} animation-direction: reverse;{% endif %}"{% endif %}>
            {%- for pass in (1..passes) -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  assign block_row = block.settings.row | default: '1'
                  assign photo_fallback = 'home-gallery-' | append: block.settings.fallback | append: '.webp'
                  if block.settings.size == 'wide'
                    assign size_class = 'w-[330px] md:w-[519px]'
                  else
                    assign size_class = 'w-[192px] md:w-[302px]'
                  endif
                  if block.settings.link != blank
                    assign photo_tag = 'a'
                  else
                    assign photo_tag = 'div'
                  endif
                -%}
                {%- if block_row == row_key -%}
                <{{ photo_tag }}{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} class="group relative block h-[220px] shrink-0 overflow-hidden rounded-[16px] border-[0.75px] border-solid border-white/40 md:h-[346px] {{ size_class }}"{% if pass == 1 %} {{ block.shopify_attributes }}{% else %} aria-hidden="true" tabindex="-1"{% endif %}>
                  {% render 'tcg-home-img', image: block.settings.image, fallback: photo_fallback, w: 1040, h: 1040, width: 1100, sizes: '(min-width: 768px) 520px, 330px', alt: block.settings.alt, class: 'absolute inset-0 h-full w-full max-w-none object-cover transition-transform duration-700 group-hover:scale-105' %}
                  <span aria-hidden="true" class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,.13) 46.098%, rgba(0,0,0,.84));"></span>
                  {%- if block.settings.caption != blank -%}
                    <span class="absolute bottom-4 left-4 right-4 font-display text-[18px] leading-[1.2] text-white">{{ block.settings.caption }}</span>
                  {%- endif -%}
                </{{ photo_tag }}>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "TCG Home — Gallery",
  "class": "tcg-home-section",
  "max_blocks": 16,
  "settings": [
    { "type": "select", "id": "glow", "label": "Background glow", "options": [ { "value": "none", "label": "None" }, { "value": "left-purple", "label": "Purple, left" }, { "value": "left-pink", "label": "Pink, left" }, { "value": "right-blue", "label": "Blue, right" }, { "value": "right-gold", "label": "Gold, right" } ], "default": "none" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INSIDE THE TCG HITZ UNIVERSE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "MORE THAN A COLLECTION. IT'S AN EXPERIENCE." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "From collectible cards and rare finds to our signature vending machines, explore the world of TCG HITZ." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "EXPLORE TCG HITZ" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "select", "id": "motion", "label": "Motion", "options": [
      { "value": "static", "label": "Static (like the design)" },
      { "value": "drift", "label": "Slow drift (rows move in opposite directions)" }
    ], "default": "static" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "fallback", "label": "Design image (used when no image is chosen)", "options": [
          { "value": "1", "label": "Umbreon machine display" }, { "value": "2", "label": "Collector at machine" }, { "value": "3", "label": "Card show floor" },
          { "value": "4", "label": "Arcade machines (wide)" }, { "value": "5", "label": "Young collector at machine" }, { "value": "6", "label": "Mall pop-up" }
        ], "default": "1" },
        { "type": "text", "id": "alt", "label": "Image description (alt text)" },
        { "type": "text", "id": "caption", "label": "Caption (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" },
        { "type": "select", "id": "size", "label": "Width", "options": [
          { "value": "wide", "label": "Wide" }, { "value": "narrow", "label": "Narrow" }
        ], "default": "wide" },
        { "type": "select", "id": "row", "label": "Row", "options": [
          { "value": "1", "label": "Row 1" }, { "value": "2", "label": "Row 2" }
        ], "default": "1" }
      ]
    }
  ],
  "presets": [{
    "name": "TCG Home — Gallery",
    "blocks": [
      { "type": "photo", "settings": { "fallback": "1", "size": "wide", "row": "1" } },
      { "type": "photo", "settings": { "fallback": "2", "size": "narrow", "row": "1" } },
      { "type": "photo", "settings": { "fallback": "3", "size": "wide", "row": "1" } },
      { "type": "photo", "settings": { "fallback": "2", "size": "narrow", "row": "1" } },
      { "type": "photo", "settings": { "fallback": "1", "size": "narrow", "row": "1" } },
      { "type": "photo", "settings": { "fallback": "1", "size": "narrow", "row": "2" } },
      { "type": "photo", "settings": { "fallback": "4", "size": "wide", "row": "2" } },
      { "type": "photo", "settings": { "fallback": "5", "size": "narrow", "row": "2" } },
      { "type": "photo", "settings": { "fallback": "6", "size": "wide", "row": "2" } },
      { "type": "photo", "settings": { "fallback": "1", "size": "narrow", "row": "2" } }
    ]
  }]
}
{% endschema %}
