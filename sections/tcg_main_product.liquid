{% comment %}
  TCG Hitz — Product page (1:1 with tcg-hitz-store/product.html)
  Variant rows / qty / ADD TO CART use the reference markup; assets/tcg.js posts
  the selected variant to /cart/add.js and opens the drawer.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign card_set      = product.metafields.custom.group_name.value | default: product.metafields.custom.group_name | default: product.metafields.card.set.value | default: product.metafields.custom.set.value | default: product.metafields.card.set | default: product.metafields.custom.set
  assign card_number   = product.metafields.custom.card_number.value | default: product.metafields.custom.card_number | default: product.metafields.card.number.value | default: product.metafields.custom.number.value | default: product.metafields.card.number | default: product.metafields.custom.number
  assign card_rarity   = product.metafields.custom.rarity.value | default: product.metafields.custom.rarity | default: product.metafields.card.rarity.value | default: product.metafields.card.rarity

  assign desc_html = product.description
  if card_number == blank and desc_html contains 'Card Number:</strong>'
    assign card_number = desc_html | split: 'Card Number:</strong>' | last | split: '</li>' | first | strip_html | strip
  elsif card_number == blank and desc_html contains '#:</strong>'
    assign card_number = desc_html | split: '#:</strong>' | last | split: '</li>' | first | strip_html | strip
  endif
  if card_rarity == blank and desc_html contains 'Rarity:</strong>'
    assign card_rarity = desc_html | split: 'Rarity:</strong>' | last | split: '</li>' | first | strip_html | strip
  endif
  case card_rarity
    when 'C'
      assign card_rarity = 'Common'
    when 'U'
      assign card_rarity = 'Uncommon'
    when 'R'
      assign card_rarity = 'Rare'
    when 'M'
      assign card_rarity = 'Mythic Rare'
    when 'S'
      assign card_rarity = 'Special'
    when 'P'
      assign card_rarity = 'Promo'
  endcase
  if card_set == blank
    assign ptype_down = product.type | downcase
    if ptype_down contains 'singles' or ptype_down contains 'sealed'
      assign card_set = product.vendor
    endif
  endif

  if product.featured_image
    assign main_img = product.featured_image | image_url: width: 1000
  else
    assign main_img = 'card-back.svg' | asset_url
  endif
  if current_variant.featured_image
    assign main_img = current_variant.featured_image | image_url: width: 1000
  endif
-%}

{%- capture stock_text -%}
  {%- if current_variant.available -%}
    {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity == 1 -%}Only 1 left{%- elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 -%}{{ current_variant.inventory_quantity }} in stock{%- else -%}In stock{%- endif -%}
  {%- else -%}Sold out{%- endif -%}
{%- endcapture -%}

<section class="tcg-scope hz hz-pdp relative" style="overflow-x: clip;">
  {% render 'tcg-home-glow', glow: section.settings.glow %}
  <div class="hz-wrap pb-[48px] pt-[28px] md:pb-[72px] md:pt-[40px] xl:pb-[100px]">
    <nav class="text-[14px] leading-[1.5] text-white md:text-[16px]" aria-label="Breadcrumb" data-hz-reveal>
      <a href="{{ routes.root_url }}" class="hz-ulink hover:text-hz-lightning">{{ section.settings.home_label }}</a><span class="mx-[6px]" aria-hidden="true">/</span>
      {%- if collection -%}<a href="{{ collection.url }}" class="hz-ulink hover:text-hz-lightning">{{ collection.title }}</a><span class="mx-[6px]" aria-hidden="true">/</span>{%- endif -%}
      {%- if card_set != blank -%}<a href="{{ routes.search_url }}?q={{ card_set | url_encode }}" class="hz-ulink hover:text-hz-lightning">{{ card_set }}</a><span class="mx-[6px]" aria-hidden="true">/</span>{%- endif -%}
      <strong class="font-bold text-hz-gold">{{ product.title }}</strong>
    </nav>

    <div class="hz-pdp__grid mt-[28px] grid gap-10 md:mt-[36px] lg:grid-cols-12 lg:gap-14">

      <div class="lg:col-span-6">
        <div class="hz-gallery lg:sticky lg:top-24" data-hz-reveal>
          <div class="hz-stage tcg-gb [--bw:1px]" data-hz-stage tabindex="0" aria-label="Product images">
            <span aria-hidden="true" class="hz-stage__glow"></span>
            {%- if section.settings.holo -%}
              <div class="relative z-[1] flex h-full w-full items-center justify-center p-[24px]">
                <div class="w-[min(70%,380px)]">
                  <div class="holo" data-tilt="14" aria-label="Card image, move your pointer to tilt">
                    <div class="holo__card">
                      <img data-main-img src="{{ main_img }}" alt="{{ product.title | escape }}" width="800" height="800" fetchpriority="high">
                      <span class="holo__glare"></span><span class="holo__rainbow"></span>
                    </div>
                  </div>
                </div>
              </div>
            {%- else -%}
              <img data-main-img src="{{ main_img }}" alt="{{ product.title | escape }}" width="1000" height="1000" fetchpriority="high" class="hz-stage__img">
            {%- endif -%}
            {%- if product.media.size > 1 -%}
              <button type="button" class="hz-gallery-arrow hz-gallery-arrow--prev" data-gallery-nav="-1" aria-label="Previous image"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
              <button type="button" class="hz-gallery-arrow hz-gallery-arrow--next" data-gallery-nav="1" aria-label="Next image"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            {%- endif -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="hz-thumbs{% if product.media.size > 5 %} hz-thumbs--scroll{% endif %}" role="list">
              {%- for media in product.media -%}
                <button type="button" role="listitem" data-thumb="{{ media.preview_image | image_url: width: 1000 }}" class="hz-thumb{% if forloop.first %} is-active{% endif %}" aria-label="{{ media.alt | default: 'Photo' | escape }}"><img src="{{ media.preview_image | image_url: width: 240 }}" alt="" width="120" height="120" loading="lazy"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.gallery_note != blank -%}<p class="mt-[16px] text-center text-[14px] text-hz-cool">{{ section.settings.gallery_note }}</p>{%- endif -%}
        </div>
      </div>

      <div class="lg:col-span-6">
        {%- if card_set != blank or card_number != blank -%}
          <p class="text-sm text-slate">{{ card_set }}{% if card_set != blank and card_number != blank %} · {% endif %}{{ card_number }}</p>
        {%- endif -%}
        <h1 class="font-display text-4xl sm:text-5xl leading-[1.04] mt-2">{{ product.title }}</h1>
        {%- if card_rarity != blank -%}
          <p class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-volt">
            <span class="h-1.5 w-1.5 rounded-full bg-blaze"></span> {{ card_rarity | upcase }}
          </p>
        {%- endif -%}

        {%- comment -%} At-a-glance SortSwift flags — only the ones set to true show {%- endcomment -%}
        {%- capture flag_chips -%}
          {%- assign flag_pairs = 'Full Art::full_art,Promo::promo,Story Spotlight::story_spotlight,Presale::is_presale,Sealed::sealed,Single::single,Booster::booster,Reprint::reprint,Reserved List::reserved,Textless::textless' | split: ',' -%}
          {%- for pair in flag_pairs -%}
            {%- assign fp = pair | split: '::' -%}
            {%- assign fv = product.metafields.custom[fp[1]].value -%}
            {%- if fv == true or fv == 'true' or fv == 1 -%}
              {%- assign hot = false -%}
              {%- if fp[1] == 'full_art' or fp[1] == 'promo' or fp[1] == 'story_spotlight' or fp[1] == 'is_presale' -%}{%- assign hot = true -%}{%- endif -%}
              <span class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold {% if hot %}bg-blaze/15 border border-blaze/45 text-blaze-hot{% else %}bg-volt/10 border border-volt/40 text-volt{% endif %}"><span class="h-1.5 w-1.5 rounded-full {% if hot %}bg-blaze{% else %}bg-volt{% endif %}"></span>{{ fp[0] }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- assign flag_chips_s = flag_chips | strip -%}
        {%- if flag_chips_s != blank -%}
          <div class="mt-4 flex flex-wrap gap-2">{{ flag_chips }}</div>
        {%- endif -%}

        <div class="mt-6 flex items-center gap-4">
          <span data-price class="font-display text-[42px] leading-none text-volt">{{ current_variant.price | money }}</span>
          <span data-stock class="rounded-full {% if current_variant.available %}bg-mint/15 text-mint{% else %}bg-chase/15 text-chase{% endif %} px-3 py-1 text-sm font-bold">{{ stock_text | strip }}</span>
        </div>

        {%- unless product.has_only_default_variant -%}
          <fieldset class="mt-7">
            <legend class="font-bold tracking-widest text-xs text-slate">{{ product.options | join: ' & ' | upcase }}</legend>
            <p class="text-sm text-slate mt-1.5">Selected: <span data-selected class="text-paper font-semibold">{{ current_variant.title }}</span></p>
            <div class="mt-3 space-y-2.5" role="radiogroup">
              {%- for variant in product.variants -%}
                {%- capture v_stock -%}{%- if variant.available -%}{%- if variant.inventory_management != blank and variant.inventory_quantity == 1 -%}Only 1 left{%- elsif variant.inventory_management != blank and variant.inventory_quantity > 0 -%}{{ variant.inventory_quantity }} in stock{%- else -%}In stock{%- endif -%}{%- else -%}Sold out{%- endif -%}{%- endcapture -%}
                {%- assign v_rest = '' -%}
                {%- if variant.option2 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option2 -%}{%- endif -%}
                {%- if variant.option3 != blank -%}{%- assign v_rest = v_rest | append: ' · ' | append: variant.option3 -%}{%- endif -%}
                <button type="button" data-variant data-id="{{ variant.id }}" data-price="{{ variant.price | money }}" data-stock="{{ v_stock | strip }}" data-available="{{ variant.available }}" data-label="{{ variant.title | escape }}"{% if variant.featured_image %} data-image="{{ variant.featured_image | image_url: width: 1000 }}"{% endif %} role="radio" aria-checked="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  class="w-full flex items-center justify-between rounded-lg border border-volt/20 bg-felt-2/60 px-4 py-3.5 text-left hover:border-volt transition">
                  <span><span class="font-bold">{{ variant.option1 }}</span> <span class="text-slate">{{ v_rest }}</span><span class="block text-xs text-slate mt-0.5">{{ v_stock | strip }}</span></span>
                  <span class="font-display text-lg text-volt">{{ variant.price | money }}</span>
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endunless -%}

        <input type="hidden" data-variant-input name="id" value="{{ current_variant.id }}">
        <div class="mt-7 flex items-center gap-4">
          <div class="qty inline-flex items-center rounded-full bg-felt-2 border border-volt/25">
            <button type="button" data-qty-dec class="rounded-full text-xl text-volt" aria-label="Decrease quantity">−</button>
            <span data-qty-value class="w-8 text-center font-bold" aria-live="polite">1</span>
            <button type="button" data-qty-inc class="rounded-full text-xl text-volt" aria-label="Increase quantity">+</button>
          </div>
          <button type="button" data-add data-add-main data-variant-id="{{ current_variant.id }}"{% unless current_variant.available %} disabled{% endunless %}
                  class="flex-1 rounded-full bg-fire px-6 py-4 font-bold text-white{% unless current_variant.available %} opacity-60{% endunless %}">{% if current_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}</button>
        </div>
        <div class="mt-3 flex flex-wrap gap-5 text-sm">
          <a href="{{ section.settings.sell_link | default: '/pages/sell' }}" class="text-slate hover:text-volt">Have this card? Sell it to us →</a>
        </div>

        <ul class="mt-8 grid sm:grid-cols-3 gap-3">
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">Ships in 1 day</span><span class="text-xs text-slate">Rigid sleeve + mailer</span></li>
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">Real photos</span><span class="text-xs text-slate">The exact card shown</span></li>
          <li class="cabinet bg-ink p-4"><span class="block font-bold text-sm">Fair returns</span><span class="text-xs text-slate">Not as described? Refund</span></li>
        </ul>

        {% render 'tcg-card-specs', product: product %}

        <details class="faq mt-6 cabinet bg-ink p-5 group">
          <summary class="cursor-pointer font-bold flex items-center justify-between">What do the conditions mean?
            <svg class="chev h-5 w-5 text-volt transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 9 6 6 6-6"/></svg>
          </summary>
          <dl class="mt-4 space-y-3 text-[15px]">
            <div><dt class="font-semibold">Near Mint (NM)</dt><dd class="text-paper-dim text-sm">Looks unplayed. Crisp corners and edges, clean surface, little to no wear.</dd></div>
            <div><dt class="font-semibold">Lightly Played (LP)</dt><dd class="text-paper-dim text-sm">Minor wear: light scratches or small edge and corner wear. Sleeve-and-play ready.</dd></div>
            <div><dt class="font-semibold">Moderately Played (MP)</dt><dd class="text-paper-dim text-sm">Noticeable wear: moderate scratches, border or corner wear, light whitening.</dd></div>
            <div><dt class="font-semibold">Heavily Played (HP)</dt><dd class="text-paper-dim text-sm">Significant wear: heavy scratches, creasing or whitening, but intact.</dd></div>
            <div><dt class="font-semibold">Damaged (DMG)</dt><dd class="text-paper-dim text-sm">Major flaws: bends, tears, water damage or writing. Sold as-is.</dd></div>
          </dl>
        </details>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "TCG – Product Page",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "glow",
      "label": "Background glow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left-blue",
          "label": "Blue, left"
        },
        {
          "value": "left-purple",
          "label": "Purple, left"
        },
        {
          "value": "left-pink",
          "label": "Pink, left"
        },
        {
          "value": "right-blue",
          "label": "Blue, right"
        },
        {
          "value": "right-pink",
          "label": "Pink, right"
        },
        {
          "value": "right-gold",
          "label": "Gold, right"
        }
      ],
      "default": "left-blue"
    },
    {
      "type": "checkbox",
      "id": "holo",
      "label": "Holographic tilt effect on the main image",
      "info": "Tilts with the mouse. Best for single trading cards; turn off for boxes and merch.",
      "default": false
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Breadcrumb: home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "gallery_note",
      "label": "Gallery note (optional)"
    },
    {
      "type": "url",
      "id": "sell_link",
      "label": "Sell-to-us link"
    }
  ],
  "presets": []
}
{% endschema %}
