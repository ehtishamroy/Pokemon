{% comment %}
  TCG Hitz — Hero Featured Pull
  Shopify: sections/hero-featured-pull.liquid
  Shows the store's glowing logo, headline, and a 3D holographic tilt card.
  A product picker setting controls which card is featured.
{% endcomment %}

{% liquid
  assign featured_product = section.settings.featured_product
%}

<section class="tcg-hero relative overflow-hidden">
  <div class="mx-auto max-w-site px-4 sm:px-6 py-14 lg:py-20 tcg-grid lg:grid-cols-12 gap-10 lg:gap-6 items-center">

    <div class="lg:col-span-6 order-2 lg:order-1">
      <div class="sign inline-block max-w-[360px]">
        <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="w-full h-auto">
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-[56px] leading-[1.02] mt-8" style="color:#F3F5FA;">
        {{ section.settings.heading }}
      </h1>
      <p class="mt-5 max-w-[52ch] text-lg leading-relaxed" style="color:#C5CCE0;">
        {{ section.settings.subheading }}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="{{ section.settings.cta_primary_link }}"
           class="inline-flex items-center rounded-full px-6 py-3.5 font-bold"
           style="background:#FFC72C;color:#0E1530;">
          {{ section.settings.cta_primary_label }}
        </a>
        <a href="#pulls"
           class="inline-flex items-center rounded-full border px-6 py-3.5 font-semibold"
           style="border-color:rgba(255,255,255,.15);color:#F3F5FA;"
           onmouseover="this.style.borderColor='#3EC1FF';this.style.color='#3EC1FF';"
           onmouseout="this.style.borderColor='rgba(255,255,255,.15)';this.style.color='#F3F5FA';">
          This week's pulls
        </a>
      </div>
      <dl class="mt-10 tcg-grid grid-cols-3 gap-4 max-w-md text-sm">
        <div>
          <dt style="color:#8A96B8;">Ships in</dt>
          <dd class="font-bold mt-0.5" style="color:#F3F5FA;">1 business day</dd>
        </div>
        <div>
          <dt style="color:#8A96B8;">Every single</dt>
          <dd class="font-bold mt-0.5" style="color:#F3F5FA;">Real photos</dd>
        </div>
        <div>
          <dt style="color:#8A96B8;">Graded slabs</dt>
          <dd class="font-bold mt-0.5" style="color:#F3F5FA;">PSA &amp; CGC</dd>
        </div>
      </dl>
    </div>

    <div class="lg:col-span-6 order-1 lg:order-2 flex justify-center">
      <figure class="w-[min(84vw,400px)]">
        <div class="holo" data-tilt="14" aria-label="Featured card, move your pointer to tilt">
          <div class="holo__card">
            {% if featured_product != blank and featured_product.featured_image %}
              <img src="{{ featured_product.featured_image | image_url: width: 900 }}"
                   alt="{{ featured_product.title | escape }}">
            {% else %}
              <img src="{{ 'card-back.svg' | asset_url }}" alt="Featured card">
            {% endif %}
            <span class="holo__glare"></span>
            <span class="holo__rainbow"></span>
          </div>
        </div>
        <figcaption class="mt-5 flex items-center justify-between text-sm">
          <span style="color:#8A96B8;">Featured pull</span>
          {% if featured_product != blank %}
            <a href="{{ featured_product.url }}" class="font-semibold hover:underline" style="color:#3EC1FF;">
              See this card →
            </a>
          {% endif %}
        </figcaption>
      </figure>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero – Featured Pull",
  "settings": [
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured card product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pokémon singles, photographed for real."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every card on this site is the exact card you'll get — front and back photos, graded conditions you can trust, shipped in a rigid sleeve within one business day. Run by a family that hits card shows every weekend."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Button label",
      "default": "Shop singles"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero – Featured Pull"
    }
  ]
}
{% endschema %}
