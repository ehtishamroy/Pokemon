{% comment %}
  TCG Hitz — "From purchase to profit" numbered steps (blocks).
{% endcomment %}

<section class="tcg-scope py-12 lg:py-16">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.heading }}</h2>
    <div class="rule-energy my-7 max-w-[240px] mx-auto"></div>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {%- for block in section.blocks -%}
        <li class="cabinet bg-ink p-6" {{ block.shopify_attributes }}>
          <span class="tcg-step__num">{{ forloop.index }}</span>
          <h3 class="mt-4 font-bold text-lg">{{ block.settings.title }}</h3>
          <p class="mt-1.5 text-sm text-paper-dim leading-relaxed">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "TCG Vending Steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From purchase to profit" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Order your machine" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pick your machine and add-ons, then check out securely online." }
      ]
    }
  ],
  "presets": [{ "name": "TCG Vending Steps", "blocks": [
    { "type": "step", "settings": { "title": "Order your machine", "text": "Pick your machine and any add-ons, then check out securely online." } },
    { "type": "step", "settings": { "title": "We build it", "text": "Your machine is built to order in 3–4 weeks, with your wrap and payment options." } },
    { "type": "step", "settings": { "title": "Free delivery", "text": "It ships to you in 3–4 weeks — shipping is included." } },
    { "type": "step", "settings": { "title": "Start earning", "text": "Load it with packs, plug it in and start selling." } }
  ] }]
}
{% endschema %}
