{% comment %}
  TCG Hitz — Sell to us page (1:1 with tcg-hitz-store/sell.html)
  Hero + How it works (step blocks) + What we buy (yes/no lists) +
  Get-an-offer form (wired to Shopify's native contact form) + in-person CTA.
{% endcomment %}

{%- liquid
  assign hero_img = 'store-display.jpg' | asset_url
  if section.settings.hero_image != blank
    assign hero_img = section.settings.hero_image | image_url: width: 900
  endif
  assign steps = section.blocks | where: 'type', 'step'
-%}

<section class="tcg-scope smoke pt-12 pb-10" style="overflow-x: clip;">
  <div class="mx-auto max-w-site px-4 sm:px-6 grid lg:grid-cols-2 gap-10 items-center">
    <div>
      {%- if section.settings.stars_text != blank -%}
        <p class="stars text-sm">★★★★★ <span class="text-paper-dim font-semibold ml-1">{{ section.settings.stars_text }}</span></p>
      {%- endif -%}
      <h1 class="font-display text-4xl sm:text-5xl lg:text-[56px] leading-[1.02] mt-4">{{ section.settings.heading_line1 }}<br>{{ section.settings.heading_line2 }}</h1>
      <p class="mt-5 max-w-[48ch] text-paper-dim leading-relaxed">{{ section.settings.hero_body }}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="#offer" class="rounded-full bg-gold px-7 py-3.5 font-bold text-ink hover:bg-gold-deep">{{ section.settings.cta_primary }}</a>
        <a href="#what" class="rounded-full border border-gold/45 px-7 py-3.5 font-bold text-gold hover:bg-gold/10">{{ section.settings.cta_secondary }}</a>
      </div>
    </div>
    <div class="flex justify-center">
      {%- if section.settings.hero_video != blank -%}
        {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'rounded-card border border-gold/20 max-h-[360px] object-cover w-full' }}
      {%- else -%}
        <img src="{{ hero_img }}" alt="{{ section.settings.hero_image.alt | default: 'Cards and collectibles on the TCG Hitz table' | escape }}" loading="lazy" class="rounded-card border border-gold/20 max-h-[360px] object-cover">
      {%- endif -%}
    </div>
  </div>
</section>

<section class="tcg-scope py-12">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.steps_heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid md:grid-cols-4 gap-4">
      {%- for block in steps -%}
        <div class="cabinet bg-ink p-6" {{ block.shopify_attributes }}><p class="font-display text-3xl text-gold">{{ forloop.index }}</p><h3 class="mt-2 font-bold">{{ block.settings.title }}</h3><p class="mt-1 text-sm text-paper-dim">{{ block.settings.body }}</p></div>
      {%- endfor -%}
    </div>
  </div>
</section>

<section id="what" class="tcg-scope py-12">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 class="stitle">{{ section.settings.buy_heading }}</h2>
    <div class="rule-gold my-7 max-w-[240px] mx-auto"></div>
    <div class="grid md:grid-cols-2 gap-4 max-w-4xl mx-auto">
      <div class="cabinet bg-ink p-6">
        <h3 class="font-bold text-gold">{{ section.settings.yes_heading }}</h3>
        <ul class="mt-3 space-y-2 text-sm text-paper-dim">
          {%- assign yes_lines = section.settings.yes_list | strip | newline_to_br | split: '<br />' -%}
          {%- for line in yes_lines -%}{%- assign yl = line | strip -%}{%- if yl != blank -%}<li class="flex gap-2"><span class="text-mint">✔</span> {{ yl }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="cabinet bg-ink p-6">
        <h3 class="font-bold text-gold">{{ section.settings.no_heading }}</h3>
        <ul class="mt-3 space-y-2 text-sm text-paper-dim">
          {%- assign no_lines = section.settings.no_list | strip | newline_to_br | split: '<br />' -%}
          {%- for line in no_lines -%}{%- assign nl = line | strip -%}{%- if nl != blank -%}<li class="flex gap-2"><span class="text-chase">✕</span> {{ nl }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        {%- if section.settings.no_footnote != blank -%}<p class="mt-4 text-sm text-slate">{{ section.settings.no_footnote }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

<section id="offer" class="tcg-scope py-12">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <div class="cabinet bg-ink p-8">
      <h2 class="font-display text-3xl text-center">{{ section.settings.form_heading }}</h2>
      <p class="mt-2 text-center text-paper-dim">{{ section.settings.form_subheading }}</p>
      {%- form 'contact', id: 'tcg-sell-form', class: 'mt-7 grid gap-4' -%}
        {%- if form.posted_successfully? -%}
          <p class="rounded-lg bg-gold/10 border border-gold/45 text-gold px-5 py-4 text-center font-bold">SENT — we'll be in touch within one business day.</p>
        {%- else -%}
          {%- if form.errors -%}<p class="text-sm text-chase">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="grid sm:grid-cols-2 gap-4">
            <div><label class="block text-sm font-semibold mb-1.5" for="s-name">Your name</label><input id="s-name" name="contact[Name]" required class="w-full rounded-lg bg-felt-2 border border-gold/20 px-4 py-3 placeholder:text-slate focus:border-gold" placeholder="Jane Smith"></div>
            <div><label class="block text-sm font-semibold mb-1.5" for="s-email">Email</label><input id="s-email" name="contact[email]" type="email" required class="w-full rounded-lg bg-felt-2 border border-gold/20 px-4 py-3 placeholder:text-slate focus:border-gold" placeholder="you@email.com"></div>
          </div>
          <div><label class="block text-sm font-semibold mb-1.5" for="s-type">What are you selling?</label>
            <select id="s-type" name="contact[Selling]" class="w-full rounded-lg bg-felt-2 border border-gold/20 px-4 py-3 focus:border-gold">
              <option>A few singles</option><option>Graded slabs</option><option>Sealed product</option><option>A whole collection</option><option>Bulk lot</option>
            </select></div>
          <div><label class="block text-sm font-semibold mb-1.5" for="s-detail">Tell us about it</label><textarea id="s-detail" name="contact[body]" rows="5" class="w-full rounded-lg bg-felt-2 border border-gold/20 px-4 py-3 placeholder:text-slate focus:border-gold" placeholder="Sets, rough card count, condition, anything notable…"></textarea></div>
          <div><label class="block text-sm font-semibold mb-1.5" for="s-pay">Preferred payment</label>
            <select id="s-pay" name="contact[Preferred payment]" class="w-full rounded-lg bg-felt-2 border border-gold/20 px-4 py-3 focus:border-gold">
              <option>Cash</option><option>Store credit (we add extra value)</option><option>Whichever is better</option>
            </select></div>
          <button type="submit" class="rounded-full bg-gold px-6 py-3.5 font-bold text-ink hover:bg-gold-deep">SEND MY OFFER REQUEST</button>
          <p class="text-xs text-slate text-center">Photos? Reply to our confirmation email with them attached — that speeds things up a lot.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- if section.settings.person_heading != blank -%}
<section class="tcg-scope py-12">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="cabinet bg-ink p-8 text-center">
      <h2 class="font-display text-2xl sm:text-3xl">{{ section.settings.person_heading }}</h2>
      <p class="mt-3 text-paper-dim">{{ section.settings.person_body }}</p>
      <a href="{{ section.settings.person_link | default: '/pages/contact' }}" class="mt-6 inline-flex rounded-full border border-gold/45 px-6 py-3 font-bold text-gold hover:bg-gold/10">{{ section.settings.person_cta }}</a>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "TCG – Sell Page",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "stars_text", "label": "Stars line", "default": "Buying collections every weekend" },
    { "type": "text", "id": "heading_line1", "label": "Heading line 1", "default": "SELL US" },
    { "type": "text", "id": "heading_line2", "label": "Heading line 2", "default": "YOUR CARDS" },
    { "type": "textarea", "id": "hero_body", "label": "Hero body", "default": "Singles, graded slabs, sealed product or a whole collection — we buy it all. Fair offers based on real market data, paid the same day." },
    { "type": "text", "id": "cta_primary", "label": "Primary button", "default": "GET AN OFFER" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary button", "default": "WHAT WE BUY" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image (defaults to store-display.jpg)" },
    { "type": "video", "id": "hero_video", "label": "Or Hero video (overrides image)" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "How it works" },
    { "type": "header", "content": "What we buy" },
    { "type": "text", "id": "buy_heading", "label": "Heading", "default": "What we buy" },
    { "type": "text", "id": "yes_heading", "label": "Yes heading", "default": "Yes please" },
    { "type": "textarea", "id": "yes_list", "label": "Yes list (one per line)", "default": "Singles — modern and vintage, any condition\nGraded slabs — PSA, CGC, BGS, TAG\nSealed — boxes, ETBs, packs, tins\nBulk lots and whole collections\nMagic and One Piece, too" },
    { "type": "text", "id": "no_heading", "label": "No heading", "default": "Not right now" },
    { "type": "textarea", "id": "no_list", "label": "No list (one per line)", "default": "Proxies, fakes or reprints sold as real\nWater-damaged or mouldy bulk\nOpened product missing its contents" },
    { "type": "text", "id": "no_footnote", "label": "No footnote", "default": "Not sure? Send it anyway and we'll tell you honestly." },
    { "type": "header", "content": "Offer form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Get an offer" },
    { "type": "text", "id": "form_subheading", "label": "Form subheading", "default": "Tell us what you have. We reply within one business day." },
    { "type": "header", "content": "In person" },
    { "type": "text", "id": "person_heading", "label": "Heading", "default": "Prefer to do it in person?" },
    { "type": "textarea", "id": "person_body", "label": "Body", "default": "Bring your cards to our table at the next card show." },
    { "type": "text", "id": "person_cta", "label": "Button", "default": "Find our next show" },
    { "type": "url", "id": "person_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Send photos" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Fill the form below with clear photos of what you have." }
      ]
    }
  ],
  "presets": []
}
{% endschema %}
